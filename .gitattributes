# Normalize repository text deterministically.
* text=auto eol=lf

# Windows command scripts require CRLF for native cmd.exe execution.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary formats are never line-ending normalized or text-merged.
*.7z binary
*.avif binary
*.bmp binary
*.bz2 binary
*.gif binary
*.gz binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.tar binary
*.tgz binary
*.tif binary
*.tiff binary
*.webp binary
*.woff binary
*.woff2 binary
*.xz binary
*.zip binary
*.zst binary
