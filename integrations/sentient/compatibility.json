      "supported_major_versions": [
        1
      ]
    },
    "health": {
      "ref": "interfaces/health/health-status.schema.json",
      "supported_major_versions": [
        1
      ]
    },
    "identity_context": {
      "ref": "interfaces/identity/identity-context.schema.json",
      "supported_major_versions": [
        1
      ]
    },
    "job_request": {
      "ref": "interfaces/jobs/job-request.schema.json",
      "supported_major_versions": [
        1
      ]
    },
    "job_status": {
      "ref": "interfaces/jobs/job-status.schema.json",
      "supported_major_versions": [
        1
      ]
    },
    "module_interface": {
      "ref": "docs/contracts/artifact-contracts/module-interface-manifest.schema.json",
      "supported_versions": [
        "1.0.0"
      ]
    },
    "readiness": {
      "ref": "interfaces/health/readiness.schema.json",
      "supported_major_versions": [
        1
      ]
    },
    "receipts": {
      "ref": "interfaces/receipts/receipt-envelope.schema.json",
      "supported_major_versions": [
        1
      ]
    },
    "system": {
