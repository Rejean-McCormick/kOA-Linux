  "profile_scope": {
    "compatible_profile_ids": [
      "build_farm",
      "developer_linux_workstation",
      "developer_windows_wsl",
      "sovereign_hub"
    ],
    "default_activation": "stopped",
    "explicit_task_required": true,
    "prohibited_profile_classes": [
      "appliance",
      "control_plane",
      "high_assurance",
      "recovery",
      "sovereign_runtime",
      "user_lightweight"
    ]
  },
  "source_compatibility": {
    "accepted_revisions": [],
    "rejected_revisions": [
      "unversioned",
      "floating_branch",
      "mutable_tag",
      "unknown_digest"
    ],
    "status": "blocked_until_source_pin_resolved",
    "unknown_revision_result": "blocked"
  },
  "subsystem_contract": {
    "ref": "docs/contracts/subsystems/sentient.subsystem.json",
    "supported_versions": [
      "1.0.0"
    ]
  },
  "subsystem_id": "sentient"
