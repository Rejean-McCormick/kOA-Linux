{
  "$schema": "koa://schemas/independent-subsystem-compatibility/1.0.0",
  "automatic_compatibility_override_allowed": false,
  "behavioral_requirements": [
    "optional_and_disabled_by_default",
    "explicit_task_activation_only",
    "compatible_development_or_build_profiles_only",
    "isolated_workbench_namespaces",
    "candidate_output_only",
    "complete_provenance_required",
    "local_acceptance_outside_sentient_required",
    "no_direct_cross_subsystem_writes",
    "network_disabled_by_default",
    "resource_governor_admission_required",
    "removable_without_core_failure",
    "visibility_is_not_authorization"
  ],
  "compatibility_version": "1.0.0",
  "incompatibility_result": "integration_disabled",
  "koa_contracts": {
    "capability_snapshot": {
      "ref": "interfaces/capabilities/capability-snapshot.schema.json",
