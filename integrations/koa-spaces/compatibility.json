        "1.0.0"
      ]
    },
    {
      "artifact_class": "space_activation_receipt",
      "schema": "docs/contracts/artifact-contracts/space-activation-receipt.schema.json",
      "schema_version": "draft-2020-12",
      "supported_artifact_versions": [
        "1.0.0"
      ]
    }
  ],
  "common_interfaces": {
    "transport": "interfaces/transport/http-over-unix.toml",
    "health": "interfaces/health/health-status.schema.json",
    "readiness": "interfaces/health/readiness.schema.json",
