[Unit]
Description=Orgo private API
After=network-online.target

[Container]
Image=registry.example.invalid/koa/orgo-api@sha256:REPLACE
ContainerName=orgo-api
UserNS=keep-id
ReadOnly=true
NoNewPrivileges=true
Network=koa-private.network
Volume=orgo-state.volume:/var/lib/orgo:Z
EnvironmentFile=/run/credentials/orgo-api.service/env
HealthCmd=curl --fail http://127.0.0.1:8080/healthz
HealthInterval=30s

[Service]
Restart=on-failure
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=koa-services.target
