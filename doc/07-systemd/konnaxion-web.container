[Unit]
Description=Konnaxion web service
After=network-online.target
Wants=network-online.target

[Container]
Image=registry.example.invalid/koa/konnaxion-web@sha256:REPLACE
ContainerName=konnaxion-web
UserNS=keep-id
ReadOnly=true
NoNewPrivileges=true
Network=koa-public.network
Volume=konnaxion-static.volume:/app/static:ro
EnvironmentFile=/run/credentials/konnaxion-web.service/env
HealthCmd=curl --fail http://127.0.0.1:3000/healthz
HealthInterval=30s

[Service]
Restart=on-failure
MemoryMax=1G
CPUQuota=200%

[Install]
WantedBy=koa-services.target
