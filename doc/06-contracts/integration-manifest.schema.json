{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.example/linux/integration-manifest.schema.json",
  "title": "kOA Integration Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integration_id", "mode", "trust_level", "data_classes", "capabilities", "failure_mode"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "integration_id": {"type": "string"},
    "version": {"type": "string"},
    "owner": {"type": "string"},
    "mode": {"enum": ["native", "annex-isolated", "external-connector", "mimicked-functionality", "forbidden"]},
    "trust_level": {"enum": ["trusted-core", "trusted-limited", "untrusted", "hostile-input"]},
    "network": {
      "type": "object",
      "properties": {
        "inbound": {"type": "array", "items": {"type": "string"}},
        "outbound": {"type": "array", "items": {"type": "string"}}
      }
    },
    "filesystem": {
      "type": "object",
      "properties": {
        "read": {"type": "array", "items": {"type": "string"}},
        "write": {"type": "array", "items": {"type": "string"}}
      }
    },
    "data_classes": {
      "type": "object",
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {"type": "array", "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}}
      }
    },
    "capabilities": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "offline_behavior": {"type": "string"},
    "failure_mode": {"enum": ["isolated", "degraded", "critical"]},
    "healthcheck": {"type": "string"},
    "export_support": {"type": "boolean"},
    "removal_plan": {"type": "string"},
    "image_digest": {"type": "string"},
    "signature": {"type": "object"}
  }
}
