{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.example/linux/offline-bundle.schema.json",
  "title": "kOA Offline Bundle",
  "type": "object",
  "required": ["schema_version", "bundle_id", "created_at", "inventory", "signatures"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bundle_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "target_tenants": {"type": "array", "items": {"type": "string"}},
    "release_set": {"type": "string"},
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size", "class"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "class": {"enum": ["os", "service", "policy", "kristal", "revocation", "trust", "migration", "test", "instruction"]}
        }
      }
    },
    "minimum_importer_version": {"type": "string"},
    "signatures": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kid", "value"]}}
  }
}
