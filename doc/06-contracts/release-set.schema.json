{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.example/linux/release-set.schema.json",
  "title": "kOA Release Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_set_id", "created_at", "channels", "compatibility", "signatures"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "release_set_id": {"type": "string", "pattern": "^koa-release-set:"},
    "created_at": {"type": "string", "format": "date-time"},
    "target_profiles": {
      "type": "array",
      "items": {"enum": ["koa-endpoint", "koa-sovereign-hub", "koa-build-farm", "koa-control-plane"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "services", "governance"],
      "properties": {
        "os": {"$ref": "#/$defs/artifactRef"},
        "services": {"$ref": "#/$defs/artifactRef"},
        "governance": {"$ref": "#/$defs/artifactRef"},
        "kristal_defaults": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["kristal_contracts", "query_contracts"],
      "properties": {
        "kristal_contracts": {"type": "array", "items": {"type": "string"}},
        "query_contracts": {"type": "array", "items": {"type": "string"}},
        "minimum_schemas": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "required_hardware": {"type": "array", "items": {"type": "string"}},
        "minimum_disk_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "migrations": {"type": "array", "items": {"type": "string"}},
    "conformance_profiles": {"type": "array", "items": {"type": "string"}},
    "signatures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signature"}}
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest", "version"],
      "properties": {
        "id": {"type": "string"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "version": {"type": "string"},
        "channel": {"type": "string"},
        "uri": {"type": "string"}
      }
    },
    "signature": {
      "type": "object",
      "required": ["kid", "algorithm", "value"],
      "properties": {
        "kid": {"type": "string"},
        "algorithm": {"type": "string"},
        "value": {"type": "string"}
      }
    }
  }
}
