{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.example/linux/cultural-rights-policy.schema.json",
  "title": "kOA Cultural Rights Policy",
  "type": "object",
  "required": ["schema_version", "object_id", "authorities", "access", "reuse", "ai_training", "withdrawal"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "object_id": {"type": "string"},
    "creator": {"type": "array", "items": {"type": "string"}},
    "rights_holders": {"type": "array", "items": {"type": "string"}},
    "authorities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cultural_context": {"type": "array", "items": {"type": "string"}},
    "access": {"enum": ["public", "community-only", "research-only", "institution-only", "private", "embargoed", "sealed"]},
    "download": {"type": "boolean"},
    "display": {"type": "boolean"},
    "reuse": {"enum": ["allowed", "attribution", "approval-required", "forbidden"]},
    "ai_training": {"enum": ["allowed", "approval-required", "forbidden"]},
    "interpretation": {"enum": ["open", "context-required", "authority-review", "restricted"]},
    "withdrawal": {
      "type": "object",
      "required": ["sensitive", "requesters"],
      "properties": {
        "sensitive": {"type": "boolean"},
        "requesters": {"type": "array", "items": {"type": "string"}},
        "propagation_required": {"type": "boolean"}
      }
    },
    "review_at": {"type": "string", "format": "date-time"},
    "policy_id": {"type": "string"}
  }
}
