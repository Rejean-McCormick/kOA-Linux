{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.example/linux/node-profile.schema.json",
  "title": "kOA Node Profile",
  "type": "object",
  "required": ["schema_version", "node_id", "profile", "tenants", "capability_policy", "channels"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "node_id": {"type": "string"},
    "profile": {"enum": ["koa-endpoint", "koa-sovereign-hub", "koa-build-farm", "koa-control-plane"]},
    "hardware_class": {"type": "string"},
    "tenants": {"type": "array", "items": {"type": "string"}},
    "capability_policy": {"type": "string"},
    "channels": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["allowed", "trust_root_set"],
        "properties": {
          "allowed": {"type": "array", "items": {"type": "string"}},
          "trust_root_set": {"type": "string"}
        }
      }
    },
    "storage": {"type": "object"},
    "network": {"type": "object"},
    "offline": {"type": "object"}
  }
}
