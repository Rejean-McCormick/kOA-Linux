  "profile_relationship": {
    "membership_owner": "generated/profile-catalog.json",
    "profile_contracts_may_require_or_allow_component": true,
    "component_contract_may_not_infer_profile_membership": true,
    "known_required_profile_refs": [
      "contracts/profiles/control-plane.profile.json"
    ],
    "overlay_effects_are_owned_by_profile_contracts": true
  },
  "purpose": {
    "primary": "Provide bounded, verifiable, and selectively disclosable accountability records for critical system actions and claims.",
    "outcomes": [
      "traceable_critical_transitions",
      "selective_evidence_disclosure",
      "private_proof_without_unnecessary_source_disclosure",
      "recourse_support",
      "chain_of_custody",
      "retention_and_disposition_accountability"
    ],
    "non_goals": [
      "continuous_surveillance",
      "unbounded_telemetry_collection",
      "source_component_replication",
      "behavioral_scoring",
      "native_ai_analysis",
      "automated_policy_decision",
      "privileged_operation_execution",
      "release_activation",
      "cross_domain_publication"
    ]
  },
  "responsibilities": {
    "required": [
      {
        "responsibility_id": "accept_declared_audit_events",
        "description": "Accept only registered event classes through authenticated and versioned component interfaces."
      },
      {
        "responsibility_id": "validate_submission_envelopes",
        "description": "Validate producer identity, event type, schema, timestamp, scope, correlation identifiers, required receipts, and declared data classification."
      },
      {
        "responsibility_id": "preserve_bounded_audit_records",
        "description": "Store the minimum accepted record necessary for the declared audit, evidence, recourse, retention, or investigation purpose."
      },
      {
        "responsibility_id": "maintain_chain_of_custody",
        "description": "Record ingestion, transformation, redaction, access, disclosure, retention, legal or cultural hold, export, and disposition transitions."
      },
      {
        "responsibility_id": "execute_authorized_audit_queries",
        "description": "Execute deterministic queries within the requester's authorized scope without granting direct access to source-component stores."
      },
      {
        "responsibility_id": "produce_selective_disclosures",
        "description": "Produce minimized evidence packages, private proofs, or bounded reports using applicable policy decisions and source-data restrictions."
      },
      {
        "responsibility_id": "record_access_and_disclosure",
        "description": "Produce machine-readable receipts for successful, denied, partial, expired, cancelled, and failed audit access or disclosure operations."
      },
      {
        "responsibility_id": "support_recourse",
        "description": "Preserve sufficient references, reasons, actors, timestamps, and decision lineage for authorized review and challenge workflows."
      },
      {
        "responsibility_id": "enforce_retention_state",
        "description": "Apply registered retention, hold, expiry, archival, and disposition actions to Audit Broker-owned records."
      },
      {
        "responsibility_id": "report_health_and_evidence",
        "description": "Expose bounded health, readiness, queue, retention, integrity, and evidence status without exposing protected record content."
      }
    ],
    "prohibited": [
      "mutate_source_component_authoritative_state",
      "infer_authorization",
      "grant_privilege",
      "allocate_component_resources",
      "activate_release_or_artifact",
      "publish_cross_domain_content",
      "collect_unregistered_event_classes",
      "collect_all_available_source_data",
      "perform_native_ai_classification_or_summarization",
      "silently_expand_retention_or_disclosure_scope",
      "treat_observation_or_copy_as_source_ownership"
    ]
  },
  "authority_model": {
    "component_authority": [
      "validate_audit_submissions",
      "accept_or_reject_audit_records",
      "maintain_audit_record_state",
      "execute_authorized_deterministic_queries",
      "apply_audit_record_redaction",
      "produce_audit_disclosure_packages",
      "produce_access_disclosure_and_disposition_receipts"
    ],
    "external_authority_dependencies": {
      "identity_and_trust": [
        "producer_identity",
        "requester_identity",
        "signature_and_trust_verification",
        "revocation_status"
      ],
      "governance_policy_runtime": [
        "authorization",
        "purpose",
        "disclosure_scope",
        "consent",
        "exception",
        "retention_override",
        "hold_release"
      ],
      "source_component": [
        "source_event_semantics",
        "source_record_authority",
        "source_correction_or_retraction",
        "source_data_export"
      ],
      "publication_gateway": [
        "cross_domain_publication"
      ],
      "resource_governor": [
        "cpu_memory_io_queue_and_worker_limits"
      ],
      "evidence_registry": [
        "registered_evidence_identity_and_validity"
      ]
    },
    "missing_or_invalid_authority_result": "affected_operation_blocked",
    "policy_decision_cache": {
      "allowed": true,
      "scope_bound": true,
      "expiry_required": true,
      "revocation_check_required": true,
      "cache_does_not_transfer_policy_authority": true
    }
  },
  "data_model": {
    "authoritative_entities": [
      {
        "entity_id": "audit_record",
        "purpose": "Accepted bounded record of one registered auditable event.",
        "required_fields": [
          "audit_record_id",
          "event_class_id",
          "producer_component_id",
          "producer_identity",
          "occurred_at",
          "received_at",
          "subject_references",
          "action_or_transition",
          "outcome",
          "purpose",
          "classification",
          "retention_class",
          "correlation_id",
          "source_receipt_or_evidence_refs"
        ]
      },
      {
        "entity_id": "audit_access_receipt",
        "purpose": "Record of an allowed, denied, partial, cancelled, expired, or failed access request.",
        "required_fields": [
          "receipt_id",
          "request_id",
          "requester_identity",
          "purpose",
          "policy_decision_ref",
          "requested_scope",
          "effective_scope",
          "outcome",
          "occurred_at"
        ]
      },
      {
        "entity_id": "audit_disclosure_package",
        "purpose": "Minimized result of one authorized audit disclosure operation.",
        "required_fields": [
          "package_id",
          "request_id",
          "purpose",
          "scope",
          "record_refs",
          "redaction_profile",
          "generated_at",
          "expiry_or_validity",
          "chain_of_custody_ref"
        ]
      },
      {
        "entity_id": "audit_chain_of_custody",
        "purpose": "Ordered record of material transitions affecting an audit record or disclosure package.",
        "required_fields": [
          "chain_id",
          "subject_ref",
          "transition_type",
          "actor_or_component_identity",
          "occurred_at",
          "result",
          "receipt_ref"
        ]
      },
      {
        "entity_id": "audit_retention_state",
        "purpose": "Current retention, hold, archive, or disposition state of an Audit Broker-owned record.",
        "required_fields": [
          "record_ref",
          "retention_class",
          "state",
          "effective_at",
          "policy_or_hold_ref",
          "next_review_or_disposition_at"
        ]
      }
    ],
    "record_states": [
      "received",
      "validated",
      "accepted",
      "quarantined",
      "retained",
      "held",
      "archived",
      "expired",
      "disposed",
      "invalidated"
    ],
    "content_minimization": {
      "default": "metadata_and_declared_evidence_references",
      "full_source_payload_default": false,
      "field_allowlist_required": true,
      "purpose_binding_required": true,
      "data_classification_required": true,
      "redaction_supported": true,
      "pseudonymization_supported": true,
      "aggregation_supported": true,
      "source_retrieval_requires_separate_authority": true
    },
    "physical_storage_sharing_transfers_ownership": false,
    "copying_or_indexing_transfers_source_authority": false,
    "direct_cross_component_source_writes": "prohibited"
  },
  "registered_event_classes": [
    {
      "event_class_id": "policy_decision_event",
      "producer_refs": [
