{
  "$schema": "../../schemas/component-contract.schema.json",
  "component_id": "audit_broker",
  "component_type": "component_contract",
  "component_class": "accountability_and_evidence_service",
  "version": "1.0.0",
  "status": "active",
  "language": "en",
  "effective_at": "2026-08-03T16:26:00-04:00",
  "display_name": "Audit Broker",
  "description": "A selective accountability component that accepts declared audit events, receipts, and evidence references; preserves bounded audit records; and produces authorized evidence disclosures without acquiring authority over source components, source data, policy decisions, privilege, releases, or publication.",
  "scope": {
    "kind": "component",
    "owns": [
      "audit_record_identity",
      "accepted_audit_event_records",
      "audit_event_validation_results",
      "audit_record_retention_state",
      "audit_query_execution_state",
      "audit_disclosure_packages",
      "audit_disclosure_receipts",
      "audit_access_and_denial_receipts",
      "audit_redaction_results",
      "audit_chain_of_custody_records"
    ],
    "does_not_own": [
      "source_component_authoritative_state",
      "source_business_or_tenant_data",
      "identity_authority",
      "authorization_policy",
      "consent_policy",
      "privilege_authority",
      "resource_allocation_policy",
      "release_content_or_compatibility",
      "publication_authority",
      "test_definition_authority",
      "evidence_validity_authority",
      "external_provider_output"
    ]
  },
