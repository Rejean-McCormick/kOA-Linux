      ],
      "source_payload_required": false
    }
  ],
  "interfaces": {
    "commands": [
      {
        "interface_id": "submit_audit_event",
        "version": "1.0.0",
        "caller": "registered_component",
        "request": [
          "event_class_id",
          "producer_identity",
          "event_payload",
          "classification",
          "purpose",
          "retention_class",
          "correlation_id"
        ],
        "responses": [
          "accepted",
          "rejected",
          "quarantined"
        ],
        "idempotency_key_required": true
      },
      {
        "interface_id": "request_audit_disclosure",
        "version": "1.0.0",
        "caller": "authorized_actor_or_component",
        "request": [
          "request_id",
          "requester_identity",
          "purpose",
          "requested_scope",
          "subject_or_record_selectors",
          "desired_output_class",
          "expiry"
        ],
        "responses": [
          "allowed",
          "partially_allowed",
          "denied",
          "expired",
          "failed"
        ],
        "policy_decision_required": true
      },
      {
        "interface_id": "apply_retention_action",
        "version": "1.0.0",
        "caller": "authorized_lifecycle_or_policy_component",
        "request": [
          "record_selectors",
          "action",
          "policy_or_hold_ref",
          "effective_at"
        ],
        "responses": [
          "applied",
          "partially_applied",
          "denied",
          "failed"
        ],
        "receipt_required": true
      },
      {
        "interface_id": "invalidate_audit_record",
        "version": "1.0.0",
        "caller": "source_component_or_authorized_governance_actor",
        "request": [
          "record_ref",
          "source_correction_or_retraction_ref",
          "reason",
          "effective_at"
        ],
        "responses": [
          "invalidated",
          "denied",
          "not_found",
          "failed"
        ],
        "deletion_by_invalidation": false
      }
    ],
    "queries": [
      {
        "interface_id": "get_audit_record_metadata",
        "version": "1.0.0",
        "authorization_required": true,
        "default_result": "metadata_only"
      },
      {
        "interface_id": "get_audit_request_status",
        "version": "1.0.0",
        "authorization_required": true,
        "default_result": "status_without_protected_content"
      },
      {
        "interface_id": "get_audit_health",
        "version": "1.0.0",
        "authorization_required": true,
        "default_result": "bounded_health_and_readiness"
      }
    ],
    "events": [
      "audit_record_accepted",
      "audit_record_rejected",
      "audit_record_quarantined",
      "audit_record_invalidated",
      "audit_disclosure_completed",
      "audit_disclosure_denied",
      "audit_retention_state_changed",
      "audit_integrity_failure_detected",
      "audit_capacity_pressure_detected"
    ],
    "direct_database_access": false,
    "unregistered_interface_result": "rejected"
  },
  "disclosure_workflow": {
    "steps": [
      "authenticate_requester",
      "validate_request_schema_and_expiry",
      "resolve_requested_subjects_and_records",
      "request_or_validate_governance_policy_decision",
      "apply_purpose_and_scope_limits",
      "apply_consent_rights_and_exception_constraints",
      "minimize_fields_and_records",
      "apply_redaction_pseudonymization_or_aggregation",
      "verify_chain_of_custody",
      "produce_bounded_package",
      "produce_access_and_disclosure_receipts",
      "deliver_through_authorized_interface_or_gateway"
    ],
    "policy_runtime_is_decision_owner": true,
    "audit_broker_may_broaden_policy_scope": false,
    "source_component_retrieval_may_be_required": true,
    "source_component_retrieval_is_separate_operation": true,
    "cross_domain_publication_requires_publication_gateway": true,
    "partial_disclosure_supported": true,
    "denial_reason_receipt_required": true
  },
  "security": {
    "default_network_posture": "deny_except_declared_flows",
    "mutual_authentication_for_component_submissions": true,
    "requester_authentication_required": true,
    "producer_identity_verification_required": true,
    "signature_verification_when_required": true,
    "replay_protection_required": true,
    "idempotency_required_for_mutations": true,
    "encryption_in_transit_required": true,
    "encryption_at_rest_required_when_profile_requires": true,
    "component_scoped_service_identity": true,
    "shared_unscoped_administrator_identity": false,
    "secrets_in_records_logs_or_evidence": false,
    "field_level_access_control_supported": true,
    "purpose_bound_access_required": true,
    "break_glass": {
      "normal_authority_bypass_allowed": false,
      "separate_governed_procedure_required": true,
      "time_bound": true,
      "actor_bound": true,
      "scope_bound": true,
      "post_event_review_required": true,
      "receipt_required": true
    }
  },
  "privacy_rights_and_recourse": {
    "selective_audit": true,
    "indiscriminate_collection": false,
    "subject_access_supported": true,
    "authorized_correction_or_retraction_linkage_supported": true,
    "erasure_or_disposition_subject_to_retention_and_hold": true,
    "purpose_limitation": true,
    "data_minimization": true,
    "disclosure_accountability": true,
    "cultural_rights_and_consent_constraints_preserved": true,
    "recourse_package_may_include": [
      "decision_lineage",
      "actor_and_component_refs",
      "timestamps",
      "policy_refs",
      "receipts",
      "source_evidence_refs",
      "redaction_explanation",
      "denial_or_partial_disclosure_reason"
    ]
  },
  "resource_governance": {
    "resource_governor_ref": "generated/component-catalog.json#/components/resource_governor",
    "governance_policy_runtime_ref": "generated/component-catalog.json#/components/governance_policy_runtime",
    "authorities_are_separate": true,
    "bounded_resources": [
      "ingestion_rate",
      "validation_workers",
      "query_workers",
      "redaction_workers",
      "disclosure_package_size",
      "retention_jobs",
      "storage_growth",
      "temporary_export_space",
      "outbound_bandwidth"
    ],
    "pressure_order": [
      "reject_unregistered_or_oversized_submissions",
      "defer_nonurgent_indexing",
      "reduce_query_concurrency",
      "defer_nonurgent_disclosures",
      "preserve_critical_transition_receipts",
      "preserve_policy_and_access_receipts",
      "preserve_chain_of_custody",
      "enter_read_only_mode_before_integrity_risk"
    ],
    "unbounded_queries": false,
    "unbounded_exports": false,
    "unbounded_retention": false
  },
  "retention_and_disposition": {
    "retention_class_required": true,
    "supported_states": [
      "active",
      "held",
      "archived",
      "expired",
      "disposition_pending",
      "disposed",
      "invalidated"
    ],
    "default_retention_inference_allowed": false,
    "policy_or_contract_reference_required": true,
    "legal_or_cultural_hold_supported": true,
    "hold_prevents_disposition": true,
    "disposition_requires": [
      "authorization",
      "reference_and_dependency_check",
      "hold_check",
      "retention_expiry",
      "chain_of_custody_update",
      "disposition_receipt"
    ],
    "cryptographic_or_physical_deletion_is_profile_and_storage_conditioned": true,
    "invalidated_records_are_preserved_as_lineage_when_retention_requires": true,
    "disposition_may_not_delete_source_component_data": true
  },
  "integrity_and_provenance": {
    "record_provenance_required": true,
    "producer_identity_required": true,
    "source_receipt_or_evidence_refs_required_when_applicable": true,
    "chain_of_custody_required": true,
    "record_integrity": {
      "mode": "profile_or_artifact_class_conditioned",
      "allowed_algorithms": [
        "sha256",
        "sha384",
        "sha512",
        "blake3"
      ],
      "digest_scope": [
        "canonical_audit_record",
        "disclosure_package",
        "retained_evidence_artifact"
      ]
    },
    "record_signing": {
      "mode": "profile_or_artifact_class_conditioned",
      "trust_scope": [
        "component",
        "profile",
        "organization",
        "release_channel",
        "system"
      ]
    },
    "tamper_detection_result": "record_quarantined_and_claim_blocked",
    "manual_record_mutation": "prohibited",
    "correction_method": "append_correction_or_invalidation_record"
  },
  "external_integrations": {
    "native_or_automatic_use": false,
    "allowed": [],
    "prohibited": [
      "chatgpt",
      "suno",
      "gamma",
      "ariane-voice"
    ],
    "reason": "Protected audit content, disclosure decisions, redaction, classification, and evidence validity remain deterministic local or governed operations. An external service cannot act as the Audit Broker or receive automatic audit data.",
    "external_output_may_become_audit_authority": false,
