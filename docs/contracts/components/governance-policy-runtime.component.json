  "failure_contract": [
    {
      "failure_code": "GOV_POLICY_MISSING",
      "condition": "No active applicable policy set resolves.",
      "result": "blocked",
      "preserve": "previous_valid_policy_set_when_explicitly_permitted_and_verifiable",
      "retry": "after_policy_authority_restored"
    },
    {
      "failure_code": "GOV_POLICY_STALE",
      "condition": "Policy freshness or authority-version validity fails.",
      "result": "blocked",
      "preserve": "unaffected_non_governed_capabilities",
      "retry": "after_compatible_policy_refresh"
    },
    {
      "failure_code": "GOV_POLICY_INCOMPATIBLE",
      "condition": "Policy set is incompatible with profile, component, release, or evaluator.",
      "result": "blocked",
      "preserve": "current_compatible_active_policy_set",
      "retry": "after_compatibility_restored"
    },
    {
      "failure_code": "GOV_IDENTITY_UNVERIFIED",
      "condition": "Required identity or trust assertion cannot be verified.",
      "result": "blocked",
      "preserve": "unaffected_verified_activity",
      "retry": "after_trust_verification"
    },
    {
      "failure_code": "GOV_CONTEXT_INVALID",
      "condition": "Required context is missing, malformed, excessive, or unauthorized.",
      "result": "blocked",
      "preserve": "authoritative_component_state",
      "retry": "with_valid_bounded_context"
    },
    {
      "failure_code": "GOV_EXCEPTION_INVALID",
      "condition": "Exception is missing, inactive, expired, closed, or out of scope.",
      "result": "evaluate_without_exception_or_block_under_base_rule",
      "preserve": "underlying_requirement_and_lock",
      "retry": "only_with_active_applicable_exception"
    },
    {
      "failure_code": "GOV_OBLIGATION_UNSATISFIED",
      "condition": "Caller cannot satisfy a required obligation.",
      "result": "blocked",
      "preserve": "pre_transition_state",
      "retry": "after_obligation_can_be_satisfied"
    },
    {
      "failure_code": "GOV_RECEIPT_FAILURE",
      "condition": "A required decision receipt cannot be durably created.",
      "result": "blocked_for_receipt_required_transition",
      "preserve": "pre_transition_state",
      "retry": "after_receipt_storage_recovers"
    },
    {
      "failure_code": "GOV_AUDIT_UNAVAILABLE",
      "condition": "Required audit evidence intake is unavailable.",
      "result": "profile_evidence_policy_applied",
      "preserve": "locally_retained_evidence_when_permitted",
      "retry": "after_audit_or_buffer_recovery"
    },
    {
      "failure_code": "GOV_ACTIVATION_FAILED",
      "condition": "Policy-set activation fails.",
      "result": "candidate_inactive",
      "preserve": "previous_valid_policy_set",
      "retry": "after_validation_or_repair"
    },
    {
      "failure_code": "GOV_EXTERNAL_AI_UNAVAILABLE",
      "condition": "An optional external AI surface is unavailable.",
      "result": "no_effect_on_native_policy_evaluation",
      "preserve": "all_native_policy_capabilities",
      "retry": "not_required_for_core_recovery"
    }
  ],
