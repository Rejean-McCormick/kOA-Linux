  "responsibilities": [
    {
      "responsibility_id": "PUB-RESP-001",
      "name": "Request admission",
      "description": "Validate the publication request structure, requester identity, source reference, declared purpose, destination, audience, representation, requested transformations, and required authority references."
    },
    {
      "responsibility_id": "PUB-RESP-002",
      "name": "Source binding",
      "description": "Bind the request to an immutable source version or another explicitly stable source identity supplied by the owning component."
    },
    {
      "responsibility_id": "PUB-RESP-003",
      "name": "Authority resolution",
      "description": "Resolve identity, delegation, trust, consent, cultural authority, governance policy, exceptions, and time validity before approval."
    },
    {
      "responsibility_id": "PUB-RESP-004",
      "name": "Bounded representation",
      "description": "Create or receive only the exact release representation approved for the declared destination, audience, purpose, and duration."
    },
    {
      "responsibility_id": "PUB-RESP-005",
      "name": "Decision mediation",
      "description": "Record an allow, deny, blocked, or review-required decision together with obligations and supporting authority."
    },
    {
      "responsibility_id": "PUB-RESP-006",
      "name": "Controlled execution",
      "description": "Execute release only after the approved representation and all decision obligations pass final validation."
    },
    {
      "responsibility_id": "PUB-RESP-007",
      "name": "Receipt production",
      "description": "Produce a publication receipt that records what was released, under which authority, to which destination and audience, and with what result."
    },
    {
      "responsibility_id": "PUB-RESP-008",
      "name": "Revocation response",
      "description": "Stop future and reversible pending publication within the revoked scope and record supported downstream remediation without falsifying history."
    },
    {
      "responsibility_id": "PUB-RESP-009",
      "name": "Selective audit",
      "description": "Expose the minimum proof required for accountability while protecting restricted source material, identities, and cultural details."
    }
  ],
  "non_responsibilities": [
