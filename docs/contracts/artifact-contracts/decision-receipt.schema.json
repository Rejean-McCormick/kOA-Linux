{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/decision-receipt.schema.json",
  "title": "kOA Decision Receipt",
  "description": "Validates a versioned, machine-readable receipt for an authority decision or critical lifecycle transition. A receipt records the request, deciding authority, exact context, outcome, reasons, obligations, effects, traceability, disclosure controls, and optional cryptographic evidence. The receipt is evidence of a decision; it does not become an independent policy, architectural decision, resource grant, component mutation, or activation authority.",
  "$comment": "Version 2.0.0 retains the base decision-receipt role and extends it for policy, privilege, resource, release, publication, verification, activation, rollback, forward-repair, import, export, migration, and component-transition receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_class",
    "receipt_id",
    "receipt_type",
    "timestamp",
    "issuer",
    "request",
    "context",
    "decision",
    "reason_codes",
    "correlation_id",
    "traceability",
    "disclosure"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "artifact_class": {
      "type": "string",
      "const": "decision_receipt"
    },
    "receipt_id": {
      "$ref": "#/$defs/receipt_id"
    },
    "receipt_type": {
      "$ref": "#/$defs/receipt_type"
    },
    "timestamp": {
      "$ref": "#/$defs/timestamp"
    },
    "issuer": {
      "$ref": "#/$defs/issuer"
    },
    "request": {
      "$ref": "#/$defs/request"
    },
    "context": {
      "$ref": "#/$defs/decision_context"
    },
    "policy": {
      "$ref": "#/$defs/policy_reference"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact_reference"
      }
    },
    "resource_decision": {
      "$ref": "#/$defs/resource_decision"
    },
    "transition": {
      "$ref": "#/$defs/state_transition"
    },
    "decision": {
      "$ref": "#/$defs/decision_outcome"
    },
    "decision_finality": {
      "type": "string",
      "enum": [
        "final",
        "conditional",
        "provisional",
        "advisory"
      ],
      "default": "final"
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reason_code"
      }
    },
    "reason_details": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reason_detail"
      }
    },
    "obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "redactions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/redaction"
      }
    },
    "effects": {
      "$ref": "#/$defs/effects"
    },
    "validity": {
      "$ref": "#/$defs/validity"
    },
    "correlation_id": {
      "$ref": "#/$defs/correlation_id"
    },
    "causation_id": {
      "$ref": "#/$defs/correlation_id"
    },
    "related_receipts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/related_receipt"
      }
    },
    "previous_receipt_hash": {
      "$ref": "#/$defs/digest",
      "description": "Optional integrity-chain link retained from the base receipt contract. It does not establish semantic authority by itself."
    },
    "traceability": {
      "$ref": "#/$defs/traceability"
    },
    "disclosure": {
      "$ref": "#/$defs/disclosure"
    },
    "integrity": {
      "$ref": "#/$defs/receipt_integrity"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/signature"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "receipt_type": {
            "enum": [
              "policy_decision",
              "privilege_decision",
              "disclosure_decision",
              "consent_decision",
              "exception_decision"
            ]
          }
        },
        "required": [
          "receipt_type"
        ]
      },
      "then": {
        "required": [
          "policy"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "receipt_type": {
            "enum": [
              "publication_decision",
              "release_compatibility",
              "artifact_verification",
              "artifact_activation",
              "rollback",
              "forward_repair",
              "import_decision",
              "export_decision",
              "migration_decision"
            ]
          }
        },
        "required": [
          "receipt_type"
        ]
      },
      "then": {
        "required": [
          "artifacts"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "receipt_type": {
            "const": "resource_admission"
          }
        },
        "required": [
          "receipt_type"
        ]
      },
      "then": {
        "required": [
          "resource_decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "receipt_type": {
            "enum": [
              "artifact_activation",
              "rollback",
              "forward_repair",
              "migration_decision",
              "component_transition"
            ]
          }
        },
        "required": [
          "receipt_type"
        ]
      },
      "then": {
        "required": [
          "transition"
        ]
      }
    },
    {
      "if": {
        "required": [
          "signatures"
        ]
      },
      "then": {
        "required": [
          "integrity"
        ]
      }
    }
  ],
  "$defs": {
    "semantic_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "canonical_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "snake_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "canonical_reference": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "^(?!(?:/|.*(?:^|/)\\.\\.(?:/|$)))(?:[^#\\s]+(?:#(?:/.*)?)?|(?:DOC|DEC|REQ|LOCK|ADR|TEST|EVID|EXC)-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3})$"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 11,
      "maxLength": 256,
      "pattern": "^receipt:[A-Za-z0-9][A-Za-z0-9._:/+-]*$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^(?:sha256:[0-9a-f]{64}|sha384:[0-9a-f]{96}|sha512:[0-9a-f]{128})$"
    },
    "receipt_type": {
      "type": "string",
      "enum": [
        "policy_decision",
        "privilege_decision",
        "disclosure_decision",
        "consent_decision",
        "resource_admission",
        "publication_decision",
        "release_compatibility",
        "artifact_verification",
        "artifact_activation",
        "rollback",
        "forward_repair",
        "import_decision",
        "export_decision",
        "migration_decision",
        "component_transition",
        "external_processing_decision",
        "exception_decision"
      ]
    },
    "decision_outcome": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "require_review",
        "approved",
        "rejected",
        "admitted",
        "queued",
        "throttled",
        "paused",
        "completed",
        "failed",
        "blocked",
        "degraded",
        "quarantined",
        "revoked",
        "cancelled",
        "rollback_required",
        "forward_repair_required"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9_:-]*$"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "global"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "profile",
                "profile_overlay",
                "component",
                "tenant",
                "node",
                "workspace",
                "artifact",
                "release_set",
                "operation",
                "integration",
                "user_session"
              ]
            },
            "id": {
              "$ref": "#/$defs/canonical_identifier"
            }
          }
        }
      ]
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "authority_type",
        "software_version",
        "contract_ref"
      ],
      "properties": {
        "authority_id": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "authority_type": {
          "type": "string",
          "enum": [
            "component",
            "policy_runtime",
            "resource_governor",
            "identity_and_trust",
            "privileged_broker",
            "lifecycle_authority",
            "gateway",
            "control_plane",
            "human_authority",
            "external_system",
            "other_registered"
          ]
        },
        "component_id": {
          "$ref": "#/$defs/snake_identifier"
        },
        "node_id": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "service_instance_id": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "software_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "contract_ref": {
          "$ref": "#/$defs/canonical_reference"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "action",
        "resource"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/correlation_id"
        },
        "subject": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "subject_type": {
          "$ref": "#/$defs/snake_identifier"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "resource": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "resource_type": {
          "$ref": "#/$defs/snake_identifier"
        },
        "tenant_id": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "profile_id": {
          "$ref": "#/$defs/snake_identifier"
        },
        "node_id": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "workspace_id": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "component_id": {
          "$ref": "#/$defs/snake_identifier"
        },
        "operation_id": {
          "$ref": "#/$defs/correlation_id"
        },
        "parent_request_id": {
          "$ref": "#/$defs/correlation_id"
        },
        "requested_at": {
          "$ref": "#/$defs/timestamp"
        },
        "input_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonical_reference"
          }
        }
      }
    },
    "decision_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "contract_refs"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "contract_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonical_reference"
          }
        },
        "effective_profile": {
          "$ref": "#/$defs/snake_identifier"
        },
        "overlay_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/snake_identifier"
          }
        },
        "component_id": {
          "$ref": "#/$defs/snake_identifier"
        },
        "tenant_id": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "node_id": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "workspace_id": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "release_set_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "trust_context_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "resource_grant_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "policy_decision_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "exception_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonical_reference"
          }
        },
        "current_state_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "target_state_ref": {
          "$ref": "#/$defs/canonical_reference"
        }
      }
    },
    "policy_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "module": {
          "$ref": "#/$defs/snake_identifier"
        },
        "bundle_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "decision_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "exception_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonical_reference"
          }
        }
      }
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_class",
        "artifact_version",
        "release_channel",
        "digest"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "artifact_class": {
          "$ref": "#/$defs/snake_identifier"
        },
        "artifact_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "release_channel": {
          "type": "string",
          "enum": [
            "system",
            "services",
            "governance",
            "knowledge"
          ]
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "contract_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "source_uri": {
          "type": "string",
          "format": "uri-reference",
          "maxLength": 2048
        },
        "target_ref": {
          "$ref": "#/$defs/canonical_reference"
        }
      }
    },
    "resource_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_scope",
        "admission_state"
      ],
      "properties": {
        "resource_scope": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "admission_state": {
          "type": "string",
          "enum": [
            "admitted",
            "queued",
            "throttled",
            "paused",
            "denied",
            "blocked"
          ]
        },
        "budget_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "grant_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "queue_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "priority_class": {
          "$ref": "#/$defs/snake_identifier"
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      }
    },
    "state_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "from_state",
        "to_state",
        "transition_status"
      ],
      "properties": {
        "transition_id": {
          "$ref": "#/$defs/correlation_id"
        },
        "from_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "to_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "transition_status": {
          "type": "string",
          "enum": [
            "accepted",
            "completed",
            "failed",
            "blocked",
            "degraded",
            "cancelled",
            "rolled_back",
            "forward_repair_required"
          ]
        },
        "owner_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "rollback_target_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "forward_repair_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "reason_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/reason_code"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "related_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonical_reference"
          }
        }
      }
    },
    "obligation": {
      "oneOf": [
        {
          "$ref": "#/$defs/reason_code"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "obligation_id",
            "action",
            "owner"
          ],
          "properties": {
            "obligation_id": {
              "$ref": "#/$defs/canonical_identifier"
            },
            "action": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "owner": {
              "$ref": "#/$defs/canonical_identifier"
            },
            "due_at": {
              "$ref": "#/$defs/timestamp"
            },
            "completion_evidence_ref": {
              "$ref": "#/$defs/canonical_reference"
            }
          }
        }
      ]
    },
    "redaction": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "reason"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "policy_ref": {
              "$ref": "#/$defs/canonical_reference"
            }
          }
        }
      ]
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorized_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "prohibited_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "performed_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "affected_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonical_reference"
          }
        }
      },
      "minProperties": 1
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valid_from": {
          "$ref": "#/$defs/timestamp"
        },
        "valid_until": {
          "$ref": "#/$defs/timestamp"
        },
        "single_use": {
          "type": "boolean"
        },
        "reuse_scope": {
          "type": "string",
          "enum": [
            "none",
            "same_request",
            "same_operation",
            "same_target_context"
          ]
        },
        "revocation_check_required": {
          "type": "boolean"
        }
      },
      "minProperties": 1
    },
    "related_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "relation"
      ],
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/receipt_id"
        },
        "relation": {
          "type": "string",
          "enum": [
            "supersedes",
            "superseded_by",
            "caused_by",
            "causes",
            "reviews",
            "reviewed_by",
            "rolls_back",
            "rolled_back_by",
            "repairs",
            "repaired_by",
            "depends_on",
            "evidence_for"
          ]
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_refs",
        "requirement_refs",
        "lock_refs",
        "test_refs",
        "evidence_refs"
      ],
      "properties": {
        "decision_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DEC-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
          }
        },
        "requirement_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REQ-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
          }
        },
        "lock_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^LOCK-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
          }
        },
        "test_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^TEST-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVID-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "decision_refs": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "requirement_refs": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "lock_refs": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "test_refs": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "evidence_refs": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "contains_secret_values"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "authorized_internal",
            "restricted"
          ]
        },
        "contains_secret_values": {
          "type": "boolean",
          "const": false
        },
        "contains_personal_data": {
          "type": "boolean"
        },
        "contains_restricted_provenance": {
          "type": "boolean"
        },
        "redaction_policy_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "authorized_view_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonical_reference"
          }
        }
      }
    },
    "receipt_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "receipt_digest"
      ],
      "properties": {
        "canonicalization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "digest_scope": {
          "type": "string",
          "enum": [
            "receipt_without_integrity_and_signatures",
            "receipt_without_signatures",
            "declared_canonical_fields"
          ],
          "default": "receipt_without_integrity_and_signatures"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kid",
        "algorithm",
        "value"
      ],
      "properties": {
        "kid": {
          "$ref": "#/$defs/canonical_identifier"
        },
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16384,
          "contentEncoding": "base64"
        },
        "signed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "signed_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "trust_context_ref": {
          "$ref": "#/$defs/canonical_reference"
        },
        "certificate_chain_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonical_reference"
          }
        }
      }
    }
  }
}
