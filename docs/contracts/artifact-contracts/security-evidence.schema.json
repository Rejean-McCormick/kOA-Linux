{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/security-evidence.schema.json",
  "title": "kOA Security Evidence",
  "description": "Validates evidence that a declared kOA security control was evaluated for a specific profile, subject, implementation, and version. The evidence records method, result, observations, digests, exceptions, signer information, and retention. It does not grant authorization, activate a release, or independently establish profile conformance.",
  "$comment": "Semantic validation resolves the control and profile against contracts/security-controls.contract.json, verifies that the control is applicable, checks evidence freshness and subject digests, validates test and exception references, and rejects a pass result that lacks the evidence required by the control.",
  "x-koa-contract": {
    "contract_id": "security_evidence",
    "contract_version": "1.0.0",
    "status": "active",
    "language": "en",
    "owner": "security_architecture",
    "object_kind": "security_control_evidence",
    "canonical_refs": [
      "contracts/security-controls.contract.json",
      "07-security/21-security-control-architecture.md",
      "07-security/22-security-control-profile-matrix.md",
      "generated/evidence-catalog.json"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_type",
    "schema_version",
    "evidence_id",
    "status",
    "language",
    "control_id",
    "profile_id",
    "subject_ref",
    "implementation_ref",
    "implementation_version",
    "evaluation",
    "result",
    "recorded_at",
    "evidence_digest",
    "disclosure_class",
    "retention_class",
    "authority"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "anyOf": [
        {
          "const": "../artifact-contracts/security-evidence.schema.json"
        },
        {
          "pattern": "(?:^|/)security-evidence\\.schema\\.json$"
        }
      ]
    },
    "artifact_type": {
      "const": "security_evidence"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^SEC-EVID-[A-Z0-9][A-Z0-9-]{5,127}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "retired"
      ]
    },
    "language": {
      "const": "en"
    },
    "control_id": {
      "type": "string",
      "pattern": "^SEC-[A-Z]+-[0-9]{3}$"
    },
    "profile_id": {
      "type": "string",
      "enum": [
        "user_lightweight",
        "developer_linux_workstation",
        "developer_windows_wsl",
        "sovereign_linux_node",
        "sovereign_hub",
        "build_farm",
        "control_plane",
        "high_assurance",
        "sovereign_offline",
        "appliance_shell"
      ]
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "implementation_ref": {
      "type": "string",
      "minLength": 1
    },
    "implementation_version": {
      "type": "string",
      "minLength": 1
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "validator_ref",
        "test_refs",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "automated_test",
            "runtime_probe",
            "inspection",
            "recovery_exercise",
            "independent_review",
            "combined"
          ]
        },
        "validator_ref": {
          "type": "string",
          "minLength": 1
        },
        "test_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "environment_ref": {
          "type": "string",
          "minLength": 1
        },
        "toolchain_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "partial",
        "not_applicable"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exception_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_digest": {
      "$ref": "#/$defs/digest"
    },
    "subject_digest": {
      "$ref": "#/$defs/digest"
    },
    "signatures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signature"
      }
    },
    "disclosure_class": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "restricted",
        "confidential"
      ]
    },
    "retention_class": {
      "type": "string",
      "enum": [
        "release_lifetime",
        "control_lifetime",
        "incident_lifetime",
        "profile_lifetime",
        "permanent"
      ]
    },
    "example": {
      "type": "boolean"
    },
    "authority": {
      "type": "string",
      "enum": [
        "security_evidence",
        "non_authoritative_example"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "pass"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "test_refs": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "example": {
            "const": true
          }
        },
        "required": [
          "example"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "const": "non_authoritative_example"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signer_ref",
        "algorithm",
        "signature_ref"
      ],
      "properties": {
        "signer_ref": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "signature_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
