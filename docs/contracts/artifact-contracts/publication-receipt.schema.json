{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/publication-receipt.schema.json",
  "title": "kOA Publication Receipt",
  "description": "Contract for an immutable historical receipt produced by Publication Gateway after a bounded publication execution reaches a terminal outcome. The receipt binds the request, decision, source version, approved representation, destination, audience, authority, execution result, provenance, evidence, and any later withdrawal or remediation state without becoming a second authoritative copy of the source content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "receipt_id",
    "version",
    "record_status",
    "language",
    "issued_at",
    "issuer",
    "request",
    "decision",
    "source",
    "destination",
    "audience",
    "purpose",
    "representation",
    "authority",
    "execution",
    "publication_state",
    "provenance",
    "evidence"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "publication-receipt.schema.json",
      "description": "Optional local schema filename used by serialized instances."
    },
    "artifact_class": {
      "type": "string",
      "const": "publication_receipt"
    },
    "receipt_id": {
      "$ref": "#/$defs/stableId",
      "description": "Stable identity of this immutable publication receipt."
    },
    "version": {
      "$ref": "#/$defs/semanticVersion",
      "description": "Version of this receipt representation. A corrected receipt uses a new receipt identity or explicit lineage and does not mutate historical facts."
    },
    "record_status": {
      "type": "string",
      "enum": [
        "issued",
        "superseded"
      ]
    },
    "language": {
      "type": "string",
      "const": "en"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "$ref": "#/$defs/issuer"
    },
    "request": {
      "$ref": "#/$defs/requestBinding"
    },
    "decision": {
      "$ref": "#/$defs/decisionBinding"
    },
    "source": {
      "$ref": "#/$defs/sourceBinding"
    },
    "destination": {
      "$ref": "#/$defs/destinationBinding"
    },
    "audience": {
      "$ref": "#/$defs/audienceBinding"
    },
    "purpose": {
      "$ref": "#/$defs/purposeBinding"
    },
    "representation": {
      "$ref": "#/$defs/representationBinding"
    },
    "authority": {
      "$ref": "#/$defs/authorityBinding"
    },
    "execution": {
      "$ref": "#/$defs/executionRecord"
    },
    "publication_state": {
      "$ref": "#/$defs/publicationState"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "lineage": {
      "$ref": "#/$defs/receiptLineage"
    },
    "notes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/boundedText"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_status": {
            "const": "superseded"
          }
        },
        "required": [
          "record_status"
        ]
      },
      "then": {
        "required": [
          "lineage"
        ],
        "properties": {
          "lineage": {
            "required": [
              "superseded_by_receipt_id",
              "supersession_reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "result": {
                "const": "published"
              }
            },
            "required": [
              "result"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "required": [
              "published_at",
              "destination_acknowledgement"
            ],
            "properties": {
              "destination_acknowledgement": {
                "properties": {
                  "status": {
                    "const": "accepted"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "result": {
                "const": "partially_delivered"
              }
            },
            "required": [
              "result"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "required": [
              "partial_delivery",
              "failure"
            ]
          },
          "publication_state": {
            "properties": {
              "state": {
                "enum": [
                  "remediation_pending",
                  "remediated",
                  "external_limitation"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "result": {
                "const": "failed"
              }
            },
            "required": [
              "result"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "required": [
              "failure"
            ],
            "not": {
              "required": [
                "published_at"
              ]
            }
          },
          "publication_state": {
            "properties": {
              "state": {
                "const": "not_published"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "result": {
                "const": "cancelled"
              }
            },
            "required": [
              "result"
            ]
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "required": [
              "cancellation"
            ],
            "not": {
              "required": [
                "published_at"
              ]
            }
          },
          "publication_state": {
            "properties": {
              "state": {
                "const": "not_published"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication_state": {
            "properties": {
              "state": {
                "enum": [
                  "withdrawal_pending",
                  "withdrawn",
                  "remediation_pending",
                  "remediated",
                  "external_limitation"
                ]
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "publication_state"
        ]
      },
      "then": {
        "properties": {
          "publication_state": {
            "required": [
              "change_record"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "destination": {
            "properties": {
              "destination_kind": {
                "enum": [
                  "configured_federation_peer",
                  "approved_external_destination"
                ]
              }
            },
            "required": [
              "destination_kind"
            ]
          }
        },
        "required": [
          "destination"
        ]
      },
      "then": {
        "properties": {
          "destination": {
            "required": [
              "integration_manifest_ref"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "nonEmptyRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "optionalRefs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "service_identity_ref",
        "component_contract_ref",
        "component_version"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "const": "publication_gateway"
        },
        "service_identity_ref": {
          "$ref": "#/$defs/stableId"
        },
        "component_contract_ref": {
          "type": "string",
          "const": "contracts/components/publication-gateway.component.json"
        },
        "component_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "release_set_ref": {
          "$ref": "#/$defs/stableId"
        },
        "profile_id": {
          "$ref": "#/$defs/stableId"
        },
        "node_identity_ref": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "requestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_version",
        "request_artifact_ref",
        "idempotency_key",
        "requested_at",
        "requester_identity_ref"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/stableId"
        },
        "request_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "request_artifact_ref": {
          "$ref": "#/$defs/stableId"
        },
        "idempotency_key": {
          "$ref": "#/$defs/stableId"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "requester_identity_ref": {
          "$ref": "#/$defs/stableId"
        },
        "requester_component_id": {
          "$ref": "#/$defs/stableId"
        },
        "tenant_ref": {
          "$ref": "#/$defs/stableId"
        },
        "authority_domain_ref": {
          "$ref": "#/$defs/stableId"
        },
        "correlation_id": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "decisionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "decision_result",
        "decided_at",
        "governance_decision_ref",
        "obligation_results"
      ],
      "properties": {
        "decision_id": {
          "$ref": "#/$defs/stableId"
        },
        "decision_result": {
          "type": "string",
          "const": "allow"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "governance_decision_ref": {
          "$ref": "#/$defs/stableId"
        },
        "decision_policy_refs": {
          "$ref": "#/$defs/nonEmptyRefs"
        },
        "human_review_refs": {
          "$ref": "#/$defs/optionalRefs"
        },
        "exception_refs": {
          "$ref": "#/$defs/optionalRefs"
        },
        "obligation_results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/obligationResult"
          }
        }
      }
    },
    "obligationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "result"
      ],
      "properties": {
        "obligation_id": {
          "$ref": "#/$defs/stableId"
        },
        "result": {
          "type": "string",
          "enum": [
            "satisfied",
            "not_applicable"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/optionalRefs"
        },
        "note": {
          "$ref": "#/$defs/shortText"
        }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_component_id",
        "source_authority_domain_ref",
        "source_object_ref",
        "source_version",
        "source_owner_identity_ref"
      ],
      "properties": {
        "source_component_id": {
          "$ref": "#/$defs/stableId"
        },
        "source_authority_domain_ref": {
          "$ref": "#/$defs/stableId"
        },
        "source_object_ref": {
          "$ref": "#/$defs/stableId"
        },
        "source_version": {
          "$ref": "#/$defs/stableId"
        },
        "source_owner_identity_ref": {
          "$ref": "#/$defs/stableId"
        },
        "source_collection_ref": {
          "$ref": "#/$defs/stableId"
        },
        "source_snapshot_ref": {
          "$ref": "#/$defs/stableId"
        },
        "source_provenance_refs": {
          "$ref": "#/$defs/optionalRefs"
        },
        "source_content_embedded": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "destinationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination_id",
        "destination_kind",
        "destination_authority_domain_ref",
        "destination_ref"
      ],
      "properties": {
        "destination_id": {
          "$ref": "#/$defs/stableId"
        },
        "destination_kind": {
          "type": "string",
          "enum": [
            "local_domain",
            "configured_hub",
            "configured_federation_peer",
            "approved_external_destination"
          ]
        },
        "destination_authority_domain_ref": {
          "$ref": "#/$defs/stableId"
        },
        "destination_ref": {
          "$ref": "#/$defs/stableId"
        },
        "destination_component_id": {
          "$ref": "#/$defs/stableId"
        },
        "integration_manifest_ref": {
          "$ref": "#/$defs/stableId"
        },
        "delivery_endpoint_ref": {
          "$ref": "#/$defs/stableId"
        },
        "provider_identity_ref": {
          "$ref": "#/$defs/stableId"
        },
        "deletion_support": {
          "type": "string",
          "enum": [
            "controlled_local_removal",
            "supported_request",
            "unsupported",
            "not_applicable"
          ]
        }
      }
    },
    "audienceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience_id",
        "audience_class",
        "scope"
      ],
      "properties": {
        "audience_id": {
          "$ref": "#/$defs/stableId"
        },
        "audience_class": {
          "type": "string",
          "enum": [
            "named_individuals",
            "named_group",
            "authenticated_tenant",
            "authenticated_domain",
            "restricted_public",
            "public"
          ]
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "geographic_scope_refs": {
          "$ref": "#/$defs/optionalRefs"
        },
        "redistribution": {
          "type": "string",
          "enum": [
            "prohibited",
            "restricted",
            "permitted"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "purposeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose_id",
        "operation_class"
      ],
      "properties": {
        "purpose_id": {
          "$ref": "#/$defs/stableId"
        },
        "operation_class": {
          "type": "string",
          "enum": [
            "publication",
            "republication",
            "distribution",
            "controlled_external_delivery"
          ]
        },
        "description": {
          "$ref": "#/$defs/shortText"
        },
        "commercial_use": {
          "type": "boolean"
        },
        "research_use": {
          "type": "boolean"
        },
        "training_or_model_improvement": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "representationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation_id",
        "artifact_ref",
        "media_type",
        "language",
        "source_relation",
        "minimum_necessary_confirmed",
        "context_preserved",
        "attribution",
        "transformations"
      ],
      "properties": {
        "representation_id": {
          "$ref": "#/$defs/stableId"
        },
        "artifact_ref": {
          "$ref": "#/$defs/stableId"
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:;.*)?$"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "source_relation": {
          "type": "string",
          "enum": [
            "exact_bounded_copy",
            "redacted_derivative",
            "translated_derivative",
            "transcoded_derivative",
            "summarized_derivative",
            "composite_derivative"
          ]
        },
        "minimum_necessary_confirmed": {
          "type": "boolean",
          "const": true
        },
        "context_preserved": {
          "type": "boolean",
          "const": true
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        },
        "transformations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/transformation"
          }
        },
        "context_note_refs": {
          "$ref": "#/$defs/optionalRefs"
        },
        "access_control_refs": {
          "$ref": "#/$defs/optionalRefs"
        },
        "retention_policy_ref": {
          "$ref": "#/$defs/stableId"
        },
        "representation_is_source_authority": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "named",
            "collective",
            "anonymous",
            "protected_identity",
            "prohibited",
            "not_required"
          ]
        },
        "display_text": {
          "$ref": "#/$defs/shortText"
        },
        "identity_refs": {
          "$ref": "#/$defs/optionalRefs"
        },
        "attribution_policy_ref": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transformation_id",
        "transformation_class",
        "authority_ref",
        "performed_by",
        "result_ref"
      ],
      "properties": {
        "transformation_id": {
          "$ref": "#/$defs/stableId"
        },
        "transformation_class": {
          "type": "string",
          "enum": [
            "redaction",
            "pseudonymization",
            "translation",
            "transcoding",
            "resizing",
            "format_conversion",
            "summarization",
            "composition",
            "context_attachment"
          ]
        },
        "authority_ref": {
          "$ref": "#/$defs/stableId"
        },
        "performed_by": {
          "$ref": "#/$defs/stableId"
        },
        "result_ref": {
          "$ref": "#/$defs/stableId"
        },
        "external_service_used": {
          "type": "boolean"
        },
        "integration_manifest_ref": {
          "$ref": "#/$defs/stableId"
        },
        "accepted_by_component_ref": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_verification_ref",
        "authorization_ref",
        "consent_refs",
        "cultural_rights_policy_refs",
        "governance_policy_refs",
        "trust_refs"
      ],
      "properties": {
        "identity_verification_ref": {
          "$ref": "#/$defs/stableId"
        },
        "authorization_ref": {
          "$ref": "#/$defs/stableId"
        },
        "delegation_refs": {
          "$ref": "#/$defs/optionalRefs"
        },
        "consent_refs": {
          "$ref": "#/$defs/nonEmptyRefs"
        },
        "cultural_rights_policy_refs": {
          "$ref": "#/$defs/nonEmptyRefs"
        },
        "governance_policy_refs": {
          "$ref": "#/$defs/nonEmptyRefs"
        },
        "trust_refs": {
          "$ref": "#/$defs/nonEmptyRefs"
        },
        "human_approval_refs": {
          "$ref": "#/$defs/optionalRefs"
        },
        "exception_refs": {
          "$ref": "#/$defs/optionalRefs"
        },
        "authority_validated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "executionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "result",
        "started_at",
        "completed_at",
        "attempt_count",
        "delivery_semantics",
        "retry_revalidation_performed"
      ],
      "properties": {
        "execution_id": {
          "$ref": "#/$defs/stableId"
        },
        "result": {
          "type": "string",
          "enum": [
            "published",
            "partially_delivered",
            "failed",
            "cancelled"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "delivery_semantics": {
          "type": "string",
          "enum": [
            "single_local_commit",
            "at_least_once_transport_exactly_once_effect",
            "at_least_once_with_destination_deduplication"
          ]
        },
        "retry_revalidation_performed": {
          "type": "boolean"
        },
        "destination_acknowledgement": {
          "$ref": "#/$defs/destinationAcknowledgement"
        },
        "partial_delivery": {
          "$ref": "#/$defs/partialDelivery"
        },
        "failure": {
          "$ref": "#/$defs/failure"
        },
        "cancellation": {
          "$ref": "#/$defs/cancellation"
        },
        "delivery_receipt_refs": {
          "$ref": "#/$defs/optionalRefs"
        },
        "network_state": {
          "type": "string",
          "enum": [
            "local",
            "online",
            "reconnected_after_queue"
          ]
        }
      }
    },
    "destinationAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "acknowledged_at",
        "acknowledgement_ref"
      ],
