{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/experience-view-adapter.schema.json",
  "title": "kOA Experience View Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_class",
    "adapter_id",
    "version",
    "experience_id",
    "owner_module_id",
    "routes",
    "data_sources",
    "authority_boundary",
    "resilience",
    "observability"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "artifact_class": {
      "const": "experience_view_adapter"
    },
    "example": {
      "type": "boolean"
    },
    "authority": {
      "type": "string"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "experience_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_module_id": {
      "type": "string",
      "minLength": 1
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "path",
          "response_contract_ref"
        ],
        "properties": {
          "route_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "response_contract_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "data_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_id",
          "interface_ref",
          "access_mode",
          "authorization_rechecked_by_owner"
        ],
        "properties": {
          "owner_id": {
            "type": "string",
            "minLength": 1
          },
          "interface_ref": {
            "type": "string",
            "minLength": 1
          },
          "access_mode": {
            "enum": [
              "query",
              "delegated_command"
            ]
          },
          "authorization_rechecked_by_owner": {
            "const": true
          }
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presentation_only",
        "business_logic_owned",
        "authoritative_storage",
        "direct_database_writes",
        "cross_owner_transaction_logic"
      ],
      "properties": {
        "presentation_only": {
          "const": true
        },
        "business_logic_owned": {
          "const": false
        },
        "authoritative_storage": {
          "const": false
        },
        "direct_database_writes": {
          "const": false
        },
        "cross_owner_transaction_logic": {
          "const": false
        }
      }
    },
    "resilience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounded_parallel_fanout",
        "dependency_policy_refs"
      ],
      "properties": {
        "bounded_parallel_fanout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "dependency_policy_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cache_policy_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation_id_required",
        "per_dependency_latency"
      ],
      "properties": {
        "correlation_id_required": {
          "const": true
        },
        "per_dependency_latency": {
          "const": true
        }
      }
    }
  }
}
