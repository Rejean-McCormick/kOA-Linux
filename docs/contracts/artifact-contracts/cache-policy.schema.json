{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/cache-policy.schema.json",
  "title": "kOA Cache Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_class",
    "policy_id",
    "version",
    "owner_component_id",
    "source_of_truth_ref",
    "mode",
    "key_scope",
    "ttl",
    "invalidation",
    "staleness",
    "negative_cache",
    "stampede_protection",
    "security",
    "failure_behavior",
    "observability"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "artifact_class": {
      "const": "cache_policy"
    },
    "example": {
      "type": "boolean"
    },
    "authority": {
      "type": "string"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "owner_component_id": {
      "type": "string",
      "minLength": 1
    },
    "source_of_truth_ref": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "cache_aside"
    },
    "key_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includes_tenant",
        "includes_authority_domain",
        "includes_object_version"
      ],
      "properties": {
        "includes_tenant": {
          "const": true
        },
        "includes_authority_domain": {
          "const": true
        },
        "includes_object_version": {
          "type": "boolean"
        }
      }
    },
    "ttl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_seconds",
        "jitter_percent",
        "unbounded_prohibited"
      ],
      "properties": {
        "maximum_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "jitter_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "unbounded_prohibited": {
          "const": true
        }
      }
    },
    "invalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_write_before_invalidation",
        "events",
        "failure_action"
      ],
      "properties": {
        "owner_write_before_invalidation": {
          "const": true
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_action": {
          "enum": [
            "serve_labeled_stale_within_bound",
            "bypass_cache",
            "capability_unavailable"
          ]
        }
      }
    },
    "staleness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_seconds",
        "label_required"
      ],
      "properties": {
        "maximum_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "label_required": {
          "const": true
        }
      }
    },
    "negative_cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maximum_ttl_seconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maximum_ttl_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stampede_protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "single_flight",
            "distributed_lock_with_timeout",
            "probabilistic_early_refresh"
          ]
        },
        "lock_timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_results_cached",
        "cross_tenant_sharing",
        "sensitive_value_encryption"
      ],
      "properties": {
        "authorization_results_cached": {
          "type": "boolean"
        },
        "cross_tenant_sharing": {
          "const": false
        },
        "sensitive_value_encryption": {
          "type": "boolean"
        }
      }
    },
    "failure_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "empty_cache_safe",
        "cache_unavailable_action"
      ],
      "properties": {
        "empty_cache_safe": {
          "const": true
        },
        "cache_unavailable_action": {
          "enum": [
            "read_owner",
            "capability_unavailable"
          ]
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hit_ratio",
        "miss_ratio",
        "evictions",
        "stale_serves",
        "invalidation_failures"
      ],
      "properties": {
        "hit_ratio": {
          "const": true
        },
        "miss_ratio": {
          "const": true
        },
        "evictions": {
          "const": true
        },
        "stale_serves": {
          "const": true
        },
        "invalidation_failures": {
          "const": true
        }
      }
    }
  }
}
