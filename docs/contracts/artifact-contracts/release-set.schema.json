{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/release-set.schema.json",
  "title": "kOA Release Set",
  "description": "Contract for a signed Release Set that binds exactly one tested-compatible release identity from each canonical kOA release channel: system, services, governance, and knowledge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "release_set_id",
    "version",
    "lifecycle_status",
    "language",
    "issued_at",
    "issuer",
    "authority",
    "channels",
    "compatibility",
    "activation",
    "signature",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "release-set.schema.json",
      "description": "Optional local schema filename used by serialized instances."
    },
    "artifact_class": {
      "type": "string",
      "const": "release_set"
    },
    "release_set_id": {
      "$ref": "#/$defs/stableId",
      "description": "Stable identity of this Release Set artifact."
    },
    "version": {
      "$ref": "#/$defs/semanticVersion",
      "description": "Version of this Release Set artifact, independent from channel versions."
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "candidate",
        "validated",
        "active",
        "superseded",
        "revoked",
        "rejected"
      ]
    },
    "language": {
      "type": "string",
      "const": "en"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "$ref": "#/$defs/issuer"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "target_scope": {
      "$ref": "#/$defs/targetScope"
    },
    "channels": {
      "$ref": "#/$defs/channelSet"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "activation": {
      "$ref": "#/$defs/activation"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "uniqueItems": true,
      "maxItems": 20
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "active"
          }
        },
        "required": [
          "lifecycle_status"
        ]
      },
      "then": {
        "required": [
          "effective_at",
          "target_scope"
        ],
        "properties": {
          "compatibility": {
            "properties": {
              "status": {
                "const": "tested_compatible"
              }
            },
            "required": [
              "status"
            ]
          },
          "activation": {
            "properties": {
              "eligibility": {
                "const": "eligible"
              }
            },
            "required": [
              "eligibility"
            ]
          },
          "signature": {
            "properties": {
              "verification_status": {
                "const": "verified"
              }
            },
            "required": [
              "verification_status"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "enum": [
              "superseded",
              "revoked"
            ]
          }
        },
        "required": [
          "lifecycle_status"
        ]
      },
      "then": {
        "required": [
          "lineage"
        ]
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 160
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "maxLength": 128
    },
    "contractRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?:[a-z][a-z0-9+.-]*:|[A-Za-z0-9_.-]+/|[A-Za-z0-9_.-]+$).+$"
    },
    "nonEmptyRefArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contractRef"
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 200
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_id",
        "issuer_type",
        "authority_ref"
      ],
      "properties": {
        "issuer_id": {
          "$ref": "#/$defs/stableId"
        },
        "issuer_type": {
          "type": "string",
          "enum": [
            "release_authority",
            "organization",
            "institution",
            "community_authority",
            "delegated_service"
          ]
        },
        "authority_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "delegation_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "contact_ref": {
          "$ref": "#/$defs/contractRef"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_authority_ref",
        "approval_refs",
        "decision_refs"
      ],
      "properties": {
        "release_authority_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "approval_refs": {
          "$ref": "#/$defs/nonEmptyRefArray"
        },
        "decision_refs": {
          "$ref": "#/$defs/nonEmptyRefArray"
        },
        "exception_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contractRef"
          },
          "uniqueItems": true,
          "maxItems": 50,
          "default": []
        },
        "revocation_status_ref": {
          "$ref": "#/$defs/contractRef"
        }
      }
    },
    "targetScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_results"
      ],
      "properties": {
        "deployment_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true,
          "maxItems": 1000
        },
        "profile_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profileResult"
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 100
        },
        "overlay_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true,
          "maxItems": 50
        },
        "environment_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "maxLength": 100
          },
          "uniqueItems": true,
          "maxItems": 100
        }
      }
    },
    "profileResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_contract_ref",
        "result",
        "evidence_refs"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/stableId"
        },
        "profile_contract_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "profile_version_constraint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonEmptyRefArray"
        }
      }
    },
    "channelSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "services",
        "governance",
        "knowledge"
      ],
      "properties": {
        "system": {
          "allOf": [
            {
              "$ref": "#/$defs/channelRelease"
            },
            {
              "properties": {
                "channel_id": {
                  "const": "system"
                },
                "release_namespace": {
                  "const": "koa.system"
                }
              }
            }
          ]
        },
        "services": {
          "allOf": [
            {
              "$ref": "#/$defs/channelRelease"
            },
            {
              "properties": {
                "channel_id": {
                  "const": "services"
                },
                "release_namespace": {
                  "const": "koa.services"
                }
              }
            }
          ]
        },
        "governance": {
          "allOf": [
            {
              "$ref": "#/$defs/channelRelease"
            },
            {
              "properties": {
                "channel_id": {
                  "const": "governance"
                },
                "release_namespace": {
                  "const": "koa.governance"
                }
              }
            }
          ]
        },
        "knowledge": {
          "allOf": [
            {
              "$ref": "#/$defs/channelRelease"
            },
            {
              "properties": {
                "channel_id": {
                  "const": "knowledge"
                },
                "release_namespace": {
                  "const": "koa.knowledge"
                }
              }
            }
          ]
        }
      }
    },
    "channelRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "release_namespace",
        "release_id",
        "version",
        "release_manifest_ref",
        "artifact_refs",
        "provenance_ref",
        "validation_evidence_refs",
        "recovery"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "enum": [
            "system",
            "services",
            "governance",
            "knowledge"
          ]
        },
        "release_namespace": {
          "type": "string",
          "enum": [
            "koa.system",
            "koa.services",
            "koa.governance",
            "koa.knowledge"
          ]
        },
        "release_id": {
          "$ref": "#/$defs/stableId"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "release_manifest_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "artifact_refs": {
          "$ref": "#/$defs/nonEmptyRefArray"
        },
        "provenance_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "validation_evidence_refs": {
          "$ref": "#/$defs/nonEmptyRefArray"
        },
        "interface_versions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxProperties": 200
        },
        "schema_versions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxProperties": 200
        },
        "recovery": {
          "$ref": "#/$defs/recoveryDeclaration"
        }
      }
    },
    "recoveryDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "procedure_ref"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "rollback",
            "forward_repair",
            "rollback_or_forward_repair"
          ]
        },
        "procedure_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "previous_compatible_release_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "forward_repair_artifact_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "rollback_boundary_ref": {
          "$ref": "#/$defs/contractRef"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "forward_repair"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "forward_repair_artifact_ref"
            ]
          }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evaluated_at",
        "evaluator_ref",
        "constraint_results",
        "test_evidence_refs"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_evaluated",
            "tested_compatible",
            "incompatible",
            "blocked"
          ]
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "evaluator_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "constraint_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraintResult"
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 1000
        },
        "test_evidence_refs": {
          "$ref": "#/$defs/nonEmptyRefArray"
        },
        "compatibility_matrix_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "known_limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uniqueItems": true,
          "maxItems": 100
        }
      }
    },
    "constraintResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "kind",
        "subject_ref",
        "operator",
        "expected",
        "actual",
        "result",
        "evidence_refs"
      ],
      "properties": {
        "constraint_id": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "channel_release_identity",
            "artifact_class",
            "component_contract",
            "deployment_profile",
            "runtime_interface",
            "schema_version",
            "minimum_supported_version",
            "maximum_supported_version",
            "prohibited_version"
          ]
        },
        "subject_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "operator": {
          "type": "string",
          "enum": [
            "equals",
            "not_equals",
            "semver_satisfies",
            "compatible_with",
            "supports",
            "prohibits"
          ]
        },
        "expected": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "minItems": 1,
              "uniqueItems": true,
              "maxItems": 100
            }
          ]
        },
        "actual": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "minItems": 1,
              "uniqueItems": true,
              "maxItems": 100
            }
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonEmptyRefArray"
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligibility",
        "strategy",
        "partial_activation_allowed",
        "activation_evidence_refs",
        "failure_result"
      ],
      "properties": {
        "eligibility": {
          "type": "string",
          "enum": [
            "not_evaluated",
            "eligible",
            "blocked"
          ]
        },
        "strategy": {
          "type": "string",
          "enum": [
            "atomic_set_switch",
            "transactional_set_activation",
            "coordinated_staged_activation"
          ]
        },
        "partial_activation_allowed": {
          "type": "boolean",
          "const": false
        },
        "activation_evidence_refs": {
          "$ref": "#/$defs/nonEmptyRefArray"
        },
        "health_policy_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "observation_window": {
          "type": "string",
          "pattern": "^P(?!$)(?:\\d+Y)?(?:\\d+M)?(?:\\d+D)?(?:T(?=\\d)(?:\\d+H)?(?:\\d+M)?(?:\\d+(?:\\.\\d+)?S)?)?$"
        },
        "failure_result": {
          "type": "string",
          "enum": [
            "retain_current_active_set",
            "rollback_to_previous_compatible_set",
            "enter_declared_forward_repair",
            "enter_recovery"
          ]
        },
        "previous_good_release_set_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "forward_repair_ref": {
          "$ref": "#/$defs/contractRef"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature_artifact_ref",
        "signer_identity_ref",
        "signing_authority_ref",
        "signed_at",
        "verification_status",
        "verification_evidence_refs"
      ],
      "properties": {
        "signature_artifact_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "signer_identity_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "signing_authority_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "unverified",
            "verified",
            "invalid",
            "revoked"
          ]
        },
        "verification_evidence_refs": {
          "$ref": "#/$defs/nonEmptyRefArray"
        },
        "trust_policy_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "revocation_status_ref": {
          "$ref": "#/$defs/contractRef"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_receipt_ref",
        "release_channels_registry_ref",
        "artifact_classes_registry_ref",
        "generator_id",
        "generator_version",
        "source_release_refs"
      ],
      "properties": {
        "provenance_receipt_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "release_channels_registry_ref": {
          "type": "string",
          "const": "contracts/release-channels.contract.json"
        },
        "artifact_classes_registry_ref": {
          "type": "string",
          "const": "contracts/artifact-classes.contract.json"
        },
        "generator_id": {
          "$ref": "#/$defs/stableId"
        },
        "generator_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "source_release_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contractRef"
          },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "build_environment_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "sbom_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contractRef"
          },
          "uniqueItems": true,
          "maxItems": 200
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supersedes_release_set_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "superseded_by_release_set_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "previous_good_release_set_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "revocation_record_ref": {
          "$ref": "#/$defs/contractRef"
        },
        "replacement_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "minProperties": 1
    }
  },
  "examples": [
    {
      "$schema": "release-set.schema.json",
      "artifact_class": "release_set",
      "release_set_id": "koa.release-set.2026.08.03.1",
      "version": "1.0.0",
      "lifecycle_status": "active",
      "language": "en",
      "issued_at": "2026-08-03T17:45:00-04:00",
      "effective_at": "2026-08-03T18:00:00-04:00",
      "issuer": {
        "issuer_id": "koa.release-authority",
        "issuer_type": "release_authority",
        "authority_ref": "authority/release-authority/2026-08"
      },
      "authority": {
        "release_authority_ref": "authority/release-authority/2026-08",
        "approval_refs": [
          "approvals/release-set/2026.08.03.1"
        ],
        "decision_refs": [
          "decisions/DEC-REL-001"
        ]
      },
      "target_scope": {
        "profile_results": [
          {
            "profile_id": "sovereign_hub",
            "profile_contract_ref": "contracts/profiles/sovereign-hub.profile.json",
            "result": "pass",
            "evidence_refs": [
              "evidence/profile/sovereign-hub/2026.08.03.1"
            ]
          }
        ]
      },
      "channels": {
        "system": {
          "channel_id": "system",
          "release_namespace": "koa.system",
          "release_id": "koa.system.2026.08.1",
          "version": "2026.8.1",
          "release_manifest_ref": "releases/system/2026.8.1/manifest",
          "artifact_refs": [
            "artifacts/system-image/2026.8.1"
          ],
          "provenance_ref": "provenance/system/2026.8.1",
          "validation_evidence_refs": [
            "evidence/system/2026.8.1"
          ],
          "recovery": {
            "mode": "rollback_or_forward_repair",
            "procedure_ref": "recovery/system/2026.8.1"
          }
        },
        "services": {
          "channel_id": "services",
          "release_namespace": "koa.services",
          "release_id": "koa.services.2026.08.4",
          "version": "2026.8.4",
          "release_manifest_ref": "releases/services/2026.8.4/manifest",
          "artifact_refs": [
            "artifacts/service-release/2026.8.4"
          ],
          "provenance_ref": "provenance/services/2026.8.4",
          "validation_evidence_refs": [
            "evidence/services/2026.8.4"
          ],
          "recovery": {
            "mode": "rollback_or_forward_repair",
            "procedure_ref": "recovery/services/2026.8.4"
