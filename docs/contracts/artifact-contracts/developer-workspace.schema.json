{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/developer-workspace.schema.json",
  "title": "kOA Developer Workspace Manifest",
  "description": "Validates the canonical artifact describing one isolated kOA developer workspace, including source identity, active profile, UV toolchain, application instances, mutable resource namespaces, ports, component data boundaries, artifacts, evidence, offline behavior, lifecycle, and safe cleanup.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "artifact_class",
    "workspace_id",
    "status",
    "language",
    "created_at",
    "updated_at",
    "owner",
    "profile",
    "source",
    "toolchain",
    "filesystem",
    "namespaces",
    "application_instances",
    "port_allocations",
    "data_services",
    "test_runs",
    "candidate_artifacts",
    "evidence",
    "secrets",
    "ai_boundary",
    "offline_behavior",
    "lifecycle",
    "validation"
  ],
  "properties": {
    "$schema": {
      "const": "../artifact-contracts/developer-workspace.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_class": {
      "const": "developer_workspace"
    },
    "workspace_id": {
      "$ref": "#/$defs/workspaceId"
    },
    "status": {
      "enum": [
        "provisioning",
        "active",
        "degraded",
        "blocked",
        "retiring",
        "retired"
      ]
    },
    "language": {
      "const": "en"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "$ref": "#/$defs/workspaceOwner"
    },
    "profile": {
      "$ref": "#/$defs/profileBinding"
    },
    "source": {
      "$ref": "#/$defs/sourceContext"
    },
    "toolchain": {
      "$ref": "#/$defs/toolchainContext"
    },
    "filesystem": {
      "$ref": "#/$defs/filesystemContext"
    },
    "namespaces": {
      "$ref": "#/$defs/namespaceContext"
    },
    "application_instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/applicationInstance"
      },
      "uniqueItems": true
    },
    "port_allocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/portAllocation"
      },
      "uniqueItems": true
    },
    "data_services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataService"
      },
      "uniqueItems": true
    },
    "external_sandboxes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/externalSandbox"
      },
      "uniqueItems": true,
      "default": []
    },
    "test_runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/testRun"
      },
      "uniqueItems": true
    },
    "candidate_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidateArtifact"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceRecord"
      },
      "uniqueItems": true
    },
    "secrets": {
      "$ref": "#/$defs/secretPolicy"
    },
    "ai_boundary": {
      "$ref": "#/$defs/aiBoundary"
    },
    "offline_behavior": {
      "$ref": "#/$defs/offlineBehavior"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "properties": {
              "profile_id": {
                "const": "developer_linux_workstation"
              }
            },
            "required": [
              "profile_id"
            ]
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "properties": {
              "profile_ref": {
                "const": "../profiles/developer-linux-workstation.profile.json"
              }
            }
          },
          "filesystem": {
            "properties": {
              "workspace_filesystem": {
                "const": "linux_filesystem"
              },
              "windows_mount_role": {
                "const": "not_applicable"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "properties": {
              "profile_id": {
                "const": "developer_windows_wsl"
              }
            },
            "required": [
              "profile_id"
            ]
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "properties": {
              "profile_ref": {
                "const": "../profiles/developer-windows-wsl.profile.json"
              }
            }
          },
          "filesystem": {
            "properties": {
              "workspace_filesystem": {
                "const": "wsl_linux_filesystem"
              },
              "windows_mount_role": {
                "const": "controlled_import_export_only"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "result": {
                "const": "pass"
              }
            }
          },
          "lifecycle": {
            "properties": {
              "cleanup_status": {
                "enum": [
                  "not_started",
                  "planned"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "result": {
                "const": "blocked"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "retired"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lifecycle": {
            "properties": {
              "cleanup_status": {
                "const": "completed"
              },
              "retired_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "retired_at"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "cleanText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*(?:[Tt][Bb][Dd]|[Tt][Oo]\\s+[Dd][Ee][Cc][Ii][Dd][Ee]|[Uu][Nn][Rr][Ee][Ss][Oo][Ll][Vv][Ee][Dd]|[Ff][Ii][Xx][Mm][Ee]|[Xx][Xx][Xx]))[\\s\\S]+$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "canonicalReference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:\\\\)[A-Za-z0-9._/-]+(?:#(?:/[^#\\s]*)?)?$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^WS-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "applicationInstanceId": {
      "type": "string",
      "pattern": "^APPINST-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^REPO-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "resourceName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"
    },
    "posixPath": {
      "type": "string",
      "pattern": "^(?:/|~/)[^\\u0000\\r\\n]+$"
    },
    "integrityRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest",
        "purpose"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256",
            "sha384",
            "sha512",
            "blake3"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64,128}$"
        },
        "purpose": {
          "enum": [
            "dependency_lock_identity",
            "candidate_artifact_integrity",
            "immutable_cache_identity",
            "transfer_integrity"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha256"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "digest": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha384"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "digest": {
                "pattern": "^[0-9a-f]{96}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha512"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "digest": {
                "pattern": "^[0-9a-f]{128}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "blake3"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "digest": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "workspaceOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_ref",
        "ownership_scope",
        "cleanup_authority_ref"
      ],
      "properties": {
        "subject_ref": {
          "$ref": "#/$defs/canonicalReference"
        },
        "ownership_scope": {
          "const": "development_workspace"
        },
        "cleanup_authority_ref": {
          "$ref": "#/$defs/canonicalReference"
        }
      }
    },
    "profileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_ref",
        "profile_version",
        "conformance_claim"
      ],
      "properties": {
        "profile_id": {
          "enum": [
            "developer_linux_workstation",
            "developer_windows_wsl"
          ]
        },
        "profile_ref": {
          "$ref": "#/$defs/canonicalReference"
        },
        "profile_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "conformance_claim": {
          "const": "development_profile"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "role",
        "workspace_path",
        "source_revision",
        "revision_kind",
        "dirty_state"
      ],
      "properties": {
        "repository_id": {
          "$ref": "#/$defs/repositoryId"
        },
        "role": {
          "enum": [
            "primary",
            "dependency",
            "contracts",
            "fixtures"
          ]
        },
        "workspace_path": {
          "type": "string",
          "pattern": "^(?:\\.|[A-Za-z0-9._-][A-Za-z0-9._/-]*)$"
        },
        "source_revision": {
          "$ref": "#/$defs/sourceRevision"
        },
        "revision_kind": {
          "const": "git_commit"
        },
        "branch_or_change_ref": {
          "$ref": "#/$defs/cleanText"
        },
        "remote_ref": {
          "$ref": "#/$defs/cleanText"
        },
        "dirty_state": {
          "enum": [
            "clean",
            "modified",
            "staged",
            "mixed"
          ]
        }
      }
    },
    "sourceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_root",
        "repositories",
        "primary_repository_ref",
        "canonical_contract_source_ref"
      ],
      "properties": {
        "workspace_root": {
          "$ref": "#/$defs/posixPath"
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repository"
          },
          "uniqueItems": true,
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "primary"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        "primary_repository_ref": {
          "$ref": "#/$defs/repositoryId"
        },
        "canonical_contract_source_ref": {
          "$ref": "#/$defs/repositoryId"
        },
        "change_ref": {
          "$ref": "#/$defs/cleanText"
        }
      }
    },
    "toolchainContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolchain_ref",
        "python_version",
        "uv_version",
        "package_manager",
        "project_file",
        "lock_file",
        "lock_integrity",
        "virtual_environment_path",
        "sync_command",
        "execution_prefix",
        "direct_pip_install_allowed",
        "global_mutable_environment_allowed",
        "system_python_mutation_allowed"
      ],
      "properties": {
        "toolchain_ref": {
          "const": "../toolchains/python-uv.toolchain.json"
        },
        "python_version": {
          "type": "string",
          "pattern": "^3\\.(?:1[2-9]|[2-9][0-9])(?:\\.[0-9]+)?$"
        },
        "uv_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "package_manager": {
          "const": "uv"
        },
        "project_file": {
          "const": "pyproject.toml"
        },
        "lock_file": {
          "const": "uv.lock"
        },
        "lock_integrity": {
          "$ref": "#/$defs/integrityRecord"
        },
        "virtual_environment_path": {
          "const": ".venv"
        },
        "sync_command": {
          "const": "uv sync --frozen"
        },
        "execution_prefix": {
          "const": "uv run"
        },
        "direct_pip_install_allowed": {
          "const": false
        },
        "global_mutable_environment_allowed": {
          "const": false
        },
        "system_python_mutation_allowed": {
          "const": false
        },
        "dependency_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceName"
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "filesystemContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_filesystem",
        "mutable_state_root",
        "generated_root",
        "runtime_root",
        "artifact_root",
        "evidence_root",
        "cache_root",
        "temporary_root",
        "windows_mount_role",
        "shared_mutable_state_allowed"
      ],
      "properties": {
        "workspace_filesystem": {
          "enum": [
            "linux_filesystem",
            "wsl_linux_filesystem"
          ]
        },
        "mutable_state_root": {
          "$ref": "#/$defs/posixPath"
        },
        "generated_root": {
          "$ref": "#/$defs/posixPath"
        },
        "runtime_root": {
          "$ref": "#/$defs/posixPath"
        },
        "artifact_root": {
          "$ref": "#/$defs/posixPath"
        },
        "evidence_root": {
          "$ref": "#/$defs/posixPath"
        },
        "cache_root": {
          "$ref": "#/$defs/posixPath"
        },
        "temporary_root": {
          "$ref": "#/$defs/posixPath"
        },
        "windows_mount_role": {
          "enum": [
            "not_applicable",
            "controlled_import_export_only"
          ]
        },
        "shared_mutable_state_allowed": {
          "const": false
        }
      }
    },
    "namespaceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_project",
        "network",
        "volume_prefix",
        "database_prefix",
        "schema_prefix",
        "queue_prefix",
        "topic_prefix",
        "consumer_group_prefix",
        "index_prefix",
        "cache_prefix",
        "object_prefix",
        "scheduler_prefix",
        "process_prefix"
      ],
      "properties": {
        "container_project": {
          "$ref": "#/$defs/resourceName"
        },
        "network": {
          "$ref": "#/$defs/resourceName"
        },
        "volume_prefix": {
          "$ref": "#/$defs/resourceName"
        },
        "database_prefix": {
          "$ref": "#/$defs/resourceName"
        },
        "schema_prefix": {
          "$ref": "#/$defs/resourceName"
        },
        "queue_prefix": {
          "$ref": "#/$defs/resourceName"
        },
        "topic_prefix": {
          "$ref": "#/$defs/resourceName"
        },
        "consumer_group_prefix": {
          "$ref": "#/$defs/resourceName"
        },
        "index_prefix": {
          "$ref": "#/$defs/resourceName"
        },
        "cache_prefix": {
          "$ref": "#/$defs/resourceName"
        },
        "object_prefix": {
          "$ref": "#/$defs/resourceName"
        },
        "scheduler_prefix": {
          "$ref": "#/$defs/resourceName"
        },
        "process_prefix": {
          "$ref": "#/$defs/resourceName"
        }
      }
    },
    "applicationInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_instance_id",
        "component_ref",
        "source_repository_ref",
        "source_revision",
        "activation_mode",
        "status",
        "execution_kind",
        "process_or_container_ref",
        "data_service_refs",
        "port_allocation_refs",
        "resource_labels"
      ],
      "properties": {
        "application_instance_id": {
          "$ref": "#/$defs/applicationInstanceId"
        },
        "component_ref": {
          "$ref": "#/$defs/canonicalReference"
        },
        "source_repository_ref": {
          "$ref": "#/$defs/repositoryId"
        },
        "source_revision": {
          "$ref": "#/$defs/sourceRevision"
        },
        "activation_mode": {
          "enum": [
            "always_on",
            "session_activated",
            "task_activated",
            "test_activated",
            "manual"
          ]
        },
        "status": {
          "enum": [
            "stopped",
            "starting",
            "running",
            "degraded",
            "blocked",
            "stopping",
            "failed"
          ]
        },
        "execution_kind": {
          "enum": [
            "native_process",
            "rootless_container",
            "approved_wsl_container_backend"
          ]
        },
        "process_or_container_ref": {
          "$ref": "#/$defs/resourceName"
        },
        "data_service_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceName"
          },
          "uniqueItems": true
        },
        "port_allocation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PORT-[A-Z0-9][A-Z0-9_-]{2,63}$"
          },
          "uniqueItems": true
        },
        "active_artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonicalReference"
          },
          "uniqueItems": true,
          "default": []
        },
        "resource_labels": {
          "$ref": "#/$defs/resourceLabels"
        }
      }
    },
    "resourceLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "koa.workspace.id",
        "koa.instance.id",
        "koa.component.id",
        "koa.profile.id",
        "koa.source.revision",
        "koa.created.by"
      ],
      "properties": {
        "koa.workspace.id": {
          "$ref": "#/$defs/workspaceId"
        },
        "koa.instance.id": {
          "$ref": "#/$defs/applicationInstanceId"
        },
        "koa.component.id": {
          "$ref": "#/$defs/resourceName"
        },
        "koa.profile.id": {
          "enum": [
            "developer_linux_workstation",
            "developer_windows_wsl"
          ]
        },
        "koa.source.revision": {
          "$ref": "#/$defs/sourceRevision"
        },
        "koa.created.by": {
          "const": "koa_workspace_manager"
        }
      }
    },
    "portAllocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_id",
        "application_instance_ref",
        "component_ref",
        "interface_id",
        "bind_address",
        "host_port",
        "service_port",
        "protocol",
        "collision_checked",
        "allocated_at"
      ],
      "properties": {
        "allocation_id": {
          "type": "string",
          "pattern": "^PORT-[A-Z0-9][A-Z0-9_-]{2,63}$"
        },
        "application_instance_ref": {
          "$ref": "#/$defs/applicationInstanceId"
        },
        "component_ref": {
          "$ref": "#/$defs/canonicalReference"
        },
        "interface_id": {
          "$ref": "#/$defs/resourceName"
        },
        "bind_address": {
          "enum": [
            "127.0.0.1",
            "::1"
          ]
        },
        "host_port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "service_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "collision_checked": {
          "const": true
        },
        "allocated_at": {
          "type": "string",
          "format": "date-time"
        },
        "released_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "dataService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_service_id",
        "service_class",
        "component_ref",
        "logical_boundary_kind",
        "logical_boundary_name",
        "physical_service_ref",
        "access_identity_ref",
        "migration_set_ref",
        "authoritative_test_state",
