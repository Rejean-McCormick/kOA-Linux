{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/uckk-import-receipt.schema.json",
  "title": "UCKK Import Receipt",
  "description": "Receipt for retrieval, quarantine, validation, acceptance, rejection, or update-candidate handling of an UCKK learning package by kOA-Linux.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "package_id",
    "occurred_at",
    "source",
    "destination",
    "outcome",
    "validation",
    "authority_separation_preserved"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^uckk_import_receipt_[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "package_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "endpoint_id"
      ],
      "properties": {
        "system_id": {
          "const": "uckk"
        },
        "endpoint_id": {
          "type": "string"
        },
        "source_object_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_version_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "component_id",
        "authority_domain_id"
      ],
      "properties": {
        "system_id": {
          "const": "koa-linux"
        },
        "component_id": {
          "const": "koa_mediatheque"
        },
        "authority_domain_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outcome": {
      "enum": [
        "retrieved",
        "quarantined",
        "accepted",
        "partially_accepted",
        "rejected",
        "cancelled",
        "update_candidate",
        "failed"
      ]
    },
    "authority_separation_preserved": {
      "const": true
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_complete",
        "integrity_verified",
        "source_verified",
        "license_resolved",
        "frame_compatible",
        "provenance_preserved"
      ],
      "properties": {
        "manifest_complete": {
          "type": "boolean"
        },
        "integrity_verified": {
          "type": "boolean"
        },
        "signature_verified": {
          "type": "boolean"
        },
        "source_verified": {
          "type": "boolean"
        },
        "license_resolved": {
          "type": "boolean"
        },
        "offline_use_allowed": {
          "type": "boolean"
        },
        "frame_compatible": {
          "type": "boolean"
        },
        "provenance_preserved": {
          "type": "boolean"
        },
        "malware_scan_outcome": {
          "enum": [
            "pass",
            "fail",
            "not_applicable",
            "unavailable_blocked"
          ]
        },
        "review_required": {
          "type": "boolean"
        },
        "failure_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted_by_ref": {
          "type": "string"
        },
        "decision_ref": {
          "type": "string"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "local_record_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "local_version_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "offline_runtime_ref": {
          "type": "string"
        }
      }
    },
    "update_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automatic_remote_overwrite": {
          "const": false
        },
        "remote_version_ref": {
          "type": "string"
        },
        "local_decision_required": {
          "const": true
        },
        "conflict_state": {
          "enum": [
            "none",
            "local_changes_present",
            "rights_changed",
            "source_withdrawn",
            "unknown"
          ]
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
