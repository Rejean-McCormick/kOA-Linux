{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/kristal-artifact.schema.json",
  "title": "Kristal Artifact",
  "description": "Portable epistemic artifact accepted by Kristal Runtime. It preserves stable identity, version, provenance, rights, declared audience, query-contract compatibility, and integrity without carrying deployment or policy authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_version",
    "artifact_class",
    "content_identity",
    "manifest",
    "provenance",
    "rights",
    "compatibility"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^kristal-artifact\\.[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "artifact_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_class": {
      "const": "kristal_artifact"
    },
    "content_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": true
          }
        },
        "query_contract_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_refs",
        "producer"
      ],
      "properties": {
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "build_receipt_ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "rights": {
      "type": "object",
      "required": [
        "license"
      ],
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "required": [
        "kristal_runtime"
      ],
      "properties": {
        "kristal_runtime": {
          "type": "string",
          "minLength": 1
        },
        "schema_versions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "profile_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "metadata": {
      "type": "object"
    }
  }
}
