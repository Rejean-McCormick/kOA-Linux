  "operating_modes": [
    {
      "mode_id": "interactive_user",
      "purpose": "Operate the local user-facing kOA environment with deterministic core services and task-activated heavy work.",
      "profile_selection_ref": "generated/profile-catalog.json#/primary_profiles",
      "connectivity_support": [
        "online",
        "restricted_network",
        "offline"
      ],
      "core_characteristics": [
        "local_authority",
        "non_ai_navigation",
        "compiled_language_artifact_consumption",
        "deterministic_media_pipeline",
        "bounded_background_work"
      ]
    },
    {
      "mode_id": "development",
      "purpose": "Develop multiple kOA applications, branches, and worktrees in isolated reproducible workspaces.",
      "profile_selection_ref": "generated/profile-catalog.json#/development_profiles",
      "connectivity_support": [
        "online",
        "restricted_network"
      ],
      "core_characteristics": [
        "workspace_identity",
        "isolated_mutable_dependencies",
        "isolated_service_state",
        "parallel_workspace_execution",
        "explicit_artifact_publication"
      ]
    },
    {
      "mode_id": "build",
      "purpose": "Produce reproducible, validated, provenance-bearing system, service, governance, and knowledge artifacts.",
      "profile_selection_ref": "generated/profile-catalog.json#/build_profiles",
      "connectivity_support": [
        "online",
        "restricted_network",
        "offline_with_imported_sources"
      ],
      "core_characteristics": [
        "clean_workers",
        "reproducible_inputs",
        "artifact_cache",
        "test_evidence",
        "provenance_generation"
      ]
    },
    {
      "mode_id": "service_node",
      "purpose": "Host a persistent kOA node with profile-defined availability, security, recovery, and offline guarantees.",
      "profile_selection_ref": "generated/profile-catalog.json#/node_profiles",
      "connectivity_support": [
        "online",
        "restricted_network",
        "offline"
      ],
      "core_characteristics": [
        "persistent_local_authority",
        "profile_scoped_security",
        "backup_restore",
        "safe_degradation",
        "controlled_updates"
      ]
    },
    {
      "mode_id": "hub",
      "purpose": "Coordinate multiple nodes, artifacts, or governed domains without replacing component or node authority.",
      "profile_selection_ref": "generated/profile-catalog.json#/hub_profiles",
      "connectivity_support": [
        "online",
        "restricted_network",
        "intermittent"
      ],
      "core_characteristics": [
        "federated_coordination",
        "explicit_cross_domain_contracts",
        "bounded_centralization",
        "auditable_distribution"
      ]
    },
    {
      "mode_id": "control_plane",
      "purpose": "Operate deployment, release, policy, and fleet coordination services for profiles that require a control plane.",
      "profile_selection_ref": "generated/profile-catalog.json#/control_profiles",
      "connectivity_support": [
        "online",
        "restricted_network"
      ],
      "core_characteristics": [
        "deployment_coordination",
        "release_coordination",
        "policy_distribution",
        "fleet_observability"
      ]
    },
    {
      "mode_id": "recovery",
      "purpose": "Restore a valid system, artifact set, or authoritative data state without creating partial authority.",
      "profile_selection_ref": "generated/profile-catalog.json#/recovery_capable_profiles",
      "connectivity_support": [
        "online",
        "restricted_network",
        "offline"
      ],
      "core_characteristics": [
        "verified_recovery_input",
        "atomic_restore",
        "rollback_or_forward_repair",
        "evidence_generation"
      ]
    }
  ],
  "connectivity_states": [
    {
      "state_id": "online",
      "description": "Approved remote integrations may be available subject to explicit classification and user or policy authorization."
    },
    {
      "state_id": "restricted_network",
      "description": "Only profile-approved endpoints and protocols are reachable; core local capabilities remain available."
    },
    {
      "state_id": "intermittent",
      "description": "Remote connectivity may disappear and return; queued work remains bounded and idempotent."
    },
    {
      "state_id": "offline",
      "description": "No Internet or remote service is required for the profile's declared offline capability envelope."
    },
    {
      "state_id": "offline_with_imported_sources",
      "description": "Build or update work uses locally imported and verified source or artifact bundles."
    }
  ],
  "global_capabilities": [
    {
      "capability_id": "local_authoritative_operation",
      "availability": "global_contract",
      "description": "Authoritative local operations remain possible within the active profile's offline and security envelope."
    },
    {
      "capability_id": "deterministic_navigation",
      "availability": "profile_activated",
      "description": "Ariane local navigation works without external AI or voice services."
    },
    {
      "capability_id": "governed_knowledge_runtime",
      "availability": "profile_activated",
      "description": "Compiled knowledge and language artifacts are consumed locally without requiring build workbenches."
    },
    {
      "capability_id": "deterministic_media_management",
      "availability": "profile_activated",
      "description": "UCKK ingests, verifies, transforms, stores, exports, backs up, and restores media through deterministic local operations."
    },
    {
      "capability_id": "deterministic_resource_governance",
      "availability": "global_baseline_component",
      "description": "Resource Governor bounds CPU, memory, I/O, concurrency, queues, jobs, and processes."
    },
    {
      "capability_id": "profile_conditioned_policy_governance",
      "availability": "profile_conditioned",
      "description": "Governance Policy Runtime supplies authorization, disclosure, consent, privilege decisions, and governed exceptions where required by a profile."
    },
    {
      "capability_id": "controlled_external_integration",
      "availability": "optional",
      "description": "External services are explicitly classified, removable, capability-scoped, and unable to directly mutate authoritative state."
    },
    {
      "capability_id": "selective_audit_and_recourse",
      "availability": "global_contract",
      "description": "Accountability evidence is produced without requiring indiscriminate disclosure."
    },
    {
      "capability_id": "portability_restore_and_exit",
      "availability": "global_contract",
      "description": "Open interfaces, export, backup, restore, and credible independent exit remain system objectives."
    }
  ],
  "global_boundaries": {
    "baseline_and_profiles": {
      "rule": "The global baseline defines system behavior; profiles select, constrain, strengthen, or implement that behavior for a deployment.",
      "profile_rule_may_become_global_implicitly": false,
      "profile_inheritance_requires_explicit_reference": true
    },
    "components": {
      "component_inventory_ref": "generated/component-catalog.json#/components",
      "component_contract_index_ref": "generated/component-catalog.json",
      "direct_cross_component_authoritative_table_writes": "prohibited",
      "allowed_cross_component_mechanisms": [
        "versioned_api",
        "command",
        "event",
        "gateway",
        "exported_artifact",
        "controlled_read_model"
      ],
      "reading_or_caching_transfers_ownership": false
    },
    "data_authority": {
      "logical_ownership_required": true,
      "physical_consolidation_may_be_profile_scoped": true,
      "shared_database_process_transfers_ownership": false,
      "cross_domain_access_requires": [
        "explicit_contract",
        "authorized_gateway",
        "declared_read_model"
      ]
    },
    "privilege": {
      "ordinary_application_operations_authorized_by": "owning_component",
      "sensitive_host_mutations_require": [
        "applicable_policy_decision",
        "narrow_privileged_operation_path",
        "profile_authorization"
      ],
      "root_or_host_administrator_is_application_governance_interface": false
    },
    "implementation": {
      "systemd_global_requirement": false,
      "quadlet_global_requirement": false,
      "podman_global_requirement": false,
      "docker_global_prohibition": false,
      "wayland_global_requirement": false,
      "gnome_global_prohibition": false,
      "kubernetes_endpoint_requirement": false,
      "profile_may_adopt_specific_implementation": true
    }
  },
