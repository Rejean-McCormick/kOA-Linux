    "optional_integration_removal_breaks_core": false,
    "direct_external_mutation_of_authoritative_state": false,
    "automatic_scope_expansion": false
  },
  "offline_baseline": {
    "core_rule": "Every active profile declares and tests its offline capability envelope.",
    "internet_required_for_global_core_authority": false,
    "offline_capability_classes": [
      "local_read",
      "local_write",
      "local_navigation",
      "local_media_management",
      "local_language_runtime",
      "local_resource_governance",
      "backup_and_restore",
      "verified_offline_import"
    ],
    "external_capability_behavior_offline": "unavailable_without_disabling_unrelated_local_capabilities",
    "queued_remote_work": {
      "allowed": true,
      "requirements": [
        "bounded",
        "idempotent",
        "explicitly_visible",
        "safe_to_retry"
      ]
    }
  },
  "degradation_baseline": {
    "authority_verification_failure": {
      "affected_authoritative_operation": "fail_closed",
      "previously_valid_read_only_or_advisory_state": "permitted_only_when_explicitly_allowed",
      "automatic_bypass": false
    },
    "optional_capability_failure": {
      "failure_scope": "declared_capability_only",
      "unrelated_core_capabilities": "remain_operational",
      "silent_substitution": false
    },
    "resource_pressure": {
      "degradation_order": [
        "defer_background_jobs",
        "reduce_worker_concurrency",
        "stop_task_activated_heavy_services",
        "preserve_authoritative_data_integrity",
        "preserve_core_navigation_and_control"
      ],
      "partial_authoritative_state_allowed": false
    },
    "contract_incompatibility": {
      "affected_transition": "blocked",
      "existing_valid_state": "preserved",
      "automatic_schema_guessing": false
    }
  },
