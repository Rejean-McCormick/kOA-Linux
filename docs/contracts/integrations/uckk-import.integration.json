{
  "$schema": "../../schemas/integration.schema.json",
  "integration_id": "uckk-import",
  "title": "UCKK Import",
  "version": "1.0.0",
  "status": "active",
  "integration_type": "external_moodle_import",
  "role": "Optional governed import of selected online UCKK courses, learning paths, instructions, manuals, and resources into the local kOA Mediatheque for private and offline use.",
  "authority": "non_authoritative",
  "undeclared_substitution": "prohibited",
  "availability": "optional",
  "direction": "inbound_import",
  "external_system": {
    "system_id": "uckk",
    "platform_type": "moodle",
    "inside_koa_linux": false,
    "owns_remote_state": true,
    "owns_local_koa_media": false,
    "online_authority": true,
    "documentation_mount_required": false
  },
  "canonical_refs": [
    "contracts/components/koa-mediatheque.component.json",
    "contracts/components/governance-policy-runtime.component.json",
    "contracts/components/identity-and-trust.component.json",
    "contracts/components/audit-broker.component.json",
    "contracts/artifact-contracts/shared-mediatheque-frame.schema.json",
    "contracts/artifact-contracts/uckk-learning-package.schema.json",
    "contracts/artifact-contracts/uckk-import-receipt.schema.json",
    "contracts/artifact-contracts/offline-bundle.schema.json",
    "04-components/uckk-import-bridge.md",
    "02-system/12-koa-mediatheque-system-boundary.md"
  ],
  "decision_ids": [
    "DEC-UCKK-EXT-001",
    "DEC-MEDIATHEQUE-001",
    "DEC-DATA-001",
    "DEC-GOV-001",
    "DEC-OFFLINE-001",
    "DEC-AUDIT-001"
  ],
  "requirement_ids": [
    "REQ-UCKK-IMPORT-001",
    "REQ-UCKK-IMPORT-002",
    "REQ-UCKK-IMPORT-003",
    "REQ-UCKK-IMPORT-004",
    "REQ-UCKK-IMPORT-005",
    "REQ-UCKK-IMPORT-006",
    "REQ-UCKK-IMPORT-007",
    "REQ-UCKK-IMPORT-008",
    "REQ-UCKK-IMPORT-009",
    "REQ-UCKK-IMPORT-010",
    "REQ-UCKK-IMPORT-011",
    "REQ-UCKK-IMPORT-012"
  ],
  "lock_ids": [
    "LOCK-UCKK-EXT-001",
    "LOCK-UCKK-EXT-002",
    "LOCK-MEDIATHEQUE-001",
    "LOCK-DATA-001",
    "LOCK-GOV-001",
    "LOCK-OFFLINE-001"
  ],
  "boundary": {
    "source_system": "uckk",
    "source_authority": "uckk_mediatheque",
    "transport_and_quarantine_owner": "uckk_import_bridge",
    "destination_system": "koa-linux",
    "destination_component": "koa_mediatheque",
    "local_acceptance_owner": "koa_mediatheque",
    "policy_evaluation_owner": "governance_policy_runtime_when_required",
    "source_authority_preserved": true,
    "local_copy_authority_separate": true,
    "shared_database": false,
    "direct_database_write": false,
    "implicit_bidirectional_sync": false,
    "remote_change_implies_local_overwrite": false
  },
  "import_model": {
    "selection": "explicit course, learning-path, instruction, manual, or resource selection",
    "package_contract_ref": "contracts/artifact-contracts/uckk-learning-package.schema.json",
    "receipt_contract_ref": "contracts/artifact-contracts/uckk-import-receipt.schema.json",
    "shared_frame_ref": "contracts/artifact-contracts/shared-mediatheque-frame.schema.json",
    "online_transport": "authenticated retrieval from an allowlisted UCKK endpoint",
    "offline_transport": "complete signed or otherwise verifiable offline bundle",
    "quarantine": "required before local acceptance",
    "acceptance": "explicit user or governed local decision after source, license, integrity, provenance, compatibility, and resource-graph validation",
    "local_identity": "new kOA record and version identities with preserved UCKK provenance",
    "updates": "new remote versions become explicit local update candidates"
  },
  "allowed_operations": [
    "discover_declared_catalog",
    "resolve_selected_source_graph",
    "authenticate",
    "retrieve_learning_package",
    "receive_offline_learning_package",
    "quarantine_package",
    "verify_manifest_and_integrity",
    "verify_source_and_signature",
    "resolve_license_and_restrictions",
    "validate_shared_frame_mapping",
    "request_local_acceptance",
    "create_local_records_after_acceptance",
    "record_import_receipt",
    "offer_remote_update_candidate"
  ],
  "prohibited_operations": [
    "direct UCKK database access",
    "automatic import of the entire remote catalog",
    "acceptance before quarantine and validation",
    "silent removal of rights, restrictions, or provenance",
    "replacement of local identities by UCKK identifiers",
    "automatic remote overwrite of local copies",
    "background bidirectional synchronization",
    "treating UCKK metadata as local policy authority",
    "making UCKK connectivity required for accepted offline content"
  ],
  "data_transfer": {
    "minimum_necessary": true,
    "content_transfer": "Only resources in the explicitly selected and complete learning package.",
    "metadata_transfer": "Only shared-frame and learning-structure fields required for offline use, provenance, rights, validation, and update comparison.",
    "credentials": "Resolved from a dedicated secret store and never embedded in imported records or packages.",
    "restricted_data_default": "deny_or_require_review",
    "ai_data_transfer": "not required"
  },
  "offline_behavior": {
    "accepted_content_available": true,
    "complete_bundle_import_supported": true,
    "incomplete_package": "remain_quarantined",
    "live_discovery_and_download": "unavailable",
    "remote_update_check": "deferred",
    "local_progress_and_private_adaptation": "continue under local application authority",
    "automatic_upload_on_reconnection": false
  },
  "failure_model": {
    "authentication_failure": "block online retrieval",
    "source_untrusted": "reject or quarantine pending explicit trust resolution",
    "manifest_incomplete": "quarantine and block acceptance",
    "integrity_failure": "reject affected package or resource",
    "license_unknown_or_prohibits_local_copy": "block acceptance",
    "frame_mapping_lossy": "block or require explicit review without silent field loss",
    "malware_scan_failure": "reject",
    "resource_graph_incomplete": "quarantine",
    "local_acceptance_denied": "retain or delete quarantine according to policy without creating active local records",
    "remote_source_withdrawn": "record source state; do not silently delete accepted local copies",
    "destination_storage_pressure": "queue or deny before partial activation"
  },
  "security_and_audit": {
    "authentication_required_for_online_retrieval": true,
    "transport_security_required": true,
    "source_allowlist_required": true,
    "signature_or_equivalent_source_evidence_required": true,
    "quarantine_required": true,
    "license_and_rights_validation_required": true,
    "import_receipt_required": true,
    "selective_audit": true,
    "content_in_logs": false,
    "rate_limits_required": true
  },
  "compatibility": {
    "shared_mediatheque_frame_ref": "contracts/artifact-contracts/shared-mediatheque-frame.schema.json",
    "frame_version_required": true,
    "mapping_version_required": true,
    "moodle_export_or_api_version_required": true,
    "unsupported_mapping_behavior": "block or require review; do not silently discard fields or restrictions",
    "publication": "Outbound publication remains a distinct integration governed by contracts/integrations/uckk-publication.integration.json."
  },
  "validation": {
    "validator_ref": "tools/check_uckk_external_boundary.py",
    "required_tests": [
      "explicit source selection",
      "allowlisted source",
      "quarantine before acceptance",
      "integrity failure rejected",
      "license restriction enforced",
      "shared-frame mapping version enforced",
      "provenance preserved",
      "local identity created separately",
      "offline bundle accepted without network",
      "remote update remains candidate",
      "no automatic upload",
      "no bidirectional synchronization"
    ]
  }
}
