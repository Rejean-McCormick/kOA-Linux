    "source_revision_ref": "source:governance-policy:git:8f4c1a2",
    "production_receipt_ref": "PROV-RECEIPT-POLICY-0001"
  },
  "policy_scope": {
    "scope_id": "policy-scope:sovereign-baseline",
    "authority_domain_ref": "authority-domain:example-sovereign",
    "tenant_refs": [
      "tenant:example"
