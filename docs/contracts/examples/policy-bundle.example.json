  "contract_type": "policy_bundle",
  "contract_version": "1.0.0",
  "artifact_id": "POLICY-BUNDLE-SOVEREIGN-BASELINE",
  "artifact_class": "policy_bundle",
  "artifact_version": "1.0.0",
  "status": "published",
  "release_channel": "governance",
  "title": "Sovereign Governance Baseline",
  "description": "Example immutable governance policy bundle for sovereign deployments. It demonstrates fail-closed decisions, explicit authority, component-data separation, controlled publication, bounded break-glass, external-AI candidate handling, and critical-transition receipts.",
  "producer": {
    "producer_identity_ref": "identity:governance-policy-publisher",
    "producer_component_ref": "component:governance-policy-workbench",
    "produced_at": "2026-08-03T18:03:00-04:00",
    "environment_ref": "environment:governance-publication",
