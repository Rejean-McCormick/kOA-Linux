      "capability:break_glass"
    ]
  },
  "schema_version": "1.0.0",
  "policy_model": {
    "decision_states": [
      "authorized",
      "denied",
      "indeterminate"
    ],
    "default_decision": "denied",
    "indeterminate_effect": "denied",
    "combining_algorithm": "deny_overrides",
    "explicit_grant_required": true,
    "resource_availability_creates_authority": false,
    "identity_success_creates_authority": false
  },
  "rules": [
    {
      "rule_id": "POLICY-RULE-IDENTITY-NOT-AUTHORITY",
      "version": "1.0.0",
      "status": "active",
      "priority": 100,
      "effect": "deny",
      "description": "Authentication or trust verification alone cannot authorize a protected business, governance, publication, or host action.",
      "subject_selector": {
        "subject_types": [
          "human",
          "service",
          "node",
          "component_instance"
        ],
        "identity_required": true
      },
      "action_selector": {
        "action_classes": [
          "protected_business_action",
          "governance_mutation",
          "publication",
          "privileged_host_mutation"
        ]
      },
      "resource_selector": {
        "resource_classes": [
          "protected"
        ]
      },
      "conditions": [
        {
          "condition_id": "COND-AUTHORITY-REF-MISSING",
          "operator": "is_empty",
          "field_ref": "request.authority_refs"
        }
      ],
      "obligations": [
        {
          "obligation_id": "OBL-RETURN-DENIAL-REASON",
          "type": "return_reason_code",
          "value": "explicit_authority_missing"
        }
      ],
      "reason_code": "identity_is_not_authorization"
    },
    {
      "rule_id": "POLICY-RULE-CROSS-COMPONENT-WRITE",
      "version": "1.0.0",
      "status": "active",
      "priority": 110,
      "effect": "deny",
      "description": "A component cannot write directly to another component's authoritative source tables.",
      "subject_selector": {
        "subject_types": [
          "service",
          "component_instance"
        ],
        "identity_required": true
      },
      "action_selector": {
        "action_classes": [
          "database_write"
        ]
      },
      "resource_selector": {
        "resource_classes": [
          "component_authoritative_store"
        ]
      },
      "conditions": [
        {
          "condition_id": "COND-OWNER-MISMATCH",
          "operator": "not_equal",
          "left_field_ref": "subject.component_id",
          "right_field_ref": "resource.canonical_owner_component_id"
        }
      ],
      "obligations": [
        {
          "obligation_id": "OBL-USE-DECLARED-CONTRACT",
          "type": "required_remediation",
          "value": "use_declared_component_interface_gateway_event_or_artifact"
        },
        {
          "obligation_id": "OBL-RECORD-DENIAL",
          "type": "emit_decision_receipt",
          "value": "decision_receipt"
        }
      ],
      "reason_code": "cross_component_source_write_denied"
    },
    {
      "rule_id": "POLICY-RULE-PUBLICATION-AUTHORITY",
      "version": "1.0.0",
      "status": "active",
      "priority": 120,
      "effect": "require",
      "description": "Cross-domain publication requires an explicit Publication Gateway decision covering source, audience, destination, purpose, and disclosure.",
      "subject_selector": {
        "subject_types": [
          "human",
          "service",
          "component_instance"
        ],
        "identity_required": true
      },
      "action_selector": {
        "action_classes": [
          "cross_domain_publication"
        ]
      },
      "resource_selector": {
        "resource_classes": [
          "content_object",
          "knowledge_artifact",
          "mediatheque_rendition"
        ]
      },
      "conditions": [
        {
          "condition_id": "COND-PUBLICATION-GATEWAY-DECISION",
          "operator": "contains_authority_class",
          "field_ref": "request.authority_refs",
          "value": "publication_gateway_decision"
        },
        {
          "condition_id": "COND-AUDIENCE-DECLARED",
          "operator": "is_present",
          "field_ref": "request.audience_ref"
        },
        {
          "condition_id": "COND-DESTINATION-DECLARED",
          "operator": "is_present",
          "field_ref": "request.destination_ref"
        }
      ],
      "obligations": [
        {
          "obligation_id": "OBL-PUBLICATION-RECEIPT",
          "type": "emit_transition_receipt",
          "value": "publication_receipt"
        },
        {
          "obligation_id": "OBL-SELECTIVE-DISCLOSURE",
          "type": "apply_disclosure_view",
          "value": "audience_and_destination_scoped"
        }
      ],
      "reason_code": "publication_authority_required"
    },
    {
      "rule_id": "POLICY-RULE-EXTERNAL-AI-CANDIDATE",
      "version": "1.0.0",
      "status": "active",
      "priority": 130,
      "effect": "require",
      "description": "Output from an approved external AI surface remains a candidate until controlled import, provenance verification, review, and component-level acceptance complete.",
      "subject_selector": {
        "subject_types": [
          "external_integration"
        ],
        "identity_required": true
      },
      "action_selector": {
        "action_classes": [
          "external_ai_result_import"
        ]
      },
      "resource_selector": {
        "resource_classes": [
          "candidate_content",
          "candidate_metadata",
          "candidate_command"
        ]
      },
      "conditions": [
        {
          "condition_id": "COND-INTEGRATION-APPROVED",
          "operator": "in",
          "field_ref": "subject.integration_id",
          "values": [
            "chatgpt",
            "suno",
            "gamma",
            "ariane_external_voice"
          ]
        },
        {
          "condition_id": "COND-PROVENANCE-PRESENT",
          "operator": "is_present",
          "field_ref": "request.provenance_receipt_ref"
        },
        {
          "condition_id": "COND-ACCEPTANCE-STATE",
          "operator": "equal",
          "field_ref": "resource.acceptance_state",
          "value": "candidate"
        }
      ],
      "obligations": [
        {
          "obligation_id": "OBL-CONTROLLED-IMPORT",
          "type": "route_to_workflow",
          "value": "controlled_import_and_review"
        },
        {
          "obligation_id": "OBL-NO-DIRECT-MUTATION",
          "type": "prohibit_direct_mutation",
          "value": true
        }
      ],
      "reason_code": "external_ai_output_is_candidate"
    },
    {
      "rule_id": "POLICY-RULE-BREAK-GLASS",
      "version": "1.0.0",
      "status": "active",
      "priority": 140,
      "effect": "require",
      "description": "Break-glass use is bounded, human-authorized, time-limited, capability-scoped, visible, receipt-producing, and explicitly closed.",
      "subject_selector": {
        "subject_types": [
          "human",
          "recovery_operator"
        ],
        "identity_required": true
      },
      "action_selector": {
        "action_classes": [
          "break_glass_action"
        ]
      },
      "resource_selector": {
        "resource_classes": [
          "protected"
        ]
      },
      "conditions": [
        {
          "condition_id": "COND-BREAK-GLASS-AUTHORITY",
          "operator": "contains_authority_class",
          "field_ref": "request.authority_refs",
          "value": "break_glass_authority"
        },
        {
          "condition_id": "COND-EXPIRATION-PRESENT",
          "operator": "is_present",
          "field_ref": "request.expires_at"
        },
        {
          "condition_id": "COND-CAPABILITY-SCOPE-PRESENT",
          "operator": "not_empty",
          "field_ref": "request.capability_scope"
        }
      ],
      "obligations": [
        {
          "obligation_id": "OBL-VISIBLE-MODE",
          "type": "display_authority_context",
          "value": "break_glass"
        },
        {
          "obligation_id": "OBL-BREAK-GLASS-RECEIPTS",
          "type": "emit_receipts",
          "value": [
            "activation",
            "use",
            "expiration_or_revocation",
            "closure"
          ]
        },
        {
          "obligation_id": "OBL-AUTOMATIC-EXPIRY",
          "type": "enforce_expiration",
          "value": true
        }
      ],
      "reason_code": "bounded_break_glass_required"
    },
    {
      "rule_id": "POLICY-RULE-CRITICAL-RECEIPT",
      "version": "1.0.0",
      "status": "active",
      "priority": 150,
      "effect": "require",
      "description": "Critical policy, privilege, publication, activation, rollback, restore, migration, transfer, and recovery transitions require machine-readable receipts from the owning decision or commit boundary.",
      "subject_selector": {
        "subject_types": [
          "human",
          "service",
          "component_instance"
        ],
        "identity_required": true
      },
      "action_selector": {
        "action_classes": [
          "policy_activation",
          "privileged_host_mutation",
          "publication",
          "artifact_activation",
          "artifact_rollback",
          "restore",
          "migration",
          "external_transfer",
          "recovery"
        ]
      },
      "resource_selector": {
        "resource_classes": [
          "critical_transition_target"
        ]
      },
      "conditions": [
        {
          "condition_id": "COND-TRANSITION-CRITICAL",
          "operator": "equal",
          "field_ref": "request.critical",
          "value": true
        }
      ],
      "obligations": [
        {
          "obligation_id": "OBL-OWNER-RECEIPT",
          "type": "emit_owner_receipt",
          "value": true
        },
        {
          "obligation_id": "OBL-RECEIPT-CORRELATION",
          "type": "require_correlation_id",
          "value": true
        }
      ],
      "reason_code": "critical_transition_receipt_required"
    }
  ],
  "rule_order": [
