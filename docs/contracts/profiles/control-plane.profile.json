    "test_expectations": {
      "TEST-PROFILE-CP-001": "Profile composition accepts only the control_plane primary profile with compatible overlays.",
      "TEST-PROFILE-CP-002": "Managed nodes retain local component, policy, data, resource, activation, and recovery validation.",
      "TEST-PROFILE-CP-003": "Control-plane operations cannot write directly to managed component authoritative stores.",
      "TEST-PROFILE-CP-004": "Release coordination enforces Release Set compatibility, target validation, non-partial activation, and receipts.",
      "TEST-PROFILE-CP-005": "Kubernetes and non-Kubernetes implementations satisfy the same profile contracts and Kubernetes remains optional.",
      "TEST-PROFILE-CP-006": "Loss of control-plane connectivity preserves managed-node local operation and blocks unsupported new changes.",
      "TEST-PROFILE-CP-007": "Remote operations are authenticated, authorized, scoped, bounded, replay-protected, and receipt-producing.",
      "TEST-PROFILE-CP-008": "Resource pressure reduces fanout and noncritical work while preserving identity, policy, recovery, and operator control.",
      "TEST-PROFILE-CP-009": "Backup and restore recover control-plane coordination state without creating partial authority.",
      "TEST-PROFILE-CP-010": "Observability and evidence collection remain selective and do not acquire tenant or component data ownership.",
      "TEST-PROFILE-CP-011": "External AI is absent from automated operational control paths and removal does not break core operation.",
      "TEST-PROFILE-CP-012": "Every active profile claim resolves to decisions, requirements, locks, tests, and valid evidence."
