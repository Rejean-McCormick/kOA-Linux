  "capabilities": {
    "required": [
      {
        "capability_id": "deployment_coordination",
        "description": "Coordinate declared deployment state and rollout intent for managed nodes through authenticated, versioned, and policy-governed contracts."
      },
      {
        "capability_id": "release_coordination",
        "description": "Coordinate compatible system, services, governance, and knowledge releases using validated Release Sets."
      },
      {
        "capability_id": "artifact_distribution",
        "description": "Distribute registered, validated, integrity-protected, and where required signed artifacts to managed nodes."
      },
      {
        "capability_id": "governance_artifact_distribution",
        "description": "Distribute accepted governance and policy artifacts without creating or silently changing their authority."
      },
      {
        "capability_id": "fleet_inventory",
        "description": "Maintain an authorized inventory of enrolled nodes, profile claims, active release identities, capabilities, and declared health state."
      },
      {
        "capability_id": "fleet_health_and_readiness",
        "description": "Collect bounded health and readiness information without acquiring application-data or component-state authority."
      },
      {
        "capability_id": "maintenance_coordination",
        "description": "Coordinate maintenance windows, staged changes, recovery operations, and operator-visible execution state."
      },
      {
        "capability_id": "evidence_aggregation",
        "description": "Aggregate references to receipts, tests, and evidence while preserving selective disclosure and source ownership."
      }
    ],
    "optional": [
      {
        "capability_id": "kubernetes_orchestration",
        "description": "Use Kubernetes as one permitted implementation for control-plane services when scale or operations justify it."
      },
      {
        "capability_id": "non_kubernetes_orchestration",
        "description": "Operate equivalent control-plane contracts without Kubernetes."
      },
      {
        "capability_id": "staged_rollout",
        "description": "Coordinate staged or canary-like rollout groups when declared by the release and operations contracts."
      },
      {
        "capability_id": "multi_site_coordination",
        "description": "Coordinate multiple authorized sites or domains without merging their component or data authority."
      }
    ],
    "prohibited": [
      "direct_write_to_managed_component_authoritative_tables",
      "unilateral_node_policy_override",
      "unvalidated_artifact_activation",
      "partial_release_set_activation",
      "implicit_profile_change",
      "automatic_external_ai_control",
      "unbounded_remote_command_execution",
      "indiscriminate_tenant_data_collection",
      "silent_provider_or_node_substitution"
    ]
  },
