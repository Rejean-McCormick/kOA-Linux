  "scope": {
    "kind": "profile",
    "applies_to": [
      "single-user daily operation",
      "local personal knowledge and workflow use",
      "deterministic local media ingestion and processing",
      "general-purpose maintained Linux desktops",
      "commodity or refurbished x86_64 and arm64 hardware"
    ],
    "does_not_claim": [
      "developer workstation conformance",
      "sovereign Linux node conformance",
      "high-assurance conformance",
      "build-farm conformance",
      "control-plane conformance",
      "native AI capability",
      "multi-tenant service hosting",
      "continuous high-throughput media processing"
    ]
