  "purpose": {
    "primary_user": "An individual using kOA for ordinary daily work.",
    "operating_goal": "Keep the authoritative local core responsive and available on modest hardware while activating expensive workers only for explicit tasks.",
    "design_priorities": [
      "local-first operation",
      "low idle resource consumption",
      "deterministic behavior",
      "clear component ownership",
      "explicit optional integrations",
      "safe offline continuity",
      "simple backup, restore, and exit",
      "maintained general-purpose desktop support"
    ],
    "non_goals": [
      "running every kOA workbench simultaneously",
      "hosting native language-model inference",
      "permanent Solr or Elasticsearch services",
      "building system images or release bundles",
      "compiling grammars or language runtimes",
      "running a permanent Windows virtual machine",
      "serving as a sovereign production node",
      "serving as a clustered control plane"
    ]
  },
  "composition": {
    "base_model": "contracts/system.contract.json",
    "default_overlays": [],
    "overlay_compatibility": [
      {
        "overlay_id": "appliance_shell",
        "compatibility": "compatible",
        "conditions": [
          "The appliance shell replaces the general-purpose desktop shell.",
          "The overlay does not reduce the minimum hardware envelope.",
          "The overlay retains non-voice Ariane navigation and accessibility paths."
        ]
      },
      {
        "overlay_id": "sovereign_offline",
        "compatibility": "compatible_with_constraints",
        "conditions": [
          "All required runtime artifacts and update material are available through verified offline bundles.",
          "External AI, voice, synchronization, and other remote-dependent capabilities are disabled.",
          "The composed profile uses the stronger offline validation and evidence rules."
        ]
      },
      {
        "overlay_id": "high_assurance",
        "compatibility": "not_compatible",
        "reason": "The lightweight profile does not establish the physical isolation, trust, privilege, evidence, and recovery envelope required for a high-assurance conformance claim. Use sovereign_linux_node with high_assurance."
      }
    ],
    "composition_rules": [
      "An overlay changes only the fields it explicitly owns.",
      "An overlay cannot weaken a global or profile requirement.",
      "An overlay conflict blocks the composed profile.",
      "The composed profile receives a distinct conformance result."
    ]
  },
