  "status": "active",
  "language": "en",
  "title": "Appliance Shell Overlay",
  "description": "A composable Linux graphical-shell overlay that replaces a general-purpose desktop session with a constrained local kOA experience based on a minimal Wayland compositor, Ariane local navigation, and an optional embedded web interface.",
