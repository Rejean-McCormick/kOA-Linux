    "composition_role": "graphical_shell_overlay",
    "compatible_base_profiles": [
      "user_lightweight",
      "sovereign_linux_node"
    ],
    "incompatible_base_profiles": [
      "developer_linux_workstation",
      "developer_windows_wsl",
      "sovereign_hub",
      "build_farm",
      "control_plane"
    ],
    "required_host_properties": {
      "operating_system_family": "linux",
      "local_graphical_seat": true,
      "wayland_capable": true,
      "local_input_available": true
    },
    "required_base_capabilities": [
      "interactive_user",
      "ariane_local_navigation"
    ],
    "inheritance": {
      "inherits_base_profile_components": true,
      "inherits_base_profile_resources": true,
      "inherits_base_profile_security": true,
      "inherits_base_profile_offline_envelope": true,
      "overlay_can_broaden_authority": false,
      "overlay_can_broaden_data_ownership": false,
      "overlay_can_broaden_external_integrations": false,
      "overlay_precedence": [
        "explicit_overlay_restriction",
        "compatible_base_profile_rule",
        "global_system_rule"
      ]
    },
    "conflicts": [
      {
        "conflict_id": "PROFILE-CONFLICT-APP-001",
        "selector": "desktop.full_general_purpose_environment",
        "result": "composition_rejected"
      },
      {
        "conflict_id": "PROFILE-CONFLICT-APP-002",
        "selector": "operating_modes.development_workspace",
        "result": "composition_rejected"
      },
