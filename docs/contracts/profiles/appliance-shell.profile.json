        "conflict_id": "PROFILE-CONFLICT-APP-003",
        "selector": "interface.unrestricted_external_navigation",
        "result": "composition_rejected"
      }
    ]
  },
  "operating_modes": {
    "permitted_primary_modes": [
      "interactive_user",
      "unattended_service",
      "maintenance",
      "recovery"
    ],
    "prohibited_primary_modes": [
      "development_workspace"
    ],
    "connectivity_states": [
      "connected",
      "offline",
      "restricted_connectivity"
    ],
    "capability_health_states": [
      "nominal",
      "degraded",
      "suspended"
    ],
    "authority_contexts": [
      "ordinary",
      "break_glass",
      "authority_blocked"
    ],
    "ordinary_session_mode": "interactive_user",
    "maintenance_entry": "explicit_authorized_transition",
    "recovery_entry": "explicit_authorized_transition",
    "break_glass_changes_primary_mode": false
  },
  "shell": {
    "session_type": "dedicated_appliance_session",
    "display_protocol": "wayland",
    "compositor": {
      "class": "minimal_wayland_compositor",
      "full_desktop_environment": false,
      "desktop_environment_packages_required": false,
      "gnome_allowed_in_overlay_session": false,
      "kde_plasma_allowed_in_overlay_session": false,
      "window_management": "application_allowlist"
    },
    "interface": {
      "primary_experience": "ariane_local_navigation",
      "embedded_web_interface": {
        "permitted": true,
        "required": false,
        "content_origin_policy": "declared_local_or_explicitly_approved_origins",
        "unrestricted_browser_chrome": false,
        "unrestricted_external_navigation": false
      },
      "supported_input_methods": [
        "keyboard",
        "pointer",
        "touch",
        "accessibility_controls",
        "local_deterministic_commands"
      ],
      "external_voice": {
        "available": "optional",
        "authority": "approved_external_ariane_voice",
        "failure_effect": "voice_capability_unavailable_only",
        "silent_substitution": false
      },
      "local_navigation_requires_external_ai": false,
      "general_purpose_desktop_behavior": "restricted"
    },
    "application_surface": {
      "launch_policy": "explicit_allowlist",
      "arbitrary_application_launcher": false,
      "unrestricted_terminal_in_ordinary_session": false,
      "package_manager_ui_in_ordinary_session": false,
      "host_administration_ui_in_ordinary_session": false,
      "development_tools_in_ordinary_session": false,
      "external_url_handoff": "explicit_controlled_action",
      "file_selection": "capability_scoped",
      "clipboard": "capability_scoped",
      "drag_and_drop": "capability_scoped"
    },
    "session_controls": {
      "user_visible_actions": [
        "navigate",
        "open_allowed_capability",
        "return_home",
        "lock_session",
        "end_session",
        "request_restart",
        "request_shutdown",
        "open_accessibility_controls",
        "view_system_status"
      ],
      "privileged_actions_require_separate_authority": true,
      "maintenance_controls_hidden_during_ordinary_session": true,
      "recovery_controls_hidden_during_ordinary_session": true
    }
  },
  "components": {
    "required": [
      {
        "component_id": "ariane-runtime",
        "role": "local_navigation_and_shell_orchestration",
        "always_available_in_ordinary_session": true
      },
      {
        "component_id": "identity-and-trust",
        "role": "session_and_service_identity",
        "always_available_in_ordinary_session": true
      },
      {
        "component_id": "resource-governor",
        "role": "interactive_resource_protection",
        "always_available_in_ordinary_session": true
      }
    ],
    "conditional": [
      {
        "component_id": "governance-policy-runtime",
        "condition": "required_by_composed_base_profile_or_active_policy",
        "role": "governance_authorization"
      },
      {
        "component_id": "audit-broker",
        "condition": "required_by_composed_base_profile_or_receipt_policy",
        "role": "receipt_and_evidence_services"
      },
      {
        "component_id": "koa-node-agent",
        "condition": "required_by_composed_base_profile",
        "role": "node_lifecycle_and_status"
      }
    ],
    "ordinary_session_exclusions": [
      "gf-wordbench",
      "sentient",
      "development-containers",
      "compiler-toolchains",
      "unrestricted-host-shell"
    ],
    "base_profile_component_ownership_preserved": true
  },
  "capabilities": {
    "required": [
      "ariane_local_navigation",
      "deterministic_local_commands",
      "session_lock",
      "truthful_capability_status",
      "accessible_input",
      "safe_degradation",
      "authorized_maintenance_entry",
      "authorized_recovery_entry"
    ],
    "optional": [
      "ariane_external_voice",
      "embedded_local_web_interface",
      "controlled_external_link_handoff"
    ],
    "prohibited": [
      "unrestricted_general_purpose_desktop",
      "unrestricted_application_launch",
      "unrestricted_terminal_access",
      "automatic_external_ai_invocation",
      "silent_external_voice_substitution",
      "ordinary_session_host_mutation",
      "ordinary_session_development_workspace",
      "ordinary_session_package_installation"
    ],
    "external_ai_baseline_dependency": false
  },
  "security": {
    "ordinary_session": {
      "least_privilege": true,
      "privileged_processes_exposed_to_session": false,
      "direct_host_mutation": false,
      "direct_cross_component_data_writes": false,
      "unrestricted_local_socket_access": false,
      "unrestricted_device_access": false,
      "secrets_exposed_to_interface": false
    },
    "maintenance_and_recovery": {
      "separate_authority_required": true,
      "separate_entry_flow_required": true,
      "visible_mode_indicator_required": true,
      "receipt_required_for_critical_transitions": true,
      "automatic_return_to_ordinary_session": "after_validated_completion"
    },
    "network": {
      "default_ui_origin": "local",
      "external_origins": "explicit_allowlist",
      "unrestricted_web_browsing": false,
      "external_transfer_requires_declared_integration": true,
      "external_ai_transfer_requires_explicit_user_initiation": true
    },
    "fail_closed": {
      "unknown_application": "deny_launch",
      "unknown_origin": "deny_navigation",
      "missing_session_authority": "deny_session_activation",
      "missing_privileged_authority": "deny_privileged_action",
      "invalid_shell_artifact": "preserve_last_valid_shell_or_enter_recovery"
    }
  },
  "offline_behavior": {
    "local_shell_available": true,
    "ariane_local_navigation_available": true,
    "external_voice_available": false,
    "external_ai_available": false,
    "external_navigation_available": false,
    "base_profile_offline_capabilities_preserved": true,
    "queued_external_actions": "explicit_only_and_reevaluated_before_execution",
    "false_success_reporting": false
  },
  "resource_policy": {
    "inherits_base_profile_budget": true,
    "interactive_priority": true,
    "shell_process_class": "interactive_critical",
    "background_workers": "base_profile_governed",
    "heavy_jobs": "base_profile_governed",
    "resource_pressure_response": [
      "suspend_optional_background_work",
      "preserve_ariane_local_navigation",
      "preserve_session_status_and_exit_controls",
      "degrade_optional_embedded_content",
      "enter_declared_recovery_when_shell_integrity_is_lost"
    ],
    "resource_availability_creates_authority": false
  },
  "lifecycle": {
    "activation": {
      "artifact_verification_required": true,
      "compatibility_validation_required": true,
      "atomic_activation_required": true,
      "last_valid_shell_preserved_on_failure": true
    },
    "rollback": {
      "required": true,
      "target": "last_valid_shell_configuration"
    },
    "forward_repair": {
      "permitted": true,
      "requires_declared_repair_plan": true
    },
    "session_start": [
      "verify_active_profile_composition",
      "verify_shell_artifacts",
      "verify_local_navigation",
      "verify_input_and_accessibility",
      "verify_status_and_exit_controls",
      "activate_restricted_session"
    ],
    "session_failure": [
      "preserve_authoritative_application_state",
      "show_truthful_local_failure_surface_when_available",
      "restart_bounded_shell_components",
      "enter_recovery_when_integrity_or_repeated_startup_checks_fail"
    ],
    "fallback_to_unrestricted_desktop": false
  },
