    "hardware_rooted_trust": {
      "state": "required",
      "conditions": [],
      "degraded_behavior": "The affected capability is reported unavailable or degraded; no silent authority or provider substitution is permitted.",
      "rationale": "Hardware-rooted or equivalently protected trust is required for the composed profile."
    },
    "measured_boot": {
      "state": "required",
      "conditions": [],
      "degraded_behavior": "The affected capability is reported unavailable or degraded; no silent authority or provider substitution is permitted.",
      "rationale": "The composed profile records and verifies a measured boot chain."
    },
    "strong_identity_and_authentication": {
      "state": "required",
      "conditions": [],
      "degraded_behavior": "The affected capability is reported unavailable or degraded; no silent authority or provider substitution is permitted.",
      "rationale": "Hardware-bound identities, scoped trust roots, revocation, and strong authentication are required."
    },
    "tamper_evident_audit": {
      "state": "required",
      "conditions": [],
      "degraded_behavior": "The affected capability is reported unavailable or degraded; no silent authority or provider substitution is permitted.",
      "rationale": "Critical evidence is attributable, protected, and tamper-evident."
    },
    "separation_of_duties": {
      "state": "required",
      "conditions": [],
      "degraded_behavior": "The affected capability is reported unavailable or degraded; no silent authority or provider substitution is permitted.",
      "rationale": "Critical actions use explicit separation-of-duties or dual-control rules."
    },
    "external_ai_assistance": {
      "state": "optional",
      "conditions": [],
      "degraded_behavior": "The affected capability is reported unavailable or degraded; no silent authority or provider substitution is permitted.",
      "rationale": "Approved external AI remains optional, user-initiated, and non-authoritative."
    },
    "weakened_primary_controls": {
      "state": "excluded",
      "conditions": [],
      "degraded_behavior": "The affected capability is reported unavailable or degraded; no silent authority or provider substitution is permitted.",
      "rationale": "The overlay may strengthen or restrict but never weaken primary-profile controls."
    }
  },
  "components": {
    "identity_and_trust": {
      "state": "required",
      "activation": "always_on",
      "conditions": [
        "Node and workload identities use hardware-bound or equivalently protected keys.; Trust roots are scoped by tenant, environment, channel, artifact class, and authority domain."
      ],
      "data_authority": "component_owned",
      "failure_behavior": "None"
    },
    "governance_policy_runtime": {
      "state": "required",
      "activation": "always_on",
      "conditions": [
        "Unknown required facts fail closed.; Critical decisions apply separation-of-duties and dual-control rules."
      ],
      "data_authority": "component_owned",
      "failure_behavior": "None"
    },
    "audit_broker": {
      "state": "required",
      "activation": "always_on",
      "conditions": [
        "Critical evidence uses protected append-only or tamper-evident storage.; Audit classes remain separated by access, retention, encryption, disclosure, and deletion policy."
      ],
      "data_authority": "component_owned",
      "failure_behavior": "None"
    },
    "koa_node_agent": {
      "state": "required",
      "activation": "always_on",
      "conditions": [
        "Arbitrary shell, package-manager, file-copy, container, service-control, and key-export operations are rejected.; Every privileged operation is bound to an active policy decision and replay-protection value."
      ],
      "data_authority": "component_owned",
      "failure_behavior": "None"
    },
    "resource_governor": {
      "state": "required",
      "activation": "always_on",
      "conditions": [
        "Identity, policy, audit, recovery, verification, and active-user control retain protected resource reservations.; Optional heavy work is throttled or stopped before assurance-critical services."
      ],
      "data_authority": "component_owned",
      "failure_behavior": "None"
    },
    "publication_gateway": {
      "state": "conditional",
      "activation": "service_activated",
      "conditions": [
        "The composed profile permits private-to-public or cross-domain disclosure."
      ],
      "data_authority": "component_owned",
      "failure_behavior": "None"
    },
    "sentient": {
      "state": "optional",
      "activation": "task_activated",
      "conditions": [
        "Optional, isolated, task-activated, and non-authoritative when permitted by the composed profile."
      ],
      "data_authority": "component_owned",
      "failure_behavior": "None"
    }
  },
