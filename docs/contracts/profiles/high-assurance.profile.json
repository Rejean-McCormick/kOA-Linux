  "profile_specific_requirements": [
    {
      "requirement_id": "REQ-PROF-HA-001",
      "control": "The overlay is composed with exactly one compatible primary profile."
    },
    {
      "requirement_id": "REQ-PROF-HA-002",
      "control": "The composed deployment establishes a verified boot chain and measured active system identity."
    },
    {
      "requirement_id": "REQ-PROF-HA-003",
      "control": "Node and workload identities use hardware-bound or equivalently protected keys."
    },
    {
      "requirement_id": "REQ-PROF-HA-004",
      "control": "Privileged human access uses phishing-resistant multi-factor authentication."
    },
    {
      "requirement_id": "REQ-PROF-HA-005",
      "control": "Trust-root, release-signing, destructive-recovery, and break-glass operations use independent approval."
    },
    {
      "requirement_id": "REQ-PROF-HA-006",
      "control": "Release and authority private keys remain outside application nodes and ordinary build workers."
    },
    {
      "requirement_id": "REQ-PROF-HA-007",
      "control": "Governance Policy Runtime, Audit Broker, kOA Node Agent, Identity and Trust, and Resource Governor are active."
    },
    {
      "requirement_id": "REQ-PROF-HA-008",
      "control": "Arbitrary privileged host operations are unavailable through normal kOA interfaces."
    },
    {
      "requirement_id": "REQ-PROF-HA-009",
      "control": "Every governed privileged operation is bound to a current policy decision and replay-protection value."
    },
    {
      "requirement_id": "REQ-PROF-HA-010",
      "control": "The host uses enforcing mandatory access control and least-privilege service isolation."
    },
    {
      "requirement_id": "REQ-PROF-HA-011",
      "control": "Durable sensitive state is encrypted and tenant and component data boundaries remain explicit."
    },
    {
      "requirement_id": "REQ-PROF-HA-012",
      "control": "Administrative and service networks follow default-deny and explicit allowlisting."
    },
    {
      "requirement_id": "REQ-PROF-HA-013",
      "control": "Remote administration uses a declared high-assurance policy, strong authentication, bounded scope, and evidence."
    },
    {
      "requirement_id": "REQ-PROF-HA-014",
      "control": "Removable media and offline bundles use quarantine, bounded parsing, verification, authorization, and controlled staging."
    },
    {
      "requirement_id": "REQ-PROF-HA-015",
      "control": "Release artifacts provide required provenance, signing, dependency, and software-bill-of-material evidence."
    },
    {
      "requirement_id": "REQ-PROF-HA-016",
      "control": "Artifact verification precedes atomic activation and preserves a last-known-good compatible state."
    },
    {
      "requirement_id": "REQ-PROF-HA-017",
      "control": "Downgrade, substitution, revoked-artifact, and incorrectly scoped activation attempts are rejected."
    },
    {
      "requirement_id": "REQ-PROF-HA-018",
      "control": "Critical security, authority, release, publication, recovery, and exception transitions produce protected evidence."
    },
    {
      "requirement_id": "REQ-PROF-HA-019",
      "control": "Protected evidence uses tamper-evident anchoring and access to protected evidence is audited."
    },
    {
      "requirement_id": "REQ-PROF-HA-020",
      "control": "Audit collection remains classified, minimized, and separated from unrestricted disclosure."
    },
    {
      "requirement_id": "REQ-PROF-HA-021",
      "control": "Break-glass authority is capability-scoped, time-bounded, attributable, expiring, and reviewed."
    },
    {
      "requirement_id": "REQ-PROF-HA-022",
      "control": "Recovery occurs in a separate reduced environment using stronger authentication and dual control."
    },
    {
      "requirement_id": "REQ-PROF-HA-023",
      "control": "Trust-root replacement requires independent approval, continuity evidence, and post-event audit."
    },
    {
      "requirement_id": "REQ-PROF-HA-024",
      "control": "Encrypted backups include an independent protected copy and pass controlled restore tests."
    },
    {
      "requirement_id": "REQ-PROF-HA-025",
      "control": "External integrations and AI surfaces are disabled by default and cannot directly mutate authority."
    },
    {
      "requirement_id": "REQ-PROF-HA-026",
      "control": "Restricted and no-AI data cannot be transferred to external AI surfaces without explicit compatible policy."
    },
    {
      "requirement_id": "REQ-PROF-HA-027",
      "control": "SenTient remains isolated, task-activated, non-authoritative, and disconnected from production authoritative stores."
    },
    {
      "requirement_id": "REQ-PROF-HA-028",
      "control": "Resource pressure preserves identity, policy, audit, verification, recovery, and interactive control before optional work."
    },
    {
      "requirement_id": "REQ-PROF-HA-029",
      "control": "Active release, artifact, component, trust, revocation, and drift identities remain inspectable."
    },
    {
      "requirement_id": "REQ-PROF-HA-030",
      "control": "Security and authority failures degrade only affected capabilities and never broaden authority."
    },
    {
      "requirement_id": "REQ-PROF-HA-031",
      "control": "Profile composition conflicts block activation rather than selecting a silent precedence."
    },
    {
      "requirement_id": "REQ-PROF-HA-032",
      "control": "The overlay does not generalize Linux-specific implementation choices into global system requirements."
    },
    {
      "requirement_id": "REQ-PROF-HA-033",
      "control": "The overlay does not require Kubernetes for endpoint profiles."
    },
    {
      "requirement_id": "REQ-PROF-HA-034",
      "control": "Public, private, administrative, recovery, artifact, and integration boundaries remain separated when present."
    },
    {
      "requirement_id": "REQ-PROF-HA-035",
      "control": "Service, node, workload, publisher, signer, artifact, tenant, and authority identities remain distinct."
    },
    {
      "requirement_id": "REQ-PROF-HA-036",
      "control": "Exceptions are registered, expiring, evidence-backed, and unable to waive constitutional controls."
    },
    {
      "requirement_id": "REQ-PROF-HA-037",
      "control": "The composed profile retains offline operation for every capability claimed as locally available."
    },
    {
      "requirement_id": "REQ-PROF-HA-038",
      "control": "Conformance evidence is current for the active authority release, target environment, profile composition, and artifact set."
    },
    {
      "requirement_id": "REQ-PROF-HA-039",
      "control": "A failed required control, test, or evidence check suspends the high-assurance claim."
    },
    {
      "requirement_id": "REQ-PROF-HA-040",
      "control": "The high-assurance claim has complete decision, requirement, lock, test, evidence, exception, component, profile, and release traceability."
    }
  ],
