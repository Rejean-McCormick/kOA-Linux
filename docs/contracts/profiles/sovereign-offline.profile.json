{
  "$schema": "../../schemas/deployment-profile.schema.json",
  "profile_id": "sovereign_offline",
  "profile_type": "deployment_profile_overlay",
  "version": "1.0.0",
  "status": "active",
  "language": "en",
  "effective_at": "2026-08-03T16:13:00-04:00",
  "owner": "deployment-architecture",
  "title": "Sovereign Offline Overlay",
  "description": "Adds a complete offline-sovereignty envelope to compatible sovereign base profiles. The overlay requires local authority, local policy evaluation, local trust, local audit, signed offline release import, atomic activation, local recovery, and operation without Internet or external AI dependencies.",
  "scope": {
    "kind": "profile_overlay",
    "applies_to": [
      "runtime",
      "governance",
      "identity",
      "audit",
      "release",
      "artifact_activation",
      "backup",
      "restore",
      "external_integrations",
      "network",
      "storage"
    ],
    "does_not_redefine": [
      "global_component_responsibilities",
      "global_data_ownership",
      "global_ai_boundary",
      "component_internal_interfaces",
      "artifact_serialization",
      "release_channel_identity"
    ]
  },
  "composition": {
    "overlay": true,
    "inheritance_is_explicit": true,
    "allowed_base_profiles": [
      "sovereign_linux_node",
      "sovereign_hub"
    ],
    "prohibited_base_profiles": [
      "user_lightweight",
      "developer_linux_workstation",
      "developer_windows_wsl",
      "build_farm",
      "control_plane"
    ],
    "compatible_overlays": [
      "high_assurance",
      "appliance_shell"
    ],
    "incompatible_overlays": [],
    "application_order": [
      "base_profile",
      "high_assurance_when_selected",
      "sovereign_offline",
      "appliance_shell_when_selected"
    ],
    "conflict_policy": {
      "strategy": "deny_ambiguous_composition",
      "overlay_may_only_restrict_or_add_within_declared_scope": true,
      "global_authority_cannot_be_overridden": true,
      "component_authority_cannot_be_merged": true,
      "unresolved_conflict_result": "blocked"
    }
  },
  "profile_claims": [
    {
      "claim_id": "CLAIM-PROFILE-SOV-OFF-001",
      "title": "Internet-independent core operation",
      "statement": "All capabilities required by the composed profile operate without Internet access.",
      "validation_test_ids": [
        "TEST-PROFILE-SOV-OFF-001"
      ],
      "evidence_ids": [
        "EVID-PROFILE-SOV-OFF-001"
      ]
    },
    {
      "claim_id": "CLAIM-PROFILE-SOV-OFF-002",
      "title": "Local authority",
      "statement": "Identity, policy, release, component, and data authority required for operation are locally resolvable.",
      "validation_test_ids": [
        "TEST-PROFILE-SOV-OFF-002"
      ],
      "evidence_ids": [
        "EVID-PROFILE-SOV-OFF-002"
      ]
    },
    {
      "claim_id": "CLAIM-PROFILE-SOV-OFF-003",
      "title": "Signed offline updates",
      "statement": "Updates enter through verified offline bundles and activate only as compatible release sets.",
      "validation_test_ids": [
        "TEST-PROFILE-SOV-OFF-003"
      ],
      "evidence_ids": [
        "EVID-PROFILE-SOV-OFF-003"
      ]
    },
    {
      "claim_id": "CLAIM-PROFILE-SOV-OFF-004",
      "title": "Local governed decisions",
      "statement": "Governed authorization, disclosure, consent, privilege, and exception decisions required by the profile are evaluated locally.",
      "validation_test_ids": [
        "TEST-PROFILE-SOV-OFF-004"
      ],
      "evidence_ids": [
        "EVID-PROFILE-SOV-OFF-004"
      ]
    },
    {
      "claim_id": "CLAIM-PROFILE-SOV-OFF-005",
      "title": "No external AI dependency",
      "statement": "The composed profile remains operational without ChatGPT, Suno, Gamma, external Ariane voice, or any other external AI service.",
      "validation_test_ids": [
        "TEST-PROFILE-SOV-OFF-005"
      ],
      "evidence_ids": [
        "EVID-PROFILE-SOV-OFF-005"
      ]
    },
    {
      "claim_id": "CLAIM-PROFILE-SOV-OFF-006",
      "title": "Local recovery and exit",
      "statement": "Backup, restore, rollback, forward repair, evidence export, and data export are executable from locally held artifacts and keys.",
      "validation_test_ids": [
        "TEST-PROFILE-SOV-OFF-006"
      ],
      "evidence_ids": [
        "EVID-PROFILE-SOV-OFF-006"
      ]
    }
  ],
