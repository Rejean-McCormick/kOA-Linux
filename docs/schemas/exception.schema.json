        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVID-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
          }
        }
      }
    }
  },
  "x-koa-semantic-checks": [
    "exception_id values are unique and never reused",
    "all decision_ids resolve to accepted owner decisions",
    "all affected requirement_ids and lock_ids resolve",
    "scope targets are concrete and contain no wildcard, global, or indefinite target",
    "the deviation does not affect non-waivable authority",
    "requester and approver are distinct when high-assurance or security-sensitive rules require separation",
    "risk owner and approver are named human identities",
    "all controls are concrete, assigned, testable, and evidenced",
    "an exception demonstrates equivalent or stronger satisfaction of requirement intent",
    "a waiver has remediation milestones and completion criteria",
    "waiver duration does not exceed 90 calendar days per approval",
    "waiver renewal count does not exceed one",
    "an exception duration does not exceed 365 calendar days or one major documentation version",
    "expires_at is later than created_at and activated_at",
    "approval timestamps and timing timestamps are consistent",
    "active deviations have current evidence and verified controls",
    "expired, revoked, suspended, or closed deviations do not authorize continued non-compliance",
    "scope does not inherit to another deployment, release, profile, component, artifact, or workspace",
    "release and conformance claims disclose every applicable active deviation",
    "waivers never allow unqualified conformance",
    "supersession links are bidirectional and acyclic",
    "lifecycle event order is valid for the declared status",
    "renewal requires a new accepted decision, updated risk assessment, fresh evidence, and remediation progress",
    "repeated or broadly required deviations trigger canonical requirement review",
    "AI-generated proposals remain unapproved until explicit human authorization is recorded"
  ]
}
