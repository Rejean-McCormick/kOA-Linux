      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "target_became_compliant",
            "capability_removed",
            "target_retired",
            "canonical_requirement_changed",
            "supported_alternative_activated",
            "superseded_by_new_deviation",
            "request_rejected"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 3000
        },
