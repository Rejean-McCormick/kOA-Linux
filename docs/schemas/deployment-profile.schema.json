{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koa.local/schemas/deployment-profile.schema.json",
  "title": "kOA Deployment Profile Schema",
  "description": "Validates a canonical kOA deployment profile or profile overlay. A primary profile is independently deployable. A profile overlay is composable, is never independently deployable, and may only strengthen or restrict compatible primary profiles. Profile files own profile membership, capabilities, constraints, composition, inheritance, conformance claims, and profile-scoped operational behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "profile_id",
    "profile_kind",
    "version",
    "status",
    "language",
    "display_name",
    "purpose",
    "terminology_ref",
    "canonical_refs",
    "decision_ids",
    "requirement_ids",
    "lock_ids",
    "independently_deployable",
    "composition",
    "inheritance",
    "target_environment",
    "hardware_envelope",
    "capabilities",
    "components",
    "operating_modes",
    "offline_behavior",
    "ai_boundary",
    "data_and_storage",
    "security",
    "lifecycle",
    "operations",
    "conformance",
    "validation"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../../schemas/deployment-profile.schema.json"
    },
    "profile_id": {
      "$ref": "#/$defs/profileId"
    },
    "profile_kind": {
      "$ref": "#/$defs/profileKind"
    },
    "version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "status": {
      "$ref": "#/$defs/activeLifecycleStatus"
    },
    "language": {
      "type": "string",
      "const": "en"
    },
    "display_name": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "purpose": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "terminology_ref": {
      "type": "string",
      "pattern": "^contracts/terminology\\.contract\\.json#/terms/TERM-PROFILE-[A-Z0-9-]+$"
    },
    "canonical_refs": {
      "$ref": "#/$defs/canonicalRefArray"
    },
    "decision_ids": {
      "$ref": "#/$defs/decisionIdArray"
    },
    "requirement_ids": {
      "$ref": "#/$defs/requirementIdArray"
    },
    "lock_ids": {
      "$ref": "#/$defs/lockIdArray"
    },
    "independently_deployable": {
      "type": "boolean"
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/profileVersionRef"
      },
      "default": []
    },
    "superseded_by": {
      "oneOf": [
        {
          "$ref": "#/$defs/profileVersionRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "composition": {
      "$ref": "#/$defs/composition"
    },
    "inheritance": {
      "$ref": "#/$defs/inheritance"
    },
    "target_environment": {
      "$ref": "#/$defs/targetEnvironment"
    },
    "hardware_envelope": {
      "$ref": "#/$defs/hardwareEnvelope"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilityMap"
    },
    "components": {
      "$ref": "#/$defs/componentMap"
    },
    "operating_modes": {
      "$ref": "#/$defs/operatingModes"
    },
    "offline_behavior": {
      "$ref": "#/$defs/offlineBehavior"
    },
    "ai_boundary": {
      "$ref": "#/$defs/aiBoundary"
    },
    "data_and_storage": {
      "$ref": "#/$defs/dataAndStorage"
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "operations": {
      "$ref": "#/$defs/operations"
    },
    "conformance": {
      "$ref": "#/$defs/conformance"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "koa_spaces": {
      "$ref": "#/$defs/koaSpacesProfileBinding"
    },
    "external_integrations": {
      "$ref": "#/$defs/externalIntegrations"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile_kind": {
            "const": "primary_profile"
          }
        },
        "required": [
          "profile_kind"
        ]
      },
      "then": {
        "properties": {
          "profile_id": {
            "enum": [
              "user_lightweight",
              "developer_linux_workstation",
              "developer_windows_wsl",
              "sovereign_linux_node",
              "sovereign_hub",
              "build_farm",
              "control_plane"
            ]
          },
          "independently_deployable": {
            "const": true
          },
          "composition": {
            "allOf": [
              {
                "$ref": "#/$defs/composition"
              },
              {
                "properties": {
                  "compatible_primary_profiles": {
                    "maxItems": 0
                  },
                  "composition_priority": {
                    "type": "null"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile_kind": {
            "const": "profile_overlay"
          }
        },
        "required": [
          "profile_kind"
        ]
      },
      "then": {
        "properties": {
          "profile_id": {
            "enum": [
              "high_assurance",
              "sovereign_offline",
              "appliance_shell"
            ]
          },
          "independently_deployable": {
            "const": false
          },
          "composition": {
            "allOf": [
              {
                "$ref": "#/$defs/composition"
              },
              {
                "properties": {
                  "compatible_primary_profiles": {
                    "minItems": 1
                  },
                  "composition_priority": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                }
              }
            ]
          },
          "inheritance": {
            "allOf": [
              {
                "$ref": "#/$defs/inheritance"
              },
              {
                "properties": {
                  "baseline_ref": {
                    "const": "contracts/system.contract.json#/system"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "superseded_by": {
            "$ref": "#/$defs/profileVersionRef"
          }
        },
        "required": [
          "superseded_by"
        ]
      },
      "else": {
        "properties": {
          "superseded_by": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "activeLifecycleStatus": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "superseded",
        "archived"
      ]
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:|/(?:[^~/]|~0|~1)*)$"
    },
    "canonicalRef": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+(?:#(?:|/(?:[^~/]|~0|~1)*))?$"
    },
    "canonicalRefArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/canonicalRef"
      }
    },
    "profileId": {
      "type": "string",
      "enum": [
        "user_lightweight",
        "developer_linux_workstation",
        "developer_windows_wsl",
        "sovereign_linux_node",
        "sovereign_hub",
        "build_farm",
        "control_plane",
        "high_assurance",
        "sovereign_offline",
        "appliance_shell"
      ]
    },
    "primaryProfileId": {
      "type": "string",
      "enum": [
        "user_lightweight",
        "developer_linux_workstation",
        "developer_windows_wsl",
        "sovereign_linux_node",
        "sovereign_hub",
        "build_farm",
        "control_plane"
      ]
    },
    "overlayProfileId": {
      "type": "string",
      "enum": [
        "high_assurance",
        "sovereign_offline",
        "appliance_shell"
      ]
    },
    "profileKind": {
      "type": "string",
      "enum": [
        "primary_profile",
        "profile_overlay"
      ]
    },
    "profileVersionRef": {
      "type": "string",
      "pattern": "^(?:user_lightweight|developer_linux_workstation|developer_windows_wsl|sovereign_linux_node|sovereign_hub|build_farm|control_plane|high_assurance|sovereign_offline|appliance_shell)@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^DEC-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3,}$"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3,}$"
    },
    "lockId": {
      "type": "string",
      "pattern": "^LOCK-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3,}$"
    },
    "testId": {
      "type": "string",
      "pattern": "^TEST-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3,}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^EVID-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3,}$"
    },
    "exceptionId": {
      "type": "string",
      "pattern": "^EXC-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3,}$"
    },
    "artifactClassId": {
      "type": "string",
      "pattern": "^ART-CLASS-[0-9]{3,}$"
    },
    "decisionIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/decisionId"
      }
    },
    "requirementIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/requirementId"
      }
    },
    "lockIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/lockId"
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible_primary_profiles",
        "required_overlays",
        "optional_overlays",
        "incompatible_profiles",
        "composition_priority",
        "conflict_policy"
      ],
      "properties": {
        "compatible_primary_profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/primaryProfileId"
          }
        },
        "required_overlays": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/overlayProfileId"
          }
        },
        "optional_overlays": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/overlayProfileId"
          }
        },
        "incompatible_profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/profileId"
          }
        },
        "composition_priority": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_policy": {
          "type": "string",
          "enum": [
            "fail_closed",
            "strongest_restriction_wins"
          ]
        },
        "required_host_properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operating_system_family",
            "local_graphical_seat",
            "wayland_capable",
            "local_input_available"
          ],
          "properties": {
            "operating_system_family": {
              "type": "string",
              "enum": [
                "linux",
                "windows",
                "wsl2",
                "container_host",
                "platform_independent"
              ]
            },
            "local_graphical_seat": {
              "type": "boolean"
            },
            "wayland_capable": {
              "type": "boolean"
            },
            "local_input_available": {
              "type": "boolean"
            }
          }
        },
        "required_base_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        }
      }
    },
    "inheritance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_ref",
        "inherits_global_requirements",
        "inherited_profile_refs",
        "override_policy",
        "prohibited_inheritance"
      ],
      "properties": {
        "baseline_ref": {
          "type": "string",
          "const": "contracts/system.contract.json#/system"
        },
        "inherits_global_requirements": {
          "type": "boolean",
          "const": true
        },
        "inherited_profile_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/profileVersionRef"
          }
        },
        "override_policy": {
          "type": "string",
          "enum": [
            "strengthen_or_restrict_only",
            "explicit_profile_replacement"
          ]
        },
        "prohibited_inheritance": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "implicit_profile_inheritance",
              "cross_profile_requirement_copy",
              "recipe_as_requirement",
              "implementation_prevalence_as_authority",
              "legacy_rule_without_disposition"
            ]
          }
        }
      }
    },
    "targetEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_os_families",
        "host_architectures",
        "deployment_forms",
        "network_expectation",
        "user_interaction",
        "virtualization",
        "containerization"
      ],
      "properties": {
        "host_os_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "linux",
              "windows",
              "wsl2",
              "container_host",
              "platform_independent"
            ]
          }
        },
        "host_architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "x86_64",
              "aarch64",
              "platform_independent"
            ]
          }
        },
        "deployment_forms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "desktop",
              "workstation",
              "node",
              "hub",
              "build_cluster",
              "control_service",
              "appliance",
              "virtualized_environment",
              "containerized_service_set"
            ]
          }
        },
        "network_expectation": {
          "type": "string",
          "enum": [
            "internet_optional",
            "internet_expected_but_not_authoritative",
            "disconnected_supported",
            "disconnected_required",
            "controlled_network_required"
          ]
        },
        "user_interaction": {
          "type": "string",
          "enum": [
            "interactive_end_user",
            "interactive_developer",
            "operator_managed",
            "service_only",
            "mixed"
          ]
        },
        "virtualization": {
          "type": "string",
          "enum": [
            "allowed",
            "required",
            "optional",
            "excluded"
          ]
        },
        "containerization": {
          "type": "string",
          "enum": [
            "allowed",
            "required",
            "optional",
            "excluded",
            "profile_specific"
          ]
        }
      }
    },
    "resourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "recommended",
        "unit"
      ],
      "properties": {
        "minimum": {
          "type": "number",
          "minimum": 0
        },
        "recommended": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "cores",
            "GiB",
            "GB",
            "workers",
            "jobs"
          ]
        }
      }
    },
    "hardwareEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory",
        "storage",
        "gpu",
        "concurrency",
        "enforcement"
      ],
      "properties": {
        "cpu": {
          "$ref": "#/$defs/resourceRange"
        },
        "memory": {
          "$ref": "#/$defs/resourceRange"
        },
        "storage": {
          "$ref": "#/$defs/resourceRange"
        },
        "gpu": {
          "type": "string",
          "enum": [
            "not_required",
            "integrated_sufficient",
            "optional_accelerator",
            "required_accelerator"
          ]
        },
        "concurrency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heavy_jobs",
            "background_workers"
          ],
          "properties": {
            "heavy_jobs": {
              "type": "integer",
              "minimum": 0
            },
            "background_workers": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "enforcement": {
          "type": "string",
          "enum": [
            "resource_governor_required",
            "resource_governor_recommended",
            "deployment_specific"
          ]
        }
      }
    },
    "capabilityState": {
      "type": "string",
      "enum": [
        "required",
        "optional",
        "conditional",
        "task_activated",
        "excluded"
      ]
    },
    "capabilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "conditions",
        "degraded_behavior",
        "rationale"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/capabilityState"
        },
        "conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "degraded_behavior": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requirement_ids": {
          "$ref": "#/$defs/requirementIdArray"
        },
        "lock_ids": {
          "$ref": "#/$defs/lockIdArray"
        }
      }
    },
    "capabilityMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/capabilityEntry"
      }
    },
    "componentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "activation",
        "data_authority",
        "failure_behavior"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/capabilityState"
        },
        "activation": {
          "type": "string",
          "enum": [
            "always_on",
            "service_activated",
            "socket_activated",
            "task_activated",
            "manual",
            "external",
            "not_installed"
          ]
        },
        "conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "data_authority": {
          "type": "string",
          "enum": [
            "component_owned",
            "read_only_projection",
            "gateway_mediated",
            "shared_contract_only",
            "none"
          ]
        },
        "failure_behavior": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "resource_envelope_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/canonicalRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "componentMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/componentEntry"
      }
    },
    "operatingModes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_mode",
        "allowed_modes",
        "transitions_fail_closed"
      ],
      "properties": {
        "default_mode": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "allowed_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "transitions_fail_closed": {
          "type": "boolean"
        }
      }
    },
    "offlineBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continuity_level",
        "internet_dependency",
        "offline_import",
        "offline_export",
        "recovery_without_internet",
        "unavailable_capabilities"
      ],
      "properties": {
        "continuity_level": {
          "type": "string",
          "enum": [
            "core_required",
            "declared_capabilities_only",
            "best_effort",
            "not_claimed"
          ]
        },
        "internet_dependency": {
          "type": "string",
          "enum": [
            "none_for_core",
            "optional_external_surfaces_only",
            "required_for_declared_non_core_capabilities"
          ]
        },
        "offline_import": {
          "type": "string",
          "enum": [
            "required",
            "supported",
            "not_supported"
          ]
        },
        "offline_export": {
          "type": "string",
          "enum": [
            "required",
            "supported",
            "not_supported"
          ]
        },
        "recovery_without_internet": {
          "type": "boolean"
        },
        "unavailable_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "aiBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_ai_dependency",
        "approved_external_surfaces",
        "optional_components",
        "authoritative_decisions_allowed",
        "fallback_behavior"
      ],
      "properties": {
        "native_ai_dependency": {
          "type": "boolean",
          "const": false
        },
        "approved_external_surfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "chatgpt",
              "suno",
              "gamma",
              "ariane-voice"
            ]
          }
        },
        "optional_components": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "sentient"
            ]
          }
        },
        "authoritative_decisions_allowed": {
          "type": "boolean",
          "const": false
        },
        "fallback_behavior": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "dataAndStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_data_ownership_required",
        "cross_component_direct_writes_allowed",
        "persistent_storage",
        "encryption_at_rest",
        "backup_required",
        "restore_required",
        "portability_export_required"
      ],
      "properties": {
        "component_data_ownership_required": {
          "type": "boolean",
          "const": true
        },
        "cross_component_direct_writes_allowed": {
          "type": "boolean",
          "const": false
        },
        "persistent_storage": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "minimal",
            "deployment_specific"
          ]
        },
        "encryption_at_rest": {
          "type": "string",
          "enum": [
            "required",
            "required_for_sensitive_data",
            "recommended",
            "deployment_specific"
          ]
        },
        "backup_required": {
          "type": "boolean"
        },
        "restore_required": {
          "type": "boolean"
        },
        "portability_export_required": {
          "type": "boolean"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trust_model",
        "privilege_model",
        "network_default",
        "secrets_management",
        "selective_audit",
        "break_glass",
        "required_controls"
      ],
      "properties": {
        "trust_model": {
          "type": "string",
          "enum": [
            "local_user_trust",
            "managed_node_trust",
            "sovereign_trust",
            "high_assurance_trust",
            "development_trust",
            "service_trust"
          ]
        },
        "privilege_model": {
          "type": "string",
          "enum": [
            "least_privilege",
            "narrow_privileged_broker",
            "development_host_managed",
            "no_host_mutation"
          ]
        },
        "network_default": {
          "type": "string",
          "enum": [
            "local_only",
            "closed_by_default",
            "controlled_egress",
            "development_permissive_with_isolation",
            "service_policy_controlled"
          ]
        },
        "secrets_management": {
          "type": "string",
          "enum": [
            "local_user_secret_store",
            "profile_secret_store",
            "external_secret_manager",
            "workspace_scoped_secrets",
            "deployment_specific"
          ]
        },
        "selective_audit": {
          "type": "boolean"
        },
        "break_glass": {
          "type": "string",
          "enum": [
            "required",
            "supported",
            "not_applicable"
          ]
        },
        "required_controls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "artifactRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class_id",
        "state",
        "release_channel",
        "activation_policy"
      ],
      "properties": {
        "artifact_class_id": {
          "$ref": "#/$defs/artifactClassId"
        },
        "state": {
          "$ref": "#/$defs/capabilityState"
        },
        "release_channel": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "system",
                "services",
                "governance",
                "knowledge"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "One profile-selected release channel when the artifact requirement is channel-specific; null when the artifact class is not release-channel-bound or spans multiple release channels."
        },
        "activation_policy": {
          "type": "string",
          "enum": [
            "atomic",
            "staged_atomic",
            "admission_then_activation",
            "not_activated"
          ]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_set_required",
        "system_update_model",
        "service_update_model",
        "rollback_required",
        "forward_repair_allowed",
        "offline_bundle_support",
        "artifact_requirements"
      ],
      "properties": {
        "release_set_required": {
          "type": "boolean"
        },
        "system_update_model": {
          "type": "string",
          "enum": [
            "atomic_image",
            "package_or_service_update",
            "development_environment_update",
            "external_platform_managed",
            "not_applicable"
          ]
        },
        "service_update_model": {
          "type": "string",
          "enum": [
            "independent_with_compatibility",
            "release_set_bound",
            "development_managed",
            "external_platform_managed",
            "not_applicable"
          ]
        },
        "rollback_required": {
          "type": "boolean"
        },
        "forward_repair_allowed": {
          "type": "boolean"
        },
        "offline_bundle_support": {
          "type": "string",
          "enum": [
            "required",
            "supported",
            "not_supported"
          ]
        },
        "artifact_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRequirement"
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health_monitoring",
        "readiness_checks",
        "resource_governor",
        "backup",
        "restore",
        "incident_response",
        "disaster_recovery",
        "maintenance",
        "diagnostics",
        "receipts_for_critical_transitions"
      ],
      "properties": {
        "health_monitoring": {
          "$ref": "#/$defs/capabilityState"
        },
        "readiness_checks": {
          "$ref": "#/$defs/capabilityState"
        },
        "resource_governor": {
          "$ref": "#/$defs/capabilityState"
        },
        "backup": {
          "$ref": "#/$defs/capabilityState"
        },
        "restore": {
          "$ref": "#/$defs/capabilityState"
        },
        "incident_response": {
          "$ref": "#/$defs/capabilityState"
        },
        "disaster_recovery": {
          "$ref": "#/$defs/capabilityState"
        },
        "maintenance": {
          "$ref": "#/$defs/capabilityState"
        },
        "diagnostics": {
          "$ref": "#/$defs/capabilityState"
        },
        "receipts_for_critical_transitions": {
          "type": "boolean"
        }
      }
    },
    "conformanceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "requirement_ids",
        "test_ids",
        "evidence_ids",
        "status"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^CLAIM-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3,}$"
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requirement_ids": {
          "$ref": "#/$defs/requirementIdArray"
        },
        "test_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/testId"
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceId"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "claimed",
            "verified",
            "failed",
            "not_applicable"
          ]
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_level",
        "claims",
        "exceptions",
        "evidence_required",
        "partial_conformance_allowed"
      ],
      "properties": {
        "claim_level": {
          "type": "string",
          "enum": [
            "baseline",
            "profile",
            "profile_with_overlays",
            "non_conformance_convenience"
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conformanceClaim"
          }
        },
        "exceptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exceptionId"
          }
        },
        "evidence_required": {
          "type": "boolean"
        },
        "partial_conformance_allowed": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_point",
        "required_checks",
        "failure_outcome",
        "missing_dependency_outcome",
        "automatic_semantic_repairs_allowed",
        "validated_at",
        "validation_status"
      ],
      "properties": {
        "entry_point": {
          "$ref": "#/$defs/repositoryPath"
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "profile_id_matches_filename",
              "profile_kind_matches_profile_id",
              "terminology_ref_resolves",
              "canonical_refs_resolve",
              "decision_ids_resolve_and_are_accepted",
              "requirement_ids_resolve",
              "lock_ids_resolve",
              "primary_profiles_are_independently_deployable",
              "overlays_are_not_independently_deployable",
              "overlay_compatibility_resolves",
              "composition_graph_is_acyclic",
              "required_and_optional_overlays_do_not_overlap",
              "incompatible_profiles_do_not_overlap_compatible_profiles",
              "inheritance_is_explicit",
              "profile_rules_do_not_become_global",
              "capability_states_are_valid",
              "component_states_are_valid",
              "component_data_ownership_is_preserved",
              "cross_component_direct_writes_are_disabled",
              "native_ai_dependency_is_false",
              "offline_claims_match_capability_states",
              "hardware_envelope_is_satisfiable",
              "artifact_class_refs_resolve",
              "release_channel_refs_resolve",
              "conformance_claims_are_traceable",
              "exceptions_resolve",
              "no_unresolved_authority_markers"
            ]
          }
        },
        "failure_outcome": {
          "type": "string",
          "const": "fail"
        },
        "missing_dependency_outcome": {
          "type": "string",
          "const": "blocked"
        },
        "automatic_semantic_repairs_allowed": {
          "type": "boolean",
          "const": false
        },
        "validated_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        }
      }
    },
    "koaSpacesProfileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subsystem_id",
        "contract_ref",
        "deployment_document_ref",
        "membership",
        "default_activation",
        "deployment_mode",
        "required_for_profile_conformance",
        "required_for_core_operation",
        "authority",
        "presentation_grants_authority",
        "menu_visibility_is_authorization",
        "offline_behavior",
        "failure_behavior",
        "constraints"
      ],
      "properties": {
        "subsystem_id": {
          "const": "koa_spaces"
        },
        "contract_ref": {
          "const": "contracts/subsystems/koa-spaces.subsystem.json"
        },
        "deployment_document_ref": {
          "const": "03-profiles/14-koa-spaces-deployment.md"
        },
        "membership": {
          "enum": [
            "optional",
            "optional_development_workbench",
            "inherited_optional_with_offline_restrictions",
            "inherited_optional_with_assurance_controls",
            "optional_primary_presentation_surface"
          ]
        },
        "default_activation": {
          "type": "string",
          "minLength": 1
        },
        "deployment_mode": {
          "type": "string",
          "minLength": 1
        },
        "required_for_profile_conformance": {
          "const": false
        },
        "required_for_core_operation": {
          "const": false
        },
        "authority": {
          "const": "non_authoritative_presentation"
        },
        "presentation_grants_authority": {
          "const": false
        },
        "menu_visibility_is_authorization": {
          "const": false
        },
        "offline_behavior": {
          "type": "string",
          "minLength": 1
        },
        "failure_behavior": {
          "const": "presentation_unavailable_authoritative_services_and_fallback_paths_preserved"
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "externalIntegrationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration_id",
        "contract_ref",
        "availability",
        "direction"
      ],
      "properties": {
        "integration_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "contract_ref": {
          "$ref": "#/$defs/repositoryPath"
        },
        "availability": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "conditional",
            "prohibited",
            "not_applicable"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "inbound",
            "outbound",
            "bidirectional"
          ]
        },
        "required_for_local_operation": {
          "type": "boolean"
        },
        "required_for_offline_operation": {
          "type": "boolean"
        },
        "offline_bundle_supported": {
          "type": "boolean"
        },
        "accepted_content_available_offline": {
          "type": "boolean"
        },
        "automatic_sync": {
          "type": "boolean"
        }
      }
    },
    "externalIntegrations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/externalIntegrationBinding"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
      }
    }
  }
}
