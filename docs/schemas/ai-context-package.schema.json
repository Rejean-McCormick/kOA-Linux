      "const": "generated_ai_context"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "const": "active"
    },
    "language": {
      "const": "en"
    },
    "generated": {
      "const": true
    },
    "authority": {
      "type": "object"
    },
    "generator": {
      "type": "object"
    },
    "scope": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
