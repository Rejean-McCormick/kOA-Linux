    "non_goals": [
      "acting as a general developer workstation",
      "running unreviewed development workbenches",
      "hosting native AI models",
      "providing cluster orchestration",
      "using a shared mutable host as a build environment",
      "requiring a minimal appliance shell",
      "requiring measured boot or TPM without an overlay or hardware tier",
      "granting application components unrestricted host privilege"
    ]
