      "fail-closed authority",
      "least privilege",
      "single-owner data domains",
      "closed-by-default network exposure",
      "offline continuity",
      "selective audit",
      "machine-readable critical-transition receipts",
      "tested backup, restore, portability, and exit",
      "replaceable optional integrations"
