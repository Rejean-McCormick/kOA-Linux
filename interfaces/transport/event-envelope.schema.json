{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/interfaces/transport/event-envelope.schema.json",
  "title": "kOA Event Envelope",
  "description": "Common transport envelope for a versioned cross-component domain event. It identifies a fact already committed by its publishing owner. Delivery of the envelope does not authorize the original mutation, transfer ownership, or grant a consumer authority over another component.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "semantic_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "component_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/identifier"
        },
        "instance_id": {
          "$ref": "#/$defs/identifier"
        },
        "profile_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "receiver_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identifier"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "component",
            "capability",
            "subscription",
            "topic"
          ]
        },
        "identifier": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "interface_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface_id",
        "interface_version"
      ],
      "properties": {
        "interface_id": {
          "$ref": "#/$defs/identifier"
        },
        "interface_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "contract_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "correlation_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation_id"
      ],
      "properties": {
        "correlation_id": {
          "$ref": "#/$defs/identifier"
        },
        "causation_id": {
          "$ref": "#/$defs/identifier"
        },
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "trace_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "payload_representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "schema_ref",
        "schema_version"
      ],
      "properties": {
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:\\s*;\\s*[A-Za-z0-9!#$&^_.+-]+=[^;]+)*$"
        },
        "schema_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "schema_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "encoding": {
          "type": "string",
          "enum": [
            "identity",
            "base64",
            "uri_reference"
          ]
        },
        "content_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "release_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_set_id": {
          "$ref": "#/$defs/identifier"
        },
        "sender_release": {
          "$ref": "#/$defs/semantic_version"
        },
        "receiver_release": {
          "$ref": "#/$defs/semantic_version"
        }
      },
      "minProperties": 1
    },
    "evidence_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      },
      "minProperties": 1
    }
  },
  "required": [
    "schema_version",
    "envelope_type",
    "message_id",
    "event_id",
    "event_type",
    "event_version",
    "interface",
    "publisher",
    "intended_receivers",
    "correlation",
    "occurred_at",
    "committed_at",
    "payload_representation",
    "payload",
    "ordering",
    "replay",
    "disclosure",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "envelope_type": {
      "type": "string",
      "const": "domain_event"
    },
    "message_id": {
      "$ref": "#/$defs/identifier"
    },
    "event_id": {
      "$ref": "#/$defs/identifier"
    },
    "event_type": {
      "$ref": "#/$defs/identifier"
    },
    "event_version": {
      "$ref": "#/$defs/semantic_version"
    },
    "interface": {
      "$ref": "#/$defs/interface_reference"
    },
    "publisher": {
      "$ref": "#/$defs/component_endpoint"
    },
    "intended_receivers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/receiver_selector"
      }
    },
    "correlation": {
      "$ref": "#/$defs/correlation_context"
    },
    "occurred_at": {
      "$ref": "#/$defs/timestamp"
    },
    "committed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "payload_representation": {
      "$ref": "#/$defs/payload_representation"
    },
    "payload": {},
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "sequence"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "partition_key": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "duplicate_handling"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "original",
            "replay"
          ]
        },
        "duplicate_handling": {
          "type": "string",
          "enum": [
            "ignore_if_applied",
            "return_current_state",
            "rebuild_projection",
            "reject_duplicate"
          ]
        },
        "original_message_id": {
          "$ref": "#/$defs/identifier"
        },
        "replayed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "replay_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "replay"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "original_message_id",
              "replayed_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "original"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "original_message_id"
                  ]
                },
                {
                  "required": [
                    "replayed_at"
                  ]
                },
                {
                  "required": [
                    "replay_reason"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_consumer_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "release_context": {
          "$ref": "#/$defs/release_context"
        }
      },
      "minProperties": 1
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "payload_minimized"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "public_summary",
            "tenant_visible",
            "operator_restricted",
            "security_restricted",
            "evidence_restricted"
          ]
        },
        "payload_minimized": {
          "const": true
        },
        "redaction_applied": {
          "type": "boolean"
        }
      }
    },
    "evidence": {
      "$ref": "#/$defs/evidence_context"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "publisher_owns_fact",
        "grants_mutation_authority",
        "transfers_ownership"
      ],
      "properties": {
        "effect": {
          "const": "committed_fact_evidence"
        },
        "publisher_owns_fact": {
          "const": true
        },
        "grants_mutation_authority": {
          "const": false
        },
        "transfers_ownership": {
          "const": false
        }
      }
    }
  }
}
