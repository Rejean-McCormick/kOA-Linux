{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/interfaces/transport/error-envelope.schema.json",
  "title": "kOA Error Envelope",
  "description": "Common machine-readable error envelope for cross-component communication. It reports a bounded failure without treating transport success, failure, or reachability as authorization or proof of authoritative commit.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "semantic_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "component_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/identifier"
        },
        "instance_id": {
          "$ref": "#/$defs/identifier"
        },
        "profile_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "receiver_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identifier"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "component",
            "capability",
            "subscription",
            "topic"
          ]
        },
        "identifier": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "interface_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface_id",
        "interface_version"
      ],
      "properties": {
        "interface_id": {
          "$ref": "#/$defs/identifier"
        },
        "interface_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "contract_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "correlation_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation_id"
      ],
      "properties": {
        "correlation_id": {
          "$ref": "#/$defs/identifier"
        },
        "causation_id": {
          "$ref": "#/$defs/identifier"
        },
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "trace_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "payload_representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "schema_ref",
        "schema_version"
      ],
      "properties": {
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:\\s*;\\s*[A-Za-z0-9!#$&^_.+-]+=[^;]+)*$"
        },
        "schema_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "schema_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "encoding": {
          "type": "string",
          "enum": [
            "identity",
            "base64",
            "uri_reference"
          ]
        },
        "content_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "release_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_set_id": {
          "$ref": "#/$defs/identifier"
        },
        "sender_release": {
          "$ref": "#/$defs/semantic_version"
        },
        "receiver_release": {
          "$ref": "#/$defs/semantic_version"
        }
      },
      "minProperties": 1
    },
    "evidence_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      },
      "minProperties": 1
    }
  },
  "required": [
    "schema_version",
    "envelope_type",
    "error_id",
    "error_code",
    "error_class",
    "message",
    "interface",
    "producer",
    "intended_receiver",
    "correlation",
    "occurred_at",
    "outcome",
    "retry",
    "disclosure",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "envelope_type": {
      "type": "string",
      "const": "error"
    },
    "error_id": {
      "$ref": "#/$defs/identifier"
    },
    "error_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,127}$"
    },
    "error_class": {
      "type": "string",
      "enum": [
        "validation",
        "authentication",
        "authorization",
        "policy",
        "compatibility",
        "conflict",
        "not_found",
        "rate_limit",
        "resource",
        "timeout",
        "dependency",
        "transport",
        "internal",
        "indeterminate_outcome"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9][A-Z0-9_.-]{1,127}$"
      }
    },
    "interface": {
      "$ref": "#/$defs/interface_reference"
    },
    "producer": {
      "$ref": "#/$defs/component_endpoint"
    },
    "intended_receiver": {
      "$ref": "#/$defs/receiver_selector"
    },
    "correlation": {
      "$ref": "#/$defs/correlation_context"
    },
    "occurred_at": {
      "$ref": "#/$defs/timestamp"
    },
    "payload_representation": {
      "$ref": "#/$defs/payload_representation"
    },
    "release_context": {
      "$ref": "#/$defs/release_context"
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "finality",
        "authoritative_effect"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "rejected",
            "blocked",
            "failed",
            "expired",
            "cancelled",
            "indeterminate"
          ]
        },
        "finality": {
          "type": "string",
          "enum": [
            "final",
            "non_final",
            "indeterminate"
          ]
        },
        "authoritative_effect": {
          "type": "string",
          "enum": [
            "none",
            "unchanged",
            "unknown_requires_resolution"
          ]
        },
        "status_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "indeterminate"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "finality": {
                "const": "indeterminate"
              },
              "authoritative_effect": {
                "const": "unknown_requires_resolution"
              }
            },
            "required": [
              "status_ref"
            ]
          }
        }
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "strategy"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "strategy": {
          "type": "string",
          "enum": [
            "none",
            "immediate",
            "bounded_backoff",
            "status_resolution",
            "manual_intervention"
          ]
        },
        "after_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "idempotency_required": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allowed": {
                "const": false
              }
            },
            "required": [
              "allowed"
            ]
          },
          "then": {
            "properties": {
              "strategy": {
                "const": "none"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "after_seconds"
                  ]
                },
                {
                  "required": [
                    "maximum_attempts"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "bounded_backoff"
              }
            },
            "required": [
              "strategy"
            ]
          },
          "then": {
            "required": [
              "after_seconds",
              "maximum_attempts"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "status_resolution"
              }
            },
            "required": [
              "strategy"
            ]
          },
          "then": {
            "properties": {
              "idempotency_required": {
                "const": true
              }
            },
            "required": [
              "idempotency_required"
            ]
          }
        }
      ]
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field_violations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "code"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,127}$"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        },
        "dependency_ref": {
          "$ref": "#/$defs/identifier"
        },
        "expected_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "received_version": {
          "$ref": "#/$defs/semantic_version"
        }
      },
      "minProperties": 1
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "payload_minimized",
        "contains_secrets"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "public_summary",
            "tenant_visible",
            "operator_restricted",
            "security_restricted",
            "evidence_restricted"
          ]
        },
        "payload_minimized": {
          "const": true
        },
        "contains_secrets": {
          "const": false
        }
      }
    },
    "evidence": {
      "$ref": "#/$defs/evidence_context"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport_grants_authority",
        "error_grants_authority",
        "transfers_ownership"
      ],
      "properties": {
        "transport_grants_authority": {
          "const": false
        },
        "error_grants_authority": {
          "const": false
        },
        "transfers_ownership": {
          "const": false
        }
      }
    }
  }
}
