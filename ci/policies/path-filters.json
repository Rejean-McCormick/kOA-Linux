{
  "description": "Impact-routing inputs for local and hosted validation. Required workflows still always emit their check contexts.",
  "filters": [
    {
      "check_id": "documentation",
      "exclude": [],
      "include": [
        ".github/**",
        ".koa/**",
        "*.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "LICENSES/**",
        "NOTICE.md",
        "README.md",
        "REUSE.toml",
        "SECURITY.md",
        "ci/**",
        "docs/**",
        "generated/**",
        "pyproject.toml",
        "tools/**",
        "uv.lock"
      ]
    },
    {
      "check_id": "contracts",
      "exclude": [],
      "include": [
        ".github/**",
        ".koa/**",
        "assembly/**",
        "ci/**",
        "components/**/component.toml",
        "components/**/pyproject.toml",
        "dev/fixtures/**",
        "docs/contracts/**",
        "docs/schemas/**",
        "generated/**",
        "integrations/**",
        "interfaces/**",
        "packaging/**",
        "profiles/**",
        "pyproject.toml",
        "release/**",
        "tests/contracts/**",
        "tests/fixtures/**",
        "tools/**",
        "uv.lock"
      ]
    },
    {
      "check_id": "components",
      "exclude": [],
      "include": [
        ".github/**",
        ".koa/**",
        ".python-version",
        ".rustfmt.toml",
        "Cargo.lock",
        "Cargo.toml",
        "assembly/**",
        "ci/**",
        "components/**",
        "dev/**",
        "docs/**",
        "generated/**",
        "host/**",
        "integrations/**",
        "interfaces/**",
        "operations/**",
        "packaging/**",
        "profiles/**",
        "pyproject.toml",
        "release/**",
        "rust-toolchain.toml",
        "tests/**",
        "tools/**",
        "uv.lock"
      ]
    }
  ],
  "global_invalidators": [
    ".github/**",
    ".koa/**",
    "ci/**",
    "docs/AI_CONTEXT.md",
    "docs/contracts/ai-navigation.contract.json",
    "docs/contracts/system.contract.json",
    "docs/contracts/terminology.contract.json",
    "docs/generated/**",
    "generated/**",
    "pyproject.toml",
    "tools/**",
    "uv.lock"
  ],
  "matching": {
    "case_sensitive": true,
    "default_checks": [
      "documentation",
      "contracts",
      "components"
    ],
    "first_match_wins": false,
    "syntax": "gitignore-style repository-relative glob",
    "unknown_path_action": "run_all",
    "workflow_trigger_filtering_allowed": false
  },
  "policy_id": "koa.path-filters",
  "policy_version": "1.0.0",
  "root_coverage": {
    "inventory_source": [
      "docs/02-system/code-and-filesystem-architecture/24-repository-root-and-documentation.md",
      "docs/02-system/code-and-filesystem-architecture/25-internal-components-node-trust-governance.md",
      "docs/02-system/code-and-filesystem-architecture/26-internal-components-data-publication-and-knowledge.md",
