{
  "checks": [
    {
      "check_id": "documentation",
      "display_name": "Documentation",
      "job_id": "documentation",
      "job_name": "documentation",
      "local_commands": [
        [
          "uv",
          "sync",
          "--frozen",
          "--all-groups"
        ],
        [
          "uv",
          "run",
          "--frozen",
          "python",
          "docs/tools/validate_docs.py"
        ]
      ],
      "network_after_sync": "forbidden",
      "produces_release_authority": false,
      "required_context": "CI / Documentation / documentation",
      "required_for": [
        "merge_group",
        "pull_request"
      ],
      "workflow_file": ".github/workflows/documentation.yml",
      "workflow_name": "CI / Documentation"
    },
    {
