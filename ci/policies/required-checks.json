  "description": "Stable merge-check identities and their exact repository-local commands.",
  "execution_policy": {
    "accepted_conclusions": [
      "success"
    ],
    "all_checks_always_report": true,
    "blocked_is_success": false,
    "cancelled_is_success": false,
    "dependency_installation": [
      "uv",
      "sync",
      "--frozen",
      "--all-groups"
    ],
    "failure_is_success": false,
    "neutral_is_success": false,
    "path_filters_control": "test selection only; never workflow creation or required-check emission",
    "skipped_is_success": false,
    "timed_out_is_success": false,
    "working_directory": "."
  },
  "policy_id": "koa.required-checks",
  "policy_version": "1.0.0",
  "status": "active"
