# kOA generated independent-subsystem service template.
# Identity, paths, network and capability values MUST come from the admitted
# subsystem boundary and active profile. The template supplies no fallback.

[Unit]
Description={{DESCRIPTION}}
Documentation={{DOCUMENTATION_URI}}
Requires=koa-release-set-verify.service
After=local-fs.target systemd-tmpfiles-setup.service koa-release-set-verify.service
{{UNIT_DEPENDENCY_LINES}}
ConditionPathExists=/etc/koa/active/release-set.json
ConditionPathExists={{CONFIG_PATH}}
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type={{SERVICE_TYPE}}
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}
EnvironmentFile={{ENVIRONMENT_FILE}}
ExecStart={{EXEC_START}}
Restart=on-failure
RestartSec=15s
TimeoutStartSec=120s
TimeoutStopSec=60s
KillSignal=SIGTERM
KillMode=mixed
UMask=0027

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices={{PRIVATE_DEVICES}}
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute={{MEMORY_DENY_WRITE_EXECUTE}}
RemoveIPC=yes
RestrictNamespaces={{RESTRICT_NAMESPACES}}
RestrictAddressFamilies={{ADDRESS_FAMILIES}}
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet={{CAPABILITY_BOUNDING_SET}}
AmbientCapabilities={{AMBIENT_CAPABILITIES}}

ReadWritePaths={{STATE_PATH}}
ReadOnlyPaths=/etc/koa
ReadOnlyPaths=/usr/lib/koa
{{ADDITIONAL_PATH_LINES}}
{{NETWORK_POLICY_LINES}}

StandardOutput=journal
StandardError=journal
SyslogIdentifier={{SYSLOG_IDENTIFIER}}

[Install]
WantedBy={{WANTED_BY}}
