# kOA generated component service template.
# The assembly renderer MUST replace every declared template token and reject unknown,
# empty, multiline or systemd-unescaped values except *_LINES tokens.

[Unit]
Description={{DESCRIPTION}}
Documentation={{DOCUMENTATION_URI}}
Requires=koa-release-set-verify.service
After=local-fs.target systemd-tmpfiles-setup.service koa-release-set-verify.service
{{UNIT_DEPENDENCY_LINES}}
ConditionPathExists=/etc/koa/active/release-set.json
ConditionPathExists={{CONFIG_PATH}}
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=notify
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}
EnvironmentFile={{ENVIRONMENT_FILE}}
ExecStart={{EXEC_START}}
{{EXEC_RELOAD_LINE}}
Restart=on-failure
RestartSec=10s
TimeoutStartSec=90s
TimeoutStopSec=45s
KillSignal=SIGTERM
KillMode=mixed
NotifyAccess=main
UMask=0027

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

ReadWritePaths={{STATE_PATH}}
ReadOnlyPaths=/etc/koa
ReadOnlyPaths=/usr/lib/koa
{{ADDITIONAL_PATH_LINES}}

StandardOutput=journal
StandardError=journal
SyslogIdentifier={{SYSLOG_IDENTIFIER}}

[Install]
WantedBy={{WANTED_BY}}
