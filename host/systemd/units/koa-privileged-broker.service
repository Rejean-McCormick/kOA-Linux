[Unit]
Description=kOA closed privileged host-operation broker
Requires=koa-privileged-broker.socket koa-release-set-verify.service
After=local-fs.target systemd-tmpfiles-setup.service koa-release-set-verify.service koa-privileged-broker.socket
Before=koa-node-agent.service
Conflicts=koa-recovery.target
ConditionPathExists=/usr/libexec/koa/koa-privileged-broker
ConditionPathExists=/etc/koa/active/profile.json
ConditionPathExists=/etc/koa/active/release-set.json
ConditionPathExists=/etc/koa/node/privileged-operation-catalog.json
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=exec
User=root
Group=koa-privileged-broker
ExecStart=/usr/libexec/koa/koa-privileged-broker
Restart=on-failure
RestartSec=3s
TimeoutStartSec=60s
TimeoutStopSec=45s
KillSignal=SIGTERM
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount @reboot
SystemCallFilter=~@obsolete @debug @cpu-emulation @module @raw-io
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_NET_ADMIN CAP_SETGID CAP_SETUID CAP_SYS_ADMIN CAP_SYS_BOOT
AmbientCapabilities=
IPAddressDeny=any
ReadWritePaths=/etc/koa/active
ReadWritePaths=/run/koa/activation
ReadWritePaths=/run/koa/recovery
ReadWritePaths=/run/koa/locks
ReadWritePaths=/var/lib/koa/node
ReadWritePaths=/var/lib/koa/releases
ReadWritePaths=/var/lib/koa/quarantine
ReadWritePaths=/var/lib/koa/offline-import
ReadWritePaths=/var/lib/koa/backups
ReadWritePaths=/var/lib/koa/recovery
ReadWritePaths=/var/lib/koa-recovery
ReadOnlyPaths=/etc/koa/node
ReadOnlyPaths=/etc/koa/trust
ReadOnlyPaths=/usr/lib/koa
StandardOutput=journal
StandardError=journal
SyslogIdentifier=koa-privileged-broker
