[Unit]
Description=Run one policy-bounded kOA backup transaction
Requires=koa-release-set-verify.service koa-node-agent.socket
After=koa-critical.target koa-release-set-verify.service koa-node-agent.socket
Conflicts=koa-activation.service koa-recovery.target
ConditionPathExists=/usr/libexec/koa/koa-backup
ConditionPathExists=/etc/koa/active/profile.json
ConditionPathExists=/etc/koa/active/release-set.json
ConditionPathExists=/etc/koa/backup/policy.toml

[Service]
Type=oneshot
User=koa-backup
Group=koa-backup
SupplementaryGroups=koa-node-agent
ExecStart=/usr/libexec/koa/koa-backup
TimeoutStartSec=2h
StateDirectory=koa/backups
StateDirectoryMode=0750
ReadWritePaths=/var/lib/koa/backups
ReadOnlyPaths=/etc/koa
ReadOnlyPaths=/usr/lib/koa
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @debug @cpu-emulation
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
DevicePolicy=closed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=koa-backup
