[Unit]
Description=Verify the complete active kOA Release Set
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service
Before=koa-critical.target koa-core.target koa-background.target koa-activation.target
ConditionPathExists=/usr/libexec/koa/koa-activation
ConditionPathExists=/etc/koa/active/profile.json
ConditionPathExists=/etc/koa/active/release-set.json
ConditionPathExists=/etc/koa/trust/policy.toml

[Service]
Type=oneshot
User=koa-node-agent
Group=koa-node-agent
ExecStart=/usr/libexec/koa/koa-activation --verify-only
RemainAfterExit=yes
TimeoutStartSec=5min
StateDirectory=koa/node
StateDirectoryMode=0750
RuntimeDirectory=koa/activation
RuntimeDirectoryMode=0750
ReadWritePaths=/var/lib/koa/node/activation-receipts
ReadWritePaths=/run/koa/activation
ReadOnlyPaths=/etc/koa
ReadOnlyPaths=/usr/lib/koa
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @debug @cpu-emulation
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
DevicePolicy=closed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=koa-release-set-verify

[Install]
WantedBy=koa-critical.target
