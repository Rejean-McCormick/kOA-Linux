[Unit]
Description=Quarantine and verify one bounded kOA offline import batch
Requires=koa-release-set-verify.service koa-node-agent.socket
After=koa-release-set-verify.service koa-node-agent.socket
Conflicts=koa-activation.service koa-recovery.target
ConditionPathExists=/usr/libexec/koa/koa-offline-import
ConditionPathExists=/etc/koa/active/profile.json
ConditionPathExists=/etc/koa/active/release-set.json
ConditionPathIsDirectory=/var/lib/koa/offline-import/quarantine

[Service]
Type=oneshot
User=koa-import
Group=koa-import
SupplementaryGroups=koa-node-agent
ExecStart=/usr/libexec/koa/koa-offline-import
TimeoutStartSec=30min
StateDirectory=koa/offline-import
StateDirectoryMode=0750
ReadWritePaths=/var/lib/koa/offline-import
ReadWritePaths=/var/lib/koa/node
ReadOnlyPaths=/etc/koa
ReadOnlyPaths=/usr/lib/koa
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @debug @cpu-emulation
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
DevicePolicy=closed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=koa-offline-import
