[Unit]
Description=kOA Node Agent unprivileged request validator and coordinator
Requires=koa-node-agent.socket koa-release-set-verify.service
Wants=koa-privileged-broker.socket
After=local-fs.target systemd-tmpfiles-setup.service koa-release-set-verify.service koa-privileged-broker.socket
Before=koa-core.target koa-background.target
Conflicts=koa-recovery.target
ConditionPathExists=/usr/libexec/koa/koa-node-agent
ConditionPathExists=/etc/koa/active/profile.json
ConditionPathExists=/etc/koa/active/release-set.json
ConditionPathExists=/etc/koa/node/config.toml
ConditionPathExists=/etc/koa/node/privileged-operation-catalog.json
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=exec
User=koa-node-agent
Group=koa-node-agent
ExecStart=/usr/libexec/koa/koa-node-agent
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=45s
KillSignal=SIGTERM
KillMode=mixed
StateDirectory=koa/node
StateDirectoryMode=0750
ReadWritePaths=/var/lib/koa/node
ReadWritePaths=/run/koa/health
ReadWritePaths=/run/koa/locks
ReadOnlyPaths=/etc/koa
ReadOnlyPaths=/usr/lib/koa
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @debug @cpu-emulation
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
DevicePolicy=closed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=koa-node-agent

[Install]
WantedBy=koa-critical.target
