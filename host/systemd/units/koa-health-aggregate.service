[Unit]
Description=Aggregate bounded kOA health and readiness state
Requires=koa-release-set-verify.service
After=koa-critical.target koa-release-set-verify.service
Conflicts=koa-recovery.target
ConditionPathExists=/usr/libexec/koa/koa-health-aggregate
ConditionPathExists=/etc/koa/active/profile.json
ConditionPathExists=/etc/koa/active/release-set.json
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=exec
User=koa-node-agent
Group=koa-node-agent
ExecStart=/usr/libexec/koa/koa-health-aggregate
Restart=on-failure
RestartSec=10s
TimeoutStartSec=90s
TimeoutStopSec=30s
RuntimeDirectory=koa/health
RuntimeDirectoryMode=0750
ReadWritePaths=/run/koa/health
ReadOnlyPaths=/run/koa/sockets
ReadOnlyPaths=/etc/koa
ReadOnlyPaths=/usr/lib/koa
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @debug @cpu-emulation
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
DevicePolicy=closed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=koa-health-aggregate

[Install]
WantedBy=koa-background.target
