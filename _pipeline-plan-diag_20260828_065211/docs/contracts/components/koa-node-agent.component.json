  "profile_relationship": {
    "membership_owner": "generated/profile-catalog.json",
    "profile_contracts_may_require_or_allow_component": true,
    "component_contract_may_not_infer_profile_membership": true,
    "known_required_profile_refs": [
      "contracts/profiles/control-plane.profile.json"
    ],
    "node_local_authority_is_preserved_when_control_plane_is_unavailable": true,
    "implementation_is_profile_scoped": true
  },
  "purpose": {
    "primary": "Provide a single narrow, node-local path for profile-authorized sensitive host mutations and lifecycle transitions.",
    "outcomes": [
      "closed_privileged_operation_surface",
      "node_local_validation",
      "atomic_activation",
      "idempotent_execution",
      "machine_readable_receipts",
      "rollback_and_forward_repair",
      "offline_bundle_admission",
      "control_plane_authority_containment"
    ],
    "non_goals": [
      "arbitrary_remote_administration",
      "generic_shell_execution",
      "generic_service_manager",
      "generic_file_transfer",
      "generic_package_manager",
      "generic_container_execution",
      "unrestricted_device_control",
      "raw_private_key_export",
      "application_data_ownership",
      "policy_decision",
      "release_content_definition",
      "native_or_external_ai_control"
    ]
  },
  "responsibilities": {
    "required": [
      {
        "responsibility_id": "validate_closed_operation_requests",
        "description": "Validate operation class, request schema, caller identity, profile permission, policy decision, decision expiry, expected state, artifacts, compatibility, replay state, timeout, and resource conditions."
      },
      {
        "responsibility_id": "preserve_node_local_authority",
        "description": "Perform final node-local validation and reject control-plane or local requests that do not satisfy active node contracts."
      },
      {
        "responsibility_id": "stage_verified_artifacts",
        "description": "Place validated artifacts in profile-declared staging or quarantine locations without partial activation."
      },
      {
        "responsibility_id": "execute_atomic_activation",
        "description": "Activate complete compatible system, services, governance, and knowledge artifacts through an atomic, transactional, immutable-slot, or equivalent path."
      },
      {
        "responsibility_id": "execute_declared_recovery",
        "description": "Rollback, revert, restore, or perform forward repair according to the artifact class and failed-transition contract."
      },
      {
        "responsibility_id": "operate_declared_host_resources",
        "description": "Perform only allowlisted encrypted-volume, service-group, recovery-target, and node-key operations."
      },
      {
        "responsibility_id": "enforce_idempotency_and_replay_protection",
        "description": "Return the recorded result for an equivalent repeated request and reject request-identity reuse with a different canonical request body."
      },
      {
        "responsibility_id": "produce_operation_receipts",
        "description": "Produce machine-readable receipts with request, caller, authorization, before and after state, artifact identities, result, reason, duration, and recovery information."
      },
      {
        "responsibility_id": "report_bounded_health",
        "description": "Expose node-agent readiness, operation state, staging capacity, recovery state, and integrity alarms without exposing secrets or application data."
      },
      {
        "responsibility_id": "support_disconnected_node_operation",
        "description": "Continue node-local validation, previously authorized local operation, recovery, and verified offline import when the active profile permits them."
      }
    ],
    "prohibited": [
      "arbitrary_shell_execution",
      "arbitrary_systemd_or_service_manager_control",
      "arbitrary_file_copy_or_path_traversal",
      "arbitrary_container_image_or_argument_execution",
      "generic_package_manager_access",
      "unrestricted_device_access",
      "raw_private_key_export",
      "direct_application_database_write",
      "policy_authority_inference",
      "release_compatibility_inference",
      "profile_membership_inference",
      "silent_provider_artifact_or_node_substitution",
      "native_or_external_ai_operation_selection"
    ]
  },
  "authority_model": {
    "component_authority": [
      "accept_or_reject_node_operation_request",
      "maintain_node_agent_idempotency_state",
      "maintain_node_local_staging_state",
      "execute_profile_authorized_host_mutation",
      "execute_node_local_activation_and_recovery",
      "produce_node_operation_receipts",
      "report_node_agent_health_and_execution_state"
    ],
    "external_authority_dependencies": {
      "owning_component": [
        "ordinary_application_operation_authority",
        "requested_application_transition_semantics"
      ],
      "governance_policy_runtime": [
        "sensitive_host_mutation_authorization",
        "break_glass_authorization",
        "disclosure_and_evidence_export_authorization"
      ],
      "identity_and_trust": [
        "caller_identity",
        "artifact_signer_identity",
        "trust_root_validation",
        "revocation_state"
      ],
      "artifact_and_release_contracts": [
        "artifact_class",
        "artifact_identity",
        "manifest",
        "release_channel",
        "release_set_compatibility",
        "activation_and_recovery_strategy"
      ],
      "profile_contract": [
        "operation_availability",
        "implementation_path",
        "hardware_and_storage_requirements",
        "offline_and_recovery_claims"
      ],
      "resource_governor": [
        "cpu_memory_io_queue_and_worker_limits"
      ],
      "audit_broker": [
        "selective_audit_ingestion_and_disclosure"
      ],
      "control_plane": [
        "validated_desired_state_and_coordinated_request"
      ]
    },
    "control_plane_request_is_sufficient_authority": false,
    "root_or_host_administrator_is_application_governance_interface": false,
    "missing_or_invalid_authority_result": "affected_operation_blocked"
  },
  "operation_model": {
    "operation_classes": [
      {
        "operation_id": "inspect_node_state",
        "purpose": "Return bounded node identity, active profile, booted release, active Release Set, health, readiness, and recovery state.",
        "authorization_class": "node_inspection",
        "mutates_host": false,
        "idempotency": "repeatable_read",
        "receipt": "optional_unless_profile_or_security_policy_requires"
      },
      {
        "operation_id": "stage_system_artifact",
        "purpose": "Stage a validated system image or equivalent system-channel artifact without activating it.",
        "authorization_class": "system_artifact_staging",
        "mutates_host": true,
        "idempotency": "request_id_and_artifact_identity",
        "receipt": "required"
      },
      {
        "operation_id": "activate_system_artifact",
        "purpose": "Activate a staged verified system artifact through an atomic boot slot, pointer, or equivalent profile-defined transition.",
        "authorization_class": "system_artifact_activation",
        "mutates_host": true,
        "idempotency": "request_id_expected_state_and_artifact_identity",
        "receipt": "required"
      },
      {
        "operation_id": "activate_service_bundle",
        "purpose": "Activate a compatible services-channel bundle using a complete profile-authorized transition.",
        "authorization_class": "service_bundle_activation",
        "mutates_host": true,
        "idempotency": "request_id_expected_state_and_bundle_identity",
        "receipt": "required"
      },
      {
        "operation_id": "activate_governance_bundle",
        "purpose": "Activate an accepted and compatible governance policy bundle without creating or changing policy authority.",
        "authorization_class": "governance_bundle_activation",
        "mutates_host": true,
        "idempotency": "request_id_expected_state_and_bundle_identity",
        "receipt": "required"
      },
      {
        "operation_id": "manage_knowledge_artifact",
        "purpose": "Install, activate, pin, unpin, quarantine, or revert a registered knowledge artifact when permitted by its class and profile.",
        "authorization_class": "knowledge_artifact_lifecycle",
        "mutates_host": true,
        "idempotency": "request_id_expected_state_artifact_identity_and_action",
        "receipt": "required_for_activation_quarantine_or_revert"
      },
      {
        "operation_id": "import_offline_bundle",
        "purpose": "Admit a verified offline bundle into quarantine or staging for controlled local validation and activation.",
        "authorization_class": "offline_bundle_import",
        "mutates_host": true,
        "idempotency": "request_id_bundle_identity_and_target_state",
        "receipt": "required"
      },
      {
        "operation_id": "manage_declared_encrypted_volume",
        "purpose": "Create, unlock, mount, unmount, rotate, or retire a profile-declared encrypted volume through a closed operation schema.",
        "authorization_class": "encrypted_volume_lifecycle",
        "mutates_host": true,
        "idempotency": "request_id_volume_identity_expected_state_and_action",
        "receipt": "required"
      },
      {
        "operation_id": "restart_allowlisted_service_group",
        "purpose": "Restart one profile-declared service group after validation of current state, dependency conditions, and authorization.",
        "authorization_class": "service_group_control",
        "mutates_host": true,
        "idempotency": "request_id_service_group_expected_state",
        "receipt": "required_when_critical"
      },
      {
        "operation_id": "rotate_node_scoped_key",
        "purpose": "Perform a governed rotation of one node-scoped key without exporting raw private-key material.",
        "authorization_class": "node_key_rotation",
        "mutates_host": true,
        "idempotency": "request_id_key_identity_expected_version",
        "receipt": "required"
      },
      {
        "operation_id": "export_node_evidence",
        "purpose": "Export an authorized bounded node-evidence package through the applicable audit and disclosure path.",
        "authorization_class": "node_evidence_export",
        "mutates_host": false,
        "idempotency": "request_id_evidence_scope_and_policy_decision",
        "receipt": "required"
      },
      {
        "operation_id": "enter_recovery_target",
        "purpose": "Transition the node into a profile-defined recovery environment or mode.",
        "authorization_class": "node_recovery",
        "mutates_host": true,
        "idempotency": "request_id_expected_state_and_recovery_target",
        "receipt": "required"
      },
      {
        "operation_id": "execute_rollback_or_forward_repair",
        "purpose": "Apply the declared recovery strategy for a failed activation or migration.",
        "authorization_class": "node_recovery",
        "mutates_host": true,
        "idempotency": "request_id_failed_transition_and_recovery_plan",
        "receipt": "required"
      }
    ],
    "closed_allowlist": true,
    "unregistered_operation_result": "rejected",
    "each_operation_requires": [
      "closed_request_schema",
      "authorization_class",
      "profile_permission",
      "preconditions",
      "expected_current_state",
      "idempotency_behavior",
      "timeout",
      "bounded_parameters",
      "result_schema",
      "stable_error_codes",
      "receipt_policy",
      "recovery_behavior_when_mutating"
    ],
    "request_fields": [
      "operation",
      "request_id",
      "caller_identity",
      "profile_context_ref",
      "policy_decision_ref_when_required",
      "artifact_or_target_refs",
      "expected_current_state",
      "parameters",
      "deadline_or_timeout",
      "correlation_id"
    ],
    "request_body_canonicalization_required": true,
    "request_identity_reuse_with_different_body_result": "rejected",
    "recorded_equivalent_result_returned_for_repeat": true
  },
  "interfaces": {
    "commands": [
      {
        "interface_id": "execute_node_operation",
        "version": "1.0.0",
        "caller": "authorized_local_component_or_control_plane",
        "request": [
          "operation",
          "request_id",
          "caller_identity",
          "profile_context_ref",
          "policy_decision_ref_when_required",
          "artifact_or_target_refs",
          "expected_current_state",
          "parameters",
          "deadline_or_timeout",
          "correlation_id"
        ],
        "responses": [
          "accepted",
          "completed",
          "rejected",
          "conflict",
          "timed_out",
          "failed",
          "recovery_required"
        ],
        "idempotency_key_required": true
      },
      {
        "interface_id": "cancel_node_operation",
        "version": "1.0.0",
        "caller": "authorized_request_owner_or_operator",
        "request": [
          "request_id",
          "reason"
        ],
        "responses": [
          "cancelled",
          "not_cancellable",
          "already_completed",
          "not_found",
          "failed"
        ],
        "idempotency_key_required": true
      },
      {
        "interface_id": "acknowledge_recovery_result",
        "version": "1.0.0",
        "caller": "authorized_recovery_or_lifecycle_component",
        "request": [
          "failed_request_id",
          "recovery_receipt_ref",
          "verified_current_state"
        ],
        "responses": [
          "acknowledged",
          "rejected",
          "conflict",
          "failed"
        ],
        "idempotency_key_required": true
      }
    ],
    "queries": [
      {
        "interface_id": "get_node_agent_capabilities",
        "version": "1.0.0",
        "authorization_required": true,
        "default_result": "profile_enabled_operation_classes_and_versions"
      },
      {
        "interface_id": "get_node_operation_status",
        "version": "1.0.0",
        "authorization_required": true,
        "default_result": "bounded_request_state_and_receipt_reference"
      },
      {
        "interface_id": "get_node_agent_health",
        "version": "1.0.0",
        "authorization_required": true,
        "default_result": "bounded_health_readiness_staging_and_recovery_state"
      }
    ],
    "events": [
      "node_operation_accepted",
      "node_operation_rejected",
      "node_operation_started",
      "node_operation_completed",
      "node_operation_failed",
      "node_recovery_started",
      "node_recovery_completed",
      "node_integrity_failure_detected",
      "node_agent_resource_pressure_detected"
    ],
    "transport": "profile_defined_authenticated_local_or_node_management_interface",
    "local_unix_socket_permitted": true,
    "direct_database_access": false,
    "unregistered_interface_result": "rejected"
  },
  "activation_and_recovery": {
    "activation_preconditions": [
      "caller_identity_valid",
      "authorization_valid_and_unexpired",
      "profile_permission_valid",
      "artifact_class_and_manifest_valid",
      "artifact_integrity_verified",
      "artifact_signature_verified_when_required",
      "release_compatibility_valid",
      "expected_current_state_matches",
      "resource_and_storage_capacity_available",
      "recovery_point_verified"
    ],
    "activation_mechanisms": [
      "atomic_pointer",
      "boot_slot",
      "transaction",
      "immutable_slot_switch",
      "artifact_class_equivalent"
    ],
    "partial_authoritative_activation_allowed": false,
    "crash_result": "previous_valid_state_or_complete_new_state",
    "previous_valid_state_preserved_on_failure": true,
    "recovery_strategies": [
      "rollback",
      "revert",
      "restore",
      "forward_repair",
      "reconstruction_from_verified_artifacts"
    ],
    "recovery_token_required_when_applicable": true,
    "post_transition_verification_required": true,
    "activation_and_recovery_receipts_required": true
  },
  "security": {
    "component_scoped_service_identity": true,
    "privileged_execution_identity_is_profile_defined": true,
    "minimum_privilege_required": true,
    "caller_authentication_required": true,
    "authorization_binding_required": true,
    "authorization_expiry_required": true,
    "profile_context_validation_required": true,
    "replay_protection_required": true,
    "request_idempotency_required": true,
    "parameter_allowlists_required": true,
    "path_allowlists_required_when_paths_are_permitted": true,
    "service_group_allowlists_required": true,
    "device_allowlists_required_when_devices_are_permitted": true,
    "raw_private_key_export": false,
    "secrets_in_receipts_logs_or_health": false,
    "implementation_hardening_may_include": [
      "systemd_sandboxing",
      "dedicated_selinux_domain",
      "minimal_linux_capabilities",
      "no_new_privileges",
      "protected_system_paths",
      "private_temporary_storage",
      "restricted_address_families",
      "bounded_resources",
      "local_unix_socket"
    ],
    "implementation_hardening_is_profile_or_recipe_scoped": true,
    "break_glass": {
      "ordinary_operation_name_reuse": false,
      "separate_operation_classes_required": true,
      "stronger_policy_required": true,
      "caller_uid_alone_is_sufficient": false,
      "time_bound": true,
      "actor_bound": true,
      "scope_bound": true,
      "post_event_review_required": true,
      "receipt_required": true
    }
  },
  "data_boundaries": {
    "authoritative_entities": [
      {
        "entity_id": "node_operation_request_record",
        "purpose": "Canonicalized node-agent record used for idempotency, replay protection, and execution state."
      },
      {
        "entity_id": "node_staging_record",
        "purpose": "Node-local record of one validated staged artifact or offline bundle."
      },
      {
        "entity_id": "node_operation_receipt",
        "purpose": "Machine-readable record of one privileged host mutation or critical lifecycle transition."
      },
      {
        "entity_id": "node_recovery_record",
        "purpose": "Node-local record of rollback, restore, forward-repair, or recovery-target execution."
      }
    ],
    "application_component_data_storage": false,
    "control_plane_desired_state_is_authoritative_source": false,
    "artifact_cache_or_staging_transfers_artifact_ownership": false,
    "physical_storage_sharing_transfers_ownership": false,
    "direct_cross_component_source_writes": "prohibited",
    "operation_history_retention_is_profile_and_receipt_class_conditioned": true
  },
  "receipt_model": {
    "required_for": [
      "privileged_host_mutation",
      "artifact_activation",
      "release_activation",
      "recovery_transition",
      "node_key_rotation",
      "encrypted_volume_lifecycle",
      "offline_bundle_import",
      "authorized_node_evidence_export"
    ],
    "required_fields": [
      "receipt_id",
      "request_id",
      "operation",
      "authenticated_caller",
      "profile_context_ref",
      "policy_decision_ref_when_required",
      "before_state",
      "after_state",
      "artifact_or_target_identities",
      "result",
      "reason_codes",
      "started_at",
      "completed_at",
      "duration",
      "recovery_or_rollback_token_when_applicable",
      "correlation_id"
    ],
    "integrity_and_signing_are_artifact_class_conditioned": true,
    "audit_broker_submission": "required_when_profile_or_security_contract_requires",
    "receipt_failure_result": "critical_transition_claim_blocked"
  },
  "resource_governance": {
    "resource_governor_ref": "generated/component-catalog.json#/components/resource_governor",
    "governance_policy_runtime_ref": "generated/component-catalog.json#/components/governance_policy_runtime",
    "authorities_are_separate": true,
    "bounded_resources": [
      "concurrent_node_operations",
      "staging_storage",
      "temporary_storage",
      "artifact_verification_workers",
      "activation_workers",
      "recovery_workers",
      "io_bandwidth",
      "network_bandwidth",
      "receipt_queue",
      "diagnostic_log_volume"
    ],
    "pressure_order": [
      "reject_unregistered_or_oversized_requests",
      "defer_noncritical_staging",
      "serialize_mutating_operations",
      "pause_new_activations",
      "preserve_active_transition_integrity",
      "preserve_recovery_capability",
      "preserve_receipts_and_idempotency_state",
      "enter_read_only_inspection_mode_before_integrity_risk"
    ],
    "parallel_mutating_operations_default": 1,
    "unbounded_remote_fanout": false
  },
  "external_integrations": {
    "native_or_automatic_use": false,
    "allowed": [],
    "prohibited": [
      "chatgpt",
      "suno",
      "gamma",
      "ariane-voice"
    ],
    "reason": "External AI, media, presentation, or voice services cannot select, authorize, parameterize, execute, validate, repair, or acknowledge privileged node operations.",
    "external_output_may_become_operation_authority": false,
    "silent_substitution": false
  },
  "offline_behavior": {
    "local_inspection_available": true,
    "local_recovery_available_when_profile_claims_it": true,
    "verified_offline_bundle_import_available_when_profile_claims_it": true,
