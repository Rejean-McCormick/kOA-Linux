{
  "$schema": "../../schemas/component-contract.schema.json",
  "component_id": "koa_node_agent",
  "component_type": "component_contract",
  "component_class": "node_local_lifecycle_and_privileged_operation_broker",
  "version": "1.0.0",
  "status": "active",
  "language": "en",
  "effective_at": "2026-08-03T16:51:00-04:00",
  "display_name": "kOA Node Agent",
  "description": "A node-local lifecycle and narrow privileged-operation component that validates closed high-level requests, preserves node-local authority, coordinates staging, activation, rollback, recovery, encrypted-storage operations, key rotation, bounded service-group control, and evidence export, and produces machine-readable receipts without exposing arbitrary shell, file, package, container, service-manager, device, or private-key interfaces.",
  "scope": {
    "kind": "component",
    "owns": [
      "node_agent_request_identity",
      "node_agent_operation_state",
      "node_agent_idempotency_records",
      "node_local_staging_state",
      "node_local_activation_execution_state",
      "node_local_recovery_execution_state",
      "node_local_operation_receipts",
      "node_agent_health_and_readiness_state"
    ],
    "does_not_own": [
      "application_component_authoritative_data",
      "governance_policy_authority",
      "identity_or_trust_root_authority",
      "release_content_or_compatibility_authority",
      "artifact_class_or_manifest_authority",
      "profile_membership",
      "resource_allocation_policy",
      "audit_disclosure_policy",
      "publication_authority",
      "control_plane_desired_state_as_unilateral_authority"
    ]
  },
  "canonical_refs": [
    "contracts/system.contract.json#/global_boundaries/privilege",
