{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/dead-letter-record.schema.json",
  "title": "kOA Dead Letter Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_class",
    "record_id",
    "source_queue_id",
    "message_id",
    "authority_domain",
    "payload_digest",
    "first_failed_at",
    "quarantined_at",
    "attempt_count",
    "failure",
    "status",
    "redrive",
    "retention",
    "closure"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "artifact_class": {
      "const": "dead_letter_record"
    },
    "example": {
      "type": "boolean"
    },
    "authority": {
      "type": "string"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "source_queue_id": {
      "type": "string",
      "minLength": 1
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_domain": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "payload_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_failed_at": {
      "type": "string",
      "format": "date-time"
    },
    "quarantined_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 1
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "permanent",
        "reason_code",
        "last_error_summary"
      ],
      "properties": {
        "class": {
          "enum": [
            "transient_exhausted",
            "permanent_validation",
            "permanent_policy",
            "compatibility",
            "authorization",
            "corruption",
            "unknown"
          ]
        },
        "permanent": {
          "type": "boolean"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "last_error_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "quarantined",
        "under_review",
        "approved_for_redrive",
        "redriven",
        "discard_approved",
        "discarded",
        "archived"
      ]
    },
    "redrive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic",
        "requires_compatibility_check",
        "requires_authorization",
        "redrive_count"
      ],
      "properties": {
        "automatic": {
          "const": false
        },
        "requires_compatibility_check": {
          "const": true
        },
        "requires_authorization": {
          "const": true
        },
        "redrive_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_redrive_receipt_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retain_until_closed",
        "maximum_days"
      ],
      "properties": {
        "retain_until_closed": {
          "const": true
        },
        "maximum_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closed",
        "outcome"
      ],
      "properties": {
        "closed": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "pending",
            "success_after_redrive",
            "authorized_discard",
            "superseded_by_repair"
          ]
        },
        "receipt_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
