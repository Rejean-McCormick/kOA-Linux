{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/shared-mediatheque-frame.schema.json",
  "title": "Shared Mediatheque Frame",
  "description": "Portable interchange frame shared by the kOA Mediatheque and the online UCKK Mediatheque. Conformance to this frame preserves mapping semantics but does not merge identities, storage, access control, lifecycle, or authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frame_id",
    "frame_version",
    "object_identity",
    "version_identity",
    "integrity",
    "media",
    "rights",
    "provenance",
    "lifecycle"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "frame_id": {
      "const": "koa-uckk-shared-mediatheque-frame"
    },
    "frame_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "object_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain_id",
        "object_id"
      ],
      "properties": {
        "authority_domain_id": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "origin_system": {
          "enum": [
            "koa-linux",
            "uckk",
            "other_declared_source"
          ]
        },
        "external_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "version_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "supersedes_version_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_version_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256",
            "sha384",
            "sha512"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64,128}$"
        },
        "manifest_digest": {
          "type": "string"
        },
        "signature_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type"
      ],
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "language_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": true
        },
        "renditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "collections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license_status",
        "disclosure_status"
      ],
      "properties": {
        "license_status": {
          "enum": [
            "declared",
            "restricted",
            "unknown",
            "not_applicable"
          ]
        },
        "license_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "disclosure_status": {
          "enum": [
            "private",
            "organization_private",
            "restricted",
            "shareable",
            "public"
          ]
        },
        "consent_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "restriction_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "cultural_rights_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "expiry": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_system",
        "acquisition_method"
      ],
      "properties": {
        "source_system": {
          "type": "string",
          "minLength": 1
        },
        "source_object_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_version_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "acquisition_method": {
          "enum": [
            "created_local",
            "imported_online",
            "imported_offline_bundle",
            "published_copy",
            "derived_local",
            "other_declared"
          ]
        },
        "acquired_at": {
          "type": "string",
          "format": "date-time"
        },
        "derivation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "receipt_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "authority_domain_id"
      ],
      "properties": {
        "state": {
          "enum": [
            "candidate",
            "quarantined",
            "accepted",
            "active",
            "superseded",
            "withdrawn",
            "rejected",
            "deleted_tombstone"
          ]
        },
        "authority_domain_id": {
          "type": "string",
          "minLength": 1
        },
        "transitioned_at": {
          "type": "string",
          "format": "date-time"
        },
        "retention_policy_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_frame_version": {
          "type": "string"
        },
        "target_frame_version": {
          "type": "string"
        },
        "mapping_version": {
          "type": "string"
        },
        "lossless": {
          "type": "boolean"
        },
        "review_required": {
          "type": "boolean"
        },
        "unmapped_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
