{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/large-payload-reference.schema.json",
  "title": "kOA Large Payload Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_class",
    "reference_id",
    "owner_component_id",
    "object_id",
    "object_version",
    "locator",
    "digest",
    "media_type",
    "byte_length",
    "authorization",
    "retention",
    "cleanup"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "artifact_class": {
      "const": "large_payload_reference"
    },
    "example": {
      "type": "boolean"
    },
    "authority": {
      "type": "string"
    },
    "reference_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_component_id": {
      "type": "string",
      "minLength": 1
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "string",
      "pattern": "^koa-object://[A-Za-z0-9._~/-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "byte_length": {
      "type": "integer",
      "minimum": 1
    },
    "routing_metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience",
        "capability",
        "bearer_secret_embedded"
      ],
      "properties": {
        "audience": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "bearer_secret_embedded": {
          "const": false
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retain_until_workflow_terminal",
        "minimum_until"
      ],
      "properties": {
        "retain_until_workflow_terminal": {
          "const": true
        },
        "minimum_until": {
          "type": "string",
          "format": "date-time"
        },
        "maximum_until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orphan_detection",
        "cleanup_owner",
        "deletion_requires_terminal_state"
      ],
      "properties": {
        "orphan_detection": {
          "const": true
        },
        "cleanup_owner": {
          "type": "string",
          "minLength": 1
        },
        "deletion_requires_terminal_state": {
          "const": true
        }
      }
    }
  }
}
