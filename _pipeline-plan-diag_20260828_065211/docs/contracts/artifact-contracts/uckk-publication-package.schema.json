{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/uckk-publication-package.schema.json",
  "title": "UCKK Publication Package",
  "description": "A governed, versioned, retry-safe package for publishing explicitly selected kOA Mediatheque record versions to an external UCKK Moodle destination. The declared shared Mediatheque frame governs compatible field mapping without merging source and destination authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "package_version",
    "created_at",
    "source",
    "target",
    "authorization",
    "items",
    "manifest",
    "idempotency_key",
    "frame_compatibility"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "package_id": {
      "type": "string",
      "pattern": "^uckk_pub_pkg_[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "package_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "component_id",
        "authority_domain_id",
        "source_authority_preserved"
      ],
      "properties": {
        "system_id": {
          "const": "koa-linux"
        },
        "component_id": {
          "const": "koa_mediatheque"
        },
        "authority_domain_id": {
          "type": "string",
          "minLength": 1
        },
        "source_authority_preserved": {
          "const": true
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "platform_type",
        "endpoint_id",
        "mapping_version",
        "destination"
      ],
      "properties": {
        "system_id": {
          "const": "uckk"
        },
        "platform_type": {
          "const": "moodle"
        },
        "endpoint_id": {
          "type": "string",
          "minLength": 1
        },
        "mapping_version": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "site_ref": {
              "type": "string"
            },
            "course_ref": {
              "type": "string"
            },
            "section_ref": {
              "type": "string"
            },
            "activity_ref": {
              "type": "string"
            },
            "repository_ref": {
              "type": "string"
            },
            "collection_ref": {
              "type": "string"
            }
          },
          "minProperties": 1
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_request_ref",
        "decision_ref",
        "decision_outcome",
        "authorized_at"
      ],
      "properties": {
        "publication_request_ref": {
          "type": "string"
        },
        "decision_ref": {
          "type": "string"
        },
        "decision_outcome": {
          "const": "allow"
        },
        "authorized_at": {
          "type": "string",
          "format": "date-time"
        },
        "authorized_by_ref": {
          "type": "string"
        },
        "obligation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "record_id",
          "version_id",
          "title",
          "media_type",
          "content",
          "integrity",
          "rights_assertion",
          "destination_mapping"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "record_id": {
            "type": "string"
          },
          "version_id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "transfer_ref",
              "size_bytes"
            ],
            "properties": {
              "transfer_ref": {
                "type": "string"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "original_filename": {
                "type": "string"
              },
              "rendition_id": {
                "type": "string"
              }
            }
          },
          "integrity": {
            "$ref": "#/$defs/integrity"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "rights_assertion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "publication_allowed",
              "target_allowed",
              "checked_at"
            ],
            "properties": {
              "publication_allowed": {
                "const": true
              },
              "target_allowed": {
                "const": true
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              },
              "rights_policy_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "consent_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "restriction_summary": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "destination_mapping": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "object_kind"
            ],
            "properties": {
              "object_kind": {
                "type": "string",
                "minLength": 1
              },
              "existing_remote_ref": {
                "type": "string"
              },
              "update_policy": {
                "enum": [
                  "create",
                  "create_or_update",
                  "new_version",
                  "replace_if_authorized"
                ]
              }
            }
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest",
        "item_count",
        "total_size_bytes"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256",
            "sha384",
            "sha512"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64,128}$"
        },
        "item_count": {
          "type": "integer",
          "minimum": 1
        },
        "total_size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "queue_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offline_queue_allowed": {
          "type": "boolean"
        },
        "maximum_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "retry_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "cancel_on_authorization_change": {
          "const": true
        },
        "cancel_on_source_version_change": {
          "const": true
        }
      }
    },
    "frame_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "source_frame_version",
        "target_frame_version",
        "mapping_version",
        "rights_preserved",
        "provenance_preserved"
      ],
      "properties": {
        "frame_id": {
          "const": "koa-uckk-shared-mediatheque-frame"
        },
        "source_frame_version": {
          "type": "string"
        },
        "target_frame_version": {
          "type": "string"
        },
        "mapping_version": {
          "type": "string"
        },
        "rights_preserved": {
          "const": true
        },
        "provenance_preserved": {
          "const": true
        },
        "review_required": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256",
            "sha384",
            "sha512"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64,128}$"
        }
      }
    }
  }
}
