{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/cqrs-projection.schema.json",
  "title": "kOA CQRS Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_class",
    "projection_id",
    "version",
    "owner_component_id",
    "authoritative_source_ref",
    "source_feed",
    "storage",
    "consistency",
    "rebuild",
    "authority_boundary",
    "observability"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "artifact_class": {
      "const": "cqrs_projection"
    },
    "example": {
      "type": "boolean"
    },
    "authority": {
      "type": "string"
    },
    "projection_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "owner_component_id": {
      "type": "string",
      "minLength": 1
    },
    "authoritative_source_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_feed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feed_ref",
        "checkpoint_model",
        "idempotent_consumer"
      ],
      "properties": {
        "feed_ref": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_model": {
          "enum": [
            "monotonic_offset",
            "event_id_set",
            "version_vector",
            "owner_sequence"
          ]
        },
        "idempotent_consumer": {
          "const": true
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_id",
        "rebuildable",
        "commands_allowed"
      ],
      "properties": {
        "store_id": {
          "type": "string",
          "minLength": 1
        },
        "rebuildable": {
          "const": true
        },
        "commands_allowed": {
          "const": false
        }
      }
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "maximum_staleness_seconds",
        "fresh_authorization_allowed"
      ],
      "properties": {
        "model": {
          "enum": [
            "eventual",
            "synchronous_projection"
          ]
        },
        "maximum_staleness_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "fresh_authorization_allowed": {
          "const": false
        },
        "read_your_write_strategy": {
          "enum": [
            "query_owner",
            "wait_for_checkpoint",
            "session_overlay",
            "not_required"
          ]
        }
      }
    },
    "rebuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "source_complete",
        "deletion_propagation"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "full_replay",
            "snapshot_then_replay",
            "owner_export_then_tail"
          ]
        },
        "source_complete": {
          "const": true
        },
        "deletion_propagation": {
          "const": true
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritative",
        "may_accept_commands",
        "may_change_source_ownership"
      ],
      "properties": {
        "authoritative": {
          "const": false
        },
        "may_accept_commands": {
          "const": false
        },
        "may_change_source_ownership": {
          "const": false
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lag_metric",
        "last_checkpoint_metric",
        "rebuild_status_metric"
      ],
      "properties": {
        "lag_metric": {
          "type": "string",
          "minLength": 1
        },
        "last_checkpoint_metric": {
          "type": "string",
          "minLength": 1
        },
        "rebuild_status_metric": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
