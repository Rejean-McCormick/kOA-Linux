{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/uckk-learning-package.schema.json",
  "title": "UCKK Learning Package",
  "description": "Signed or otherwise verifiable package carrying a selected UCKK course, learning path, instruction collection, manual, or resource graph for controlled acceptance into the local kOA Mediatheque and offline consultation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "package_version",
    "created_at",
    "source",
    "selection",
    "frame_compatibility",
    "learning_structure",
    "resources",
    "manifest",
    "rights",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "package_id": {
      "type": "string",
      "pattern": "^uckk_learning_package_[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "platform_type",
        "endpoint_id",
        "site_ref"
      ],
      "properties": {
        "system_id": {
          "const": "uckk"
        },
        "platform_type": {
          "const": "moodle"
        },
        "endpoint_id": {
          "type": "string",
          "minLength": 1
        },
        "site_ref": {
          "type": "string",
          "minLength": 1
        },
        "publisher_identity_ref": {
          "type": "string"
        },
        "signature_ref": {
          "type": "string"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_type",
        "source_object_refs"
      ],
      "properties": {
        "selection_type": {
          "enum": [
            "course",
            "learning_path",
            "instruction_collection",
            "manual",
            "resource_collection"
          ]
        },
        "source_object_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source_version_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "requested_by_ref": {
          "type": "string"
        }
      }
    },
    "frame_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "source_frame_version",
        "target_frame_version",
        "mapping_version",
        "rights_preserved",
        "provenance_preserved"
      ],
      "properties": {
        "frame_id": {
          "const": "koa-uckk-shared-mediatheque-frame"
        },
        "source_frame_version": {
          "type": "string"
        },
        "target_frame_version": {
          "type": "string"
        },
        "mapping_version": {
          "type": "string"
        },
        "rights_preserved": {
          "const": true
        },
        "provenance_preserved": {
          "const": true
        },
        "lossy_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "review_required": {
          "type": "boolean"
        }
      }
    },
    "learning_structure": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "structure_type",
        "root_ref"
      ],
      "properties": {
        "structure_type": {
          "enum": [
            "moodle_course",
            "learning_path",
            "manual",
            "instruction_graph",
            "resource_collection"
          ]
        },
        "root_ref": {
          "type": "string"
        },
        "offline_runtime_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "activity_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "frame",
          "content_ref",
          "size_bytes"
        ],
        "properties": {
          "resource_id": {
            "type": "string"
          },
          "frame": {
            "$ref": "./shared-mediatheque-frame.schema.json"
          },
          "content_ref": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "required_for_offline": {
            "type": "boolean"
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest",
        "entry_count",
        "complete"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256",
            "sha384",
            "sha512"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64,128}$"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "complete": {
          "const": true
        },
        "signature_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license_status",
        "offline_use_allowed",
        "local_copy_allowed"
      ],
      "properties": {
        "license_status": {
          "enum": [
            "declared",
            "restricted",
            "unknown"
          ]
        },
        "license_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "offline_use_allowed": {
          "type": "boolean"
        },
        "local_copy_allowed": {
          "type": "boolean"
        },
        "adaptation_allowed": {
          "type": "boolean"
        },
        "redistribution_allowed": {
          "type": "boolean"
        },
        "restriction_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "expiry": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_authority_domain_id",
        "export_receipt_refs"
      ],
      "properties": {
        "source_authority_domain_id": {
          "type": "string",
          "minLength": 1
        },
        "export_receipt_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derivation_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publisher_statement_ref": {
          "type": "string"
        }
      }
    }
  }
}
