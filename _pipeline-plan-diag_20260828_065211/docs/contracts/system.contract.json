  "connectivity_states": [
    {
      "state_id": "online",
      "description": "Approved remote integrations may be available subject to explicit classification and user or policy authorization."
    },
    {
      "state_id": "restricted_network",
      "description": "Only profile-approved endpoints and protocols are reachable; core local capabilities remain available."
    },
    {
      "state_id": "intermittent",
      "description": "Remote connectivity may disappear and return; queued work remains bounded and idempotent."
    },
    {
      "state_id": "offline",
      "description": "No Internet or remote service is required for the profile's declared offline capability envelope."
    },
    {
      "state_id": "offline_with_imported_sources",
      "description": "Build or update work uses locally imported and verified source or artifact bundles."
    }
  ],
  "global_capabilities": [
    {
      "capability_id": "local_authoritative_operation",
      "availability": "global_contract",
      "description": "Authoritative local operations remain possible within the active profile's offline and security envelope."
    },
    {
      "capability_id": "deterministic_navigation",
      "availability": "profile_activated",
      "description": "Ariane local navigation works without external AI or voice services."
    },
    {
      "capability_id": "governed_knowledge_runtime",
      "availability": "profile_activated",
      "description": "Compiled knowledge and language artifacts are consumed locally without requiring build workbenches."
    },
    {
      "capability_id": "deterministic_media_management",
      "availability": "profile_activated",
      "description": "kOA Mediatheque ingests, verifies, transforms, stores, exports, backs up, and restores local media through deterministic operations."
    },
    {
      "capability_id": "deterministic_resource_governance",
      "availability": "global_baseline_component",
      "description": "Resource Governor bounds CPU, memory, I/O, concurrency, queues, jobs, and processes."
    },
    {
      "capability_id": "profile_conditioned_policy_governance",
      "availability": "profile_conditioned",
      "description": "Governance Policy Runtime supplies authorization, disclosure, consent, privilege decisions, and governed exceptions where required by a profile."
    },
    {
      "capability_id": "controlled_external_integration",
      "availability": "optional",
      "description": "External services are explicitly classified, removable, capability-scoped, and unable to directly mutate authoritative state."
    },
    {
      "capability_id": "selective_audit_and_recourse",
      "availability": "global_contract",
      "description": "Accountability evidence is produced without requiring indiscriminate disclosure."
    },
    {
      "capability_id": "portability_restore_and_exit",
      "availability": "global_contract",
      "description": "Open interfaces, export, backup, restore, and credible independent exit remain system objectives."
    },
    {
      "capability_id": "governed_uckk_mediatheque_interchange",
      "availability": "optional",
      "description": "Selected local content can be published to the online UCKK Mediatheque, and selected UCKK learning packages can be imported for private offline use, through separate governed directional integrations."
    },
    {
      "capability_id": "contextual_experience_composition",
      "availability": "optional_profile_activated",
      "description": "kOA Spaces can compose a module selector, active-module sidebar, top-bar contributions, and one main page surface from validated Space definitions and module interface manifests without acquiring business authority."
    }
  ],
