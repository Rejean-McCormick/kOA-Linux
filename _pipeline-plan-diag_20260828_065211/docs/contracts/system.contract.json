  "system": {
    "system_id": "koa_linux_operating_system",
    "name": "kOA-Linux Operating System",
    "product_family": "kOA",
    "system_class": "sovereign_local_operating_system",
    "purpose": "Provide the sovereign local operating system for governed knowledge, coordination, language, media, navigation, publication, and offline-capable kOA ecosystem workloads.",
    "architectural_style": [
      "explicit_authority",
      "component_separation",
      "local_first_operation",
      "offline_continuity",
      "deterministic_core_behavior",
      "profile_scoped_deployment",
      "contract_driven_integration",
      "safe_degradation",
      "selective_audit",
      "portable_artifacts"
    ],
    "global_non_goals": [
      "making every deployment an appliance",
      "requiring Kubernetes on endpoints",
      "requiring one desktop environment on every Linux host",
      "requiring one container runtime on every profile",
      "embedding native generative AI in the baseline",
      "sharing authoritative source tables across components",
      "turning Kristal into a universal workflow engine or operational database",
      "making recipes authoritative through implementation prevalence",
      "embedding UCKK as a native kOA-Linux subsystem",
      "merging kOA Mediatheque authority with UCKK Mediatheque authority",
      "requiring UCKK for local media management or offline operation",
      "making kOA Spaces part of the privileged core",
      "treating menu visibility, route presence, or a top-bar widget as authorization",
      "requiring one user interface or one Space definition for every deployment",
      "allowing a Space definition to own or mutate business authority",
      "treating integrated ecosystem systems as native kOA-Linux components"
    ],
    "ecosystem_scope": "koa_digital_ecosystem"
  },
